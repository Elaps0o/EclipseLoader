                if root.Visible then
                    yaw = (yaw + dt * 0.45) % (math.pi * 2)
                end
                local main
                pcall(function()
                    main = (Library and Library.Main)
                        or (Library and Library.ScreenGui and Library.ScreenGui:FindFirstChild("Main", true))
