function _espIconAssetForWeapon(weaponName)
    if type(weaponName) ~= "string" or weaponName == "" then return nil end
    local clean = (_cleanHUDWeaponText and _cleanHUDWeaponText(weaponName)) or weaponName
    clean = tostring(clean):gsub("^%s+", ""):gsub("%s+$", "")
    _ESPWeaponIconCache = _ESPWeaponIconCache or {}
    if _ESPWeaponIconCache[clean] ~= nil then return _ESPWeaponIconCache[clean] or nil end
    local icon = nil
    local ok, res = pcall(_espResolvedWeaponIcon, clean)
    if ok and type(res) == "string" and res ~= "" then icon = res end
    if not icon then return nil end

    local id = _assetIdFromString(icon)
    local direct = id and ("rbxassetid://" .. id) or (_assetString(icon) or icon)
    _ESPWeaponIconCache[clean] = direct
    return direct
end

function _espDrawTag(data, L, R, T, cx, plr, dist, weaponName, B)

    local function hideLegacyBox()
        if data.TagBg then data.TagBg.Visible = false end
        if data.TagBorder then for _, l in ipairs(data.TagBorder) do l.Visible = false end end
        if data.TagGrad   then for _, l in ipairs(data.TagGrad)   do l.Visible = false end end
        if data.TagText   then data.TagText.Visible = false end
    end

    local s = _espAnimScale()
    if s <= 0.001 then
        hideLegacyBox()
        if data.GuiTag   then data.GuiTag.Visible = false end
        if data.GuiTagSync then data.GuiTagSync.Visible = false end
        if data.GuiTagBot then data.GuiTagBot.Visible = false end
        if data.DrawName then pcall(function() data.DrawName.Visible = false end) end
        if data.GuiMoney then data.GuiMoney.Visible = false end
        _espHideAmmo(data)
        if data.WeaponIcon then data.WeaponIcon.Visible = false end
        return 0
    end

    local hasWeapon = weaponName and weaponName ~= ""
    local weaponIconAsset = hasWeapon and _espIconAssetForWeapon(weaponName) or nil
    if not weaponIconAsset and data.LastWeaponIcon then
        weaponIconAsset = data.LastWeaponIcon
    end
    local showIcon = (Config.ESP.WeaponName == true) and (weaponIconAsset ~= nil)

    local showName = Config.ESP.Name == true
    local showDist = Config.ESP.Distance == true

    local moneyStr = nil
    if Config.ESP.IdentifyMoney and _isWarmup and _isWarmup() then
        local m = tonumber(plr:GetAttribute("Money")) or tonumber(plr:GetAttribute("Cash"))
        if not m then
            local ls = plr:FindFirstChild("leaderstats")
            if ls then
                local v = ls:FindFirstChild("Money") or ls:FindFirstChild("Cash") or ls:FindFirstChild("$")
                if v then m = tonumber(v.Value) end
            end
        end
        if not m and plr.Character then
            m = tonumber(plr.Character:GetAttribute("Money")) or tonumber(plr.Character:GetAttribute("Cash"))
        end
        if m then
            moneyStr = "$" .. tostring(math.floor(m)):reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", "")
        end
    end
    _espHideAmmo(data)
    hideLegacyBox()

    local NAME_H = 14
    local BOX_W  = math.max(8, math.floor((R or cx) - (L or cx)))
    local ICON_H = math.clamp(math.floor(BOX_W * 0.32), 10, 16)
    local GAP    = 2

    local anyTop = showName or showDist
    local anyBot = showIcon
    local baseW  = math.max(120, math.min(200, (R - L) + 40))
    local totalH = 0

    local f = _espEnsureTagGui(data)

    if f and anyTop then
        f.Size     = UDim2.fromOffset(baseW, NAME_H)
        f.Position = UDim2.fromOffset(math.floor(cx), math.floor((T or 0) - 4))
        f.Visible  = true
        if data.GuiTagName then
            local nameStr = showName and plr.Name or ""
            local distStr = showDist and ("[" .. math.floor(dist) .. "m]") or ""
            local combined
            if nameStr ~= "" and distStr ~= "" then
                combined = nameStr .. " " .. distStr
            else
                combined = nameStr .. distStr
            end
            data.GuiTagName.Text = combined
            data.GuiTagName.TextColor3 = Config.ESP.NameColor or Color3.fromRGB(240, 240, 250)
            data.GuiTagName.Visible = true
            _espSyncDrawNameGeom(data, cx, T, combined, data.GuiTagName.TextColor3)
        end
        local sImg = data.GuiTagSync
        if sImg then
            local logo = (type(_ECLIPSE_HUB_SyncLogo) == "function") and _ECLIPSE_HUB_SyncLogo() or nil
            local synced = (type(_ECLIPSE_HUB_SyncHas) == "function") and _ECLIPSE_HUB_SyncHas(plr) or false
            if logo and synced and data.GuiTagName and data.GuiTagName.Visible then
                local h = math.floor((data.GuiTagName.TextSize or 12))
                local w = 0
                pcall(function() w = data.GuiTagName.TextBounds.X end)
                if sImg.Image ~= logo then sImg.Image = logo end
                sImg.Size = UDim2.fromOffset(h, h)
                sImg.Position = UDim2.new(0.5, -math.floor(w * 0.5) - 3, 1, 0)
                sImg.Visible = true
            else
                sImg.Visible = false
            end
        end
    elseif f then
        f.Visible = false
        if data.GuiTagName then data.GuiTagName.Visible = false end
        if data.GuiTagSync then data.GuiTagSync.Visible = false end
        if data.DrawName then pcall(function() data.DrawName.Visible = false end) end
    end

    if f and anyTop then
        totalH = totalH + NAME_H
    end

    local fb = data.GuiTagBot
    if fb and anyBot then
        fb.Size     = UDim2.fromOffset(BOX_W, ICON_H)
        fb.Position = UDim2.fromOffset(math.floor(cx), math.floor((B or T or 0) + 4))
        fb.Visible  = true

        if data.GuiTagIcon then
            if data.LastWeaponIcon ~= weaponIconAsset then
                data.GuiTagIcon.Image = weaponIconAsset
                data.LastWeaponIcon = weaponIconAsset
            end

            data.GuiTagIcon.Size = UDim2.fromOffset(BOX_W, ICON_H)
            data.GuiTagIcon.Position = UDim2.new(0.5, 0, 0, 0)
            data.GuiTagIcon.Visible = true
        end
        if data.GuiTagDist then data.GuiTagDist.Visible = false end
    elseif fb then
        fb.Visible = false
        if data.GuiTagIcon then data.GuiTagIcon.Visible = false end
        if data.GuiTagDist then data.GuiTagDist.Visible = false end
    end

    if data.WeaponIcon then data.WeaponIcon.Visible = false end

    if fb and anyBot then
        totalH = totalH + ICON_H + GAP
    end

    if moneyStr then
        if data.MoneyText then data.MoneyText.Visible = false end
        local midY = math.floor(((T or 0) + (B or (T or 0))) * 0.5)
        local mx = math.floor((R or cx) + 10)
        local col = Color3.fromRGB(80, 220, 110)

        if _DRAW_OK and _espSyncDrawMoney(data, mx, midY, moneyStr, col) then
            if data.GuiMoney then data.GuiMoney.Visible = false end
        else
            local m = _espEnsureMoneyGui(data)
            if m then
                m.Text = moneyStr
                m.TextColor3 = col
                m.Position = UDim2.fromOffset(mx, midY)
                m.Visible = true
            end
        end
    else
        if data.MoneyText then data.MoneyText.Visible = false end
        if data.GuiMoney  then data.GuiMoney.Visible = false end
        _espHideDrawMoney(data)
    end

    if moneyStr then
        totalH = totalH + 22
    end

    return totalH + (moneyStr and 0 or 10)
end

ESP_SLOT_CYCLES = {
    Name     = {"Top","Bottom","Left","Right"},
    Distance = {"Top","Bottom","Left","Right"},
    Weapon   = {"Bottom","Top","Left","Right"},
    Health   = {"Left","Right"},
}

function _espSlotSide(kind)
    local cyc = ESP_SLOT_CYCLES[kind]; if not cyc then return "Top" end
    local i = (Config.ESP.SlotPos and Config.ESP.SlotPos[kind]) or 1
    return cyc[((i-1) % #cyc) + 1]
end

function _espIsSlotDefault(kind)
    return ((Config.ESP.SlotPos and Config.ESP.SlotPos[kind]) or 1) == 1
end

function _espTextLayout(L, R, T, B, cx)
    local buckets = { Top={}, Bottom={}, Left={}, Right={} }

    for _, kind in ipairs({"Name","Distance","Weapon"}) do
        table.insert(buckets[_espSlotSide(kind)], kind)
    end
    local out = {}
    for side, list in pairs(buckets) do
        for i, kind in ipairs(list) do
            local step = (i-1) * 16
            local x, y
            if side == "Top"    then x, y = cx,        T - 18 - step
            elseif side == "Bottom" then x, y = cx,    B + 18 + step
            elseif side == "Left"   then x, y = L - 55 - step, (T + B) * 0.5 + (i-1) * 16
            else                          x, y = R + 55 + step, (T + B) * 0.5 + (i-1) * 16
            end
            out[kind] = { side=side, x=x, y=y }
        end
    end
    return out
end

