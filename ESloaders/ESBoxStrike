connectSignal(RunService.Heartbeat:Connect(function()
    if not scriptRunning then return end
    local now = os.clock()

    if _SkinDX.skinsRepeatTs > 0 and now >= _SkinDX.skinsRepeatTs then
        _SkinDX.skinsRepeatTs = 0
        _skinMarkSkinsDirty(0)
    end
    if _SkinDX.gloveRepeatTs > 0 and now >= _SkinDX.gloveRepeatTs then
        _SkinDX.gloveRepeatTs = 0
        _skinMarkGloveDirty(0)
    end

    if now - _SkinDX.lastSafety >= 1.5 then
        _SkinDX.lastSafety = now
        if Config.Skins.SkinChangerEnabled and IsAlive() then
            _skinMarkGloveDirty(0)
            _skinMarkSkinsDirty(0)
        end
    end

    if _SkinDX.skinsDirty and now >= _SkinDX.skinsMinTs then
        _SkinDX.skinsDirty = false
        if Config.Skins.SkinChangerEnabled and IsAlive() then
            _SkinDX.lastSkins = now
            pcall(_TW_ApplyAllCameraSkins)
        end
    end
    if _SkinDX.gloveDirty and now >= _SkinDX.gloveMinTs then
        _SkinDX.gloveDirty = false
        if Config.Skins.SkinChangerEnabled and IsAlive() then
            _SkinDX.lastGlove = now
            pcall(_applySelectedGloveSkin)
        end
    end

    local vmInterval = ES152.adaptiveInterval(0.22, 2)
    if now - _SkinDX.lastVMCheck >= vmInterval then
        _SkinDX.lastVMCheck = now
        local living = IsAlive()
        if SkinSystem.spawned then
            local vm = SkinSystem.vm
            if (not vm) or (not vm.Parent) then
                SkinSystem.spawned = false
                SkinSystem.vm = nil
            end
        end
        local ck = _findCameraBaseKnife()
        if SkinSystem.scriptRunning and living and ck and not SkinSystem.spawned then
            spawnViewmodel(ck)
            if SkinSystem.spawned then
                pcall(_TW_ApplyAllCameraSkinsNow or _TW_ApplyAllCameraSkins)
                pcall(_applySelectedGloveSkin)
                SkinSystem._lastRealtimeKey = _ECLIPSE_HUBCurrentSkinRealtimeKey()
                pcall(_applyHUDKnife, true)
            end
        elseif (not SkinSystem.scriptRunning or not ck or not living) and SkinSystem.spawned then
            removeViewmodel()
        end
    end

    if now - _SkinDX.lastWatchdog >= 0.9 then
        _SkinDX.lastWatchdog = now
        if Config.Skins.SkinChangerEnabled and IsAlive() then
            local expected
            for gt in pairs(GLOVES) do
                local s = Config.Skins.SelectedSkins[gt]
                if s and s ~= "" and s ~= "Vanilla" and s ~= "Default" and s ~= "None" then
                    expected = gt.."/"..s; break
                end
            end
            if expected then
                local cam = workspace.CurrentCamera
                if cam then
                    for _, ch in ipairs(cam:GetChildren()) do
                        if ch:IsA("Model") and (ch.Name:match("Arms") or ch:FindFirstChild("Right Arm")) then
                            local ra = ch:FindFirstChild("Right Arm")
                            local la = ch:FindFirstChild("Left Arm")
                            local rg = ra and ra:FindFirstChild("Glove")
                            local lg = la and la:FindFirstChild("Glove")
                            if (rg and rg:GetAttribute("ECLIPSE_HUBSkinSource") ~= expected)
                               or (lg and lg:GetAttribute("ECLIPSE_HUBSkinSource") ~= expected) then
                                _skinMarkGloveDirty(0)
                            end
                            break
                        end
                    end
                end
            end
        end
    end
end))

