        return fallback
    end

    local function resultFor(origin, point, part, distance)
        local direction = point - origin
        if direction.Magnitude < 0.001 or not part or not part:IsA("BasePart") then return nil end
        direction = direction.Unit
        return {
            Distance = distance or (point - origin).Magnitude,
            Origin = origin,
            Direction = direction,
            Hits = {{
                Position = point,
                Instance = part,
                Material = part.Material.Name,
                Normal = -direction,
                Exit = false,
            }},
        }
    end

    local function hitOutline(entry)
        if flag("combat_redirect_hit_outline", true) ~= true then return end
        local character = entry.character
        if not character then return end
        local old = state.hitOutlines[character]
        if old then pcall(function() old:Destroy() end) end
        local highlight = Instance.new("Highlight")
        highlight.Name = "EclipseWtfHitOutline"
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.FillColor = Color3.fromRGB(165, 70, 255)
        highlight.OutlineColor = Color3.fromRGB(245, 245, 255)
        highlight.FillTransparency = 0.82
        highlight.OutlineTransparency = 0.05
        highlight.Adornee = character
        highlight.Parent = character
        state.hitOutlines[character] = highlight
        task.delay(0.13, function()
            if state.hitOutlines[character] == highlight then
                state.hitOutlines[character] = nil
            end
            pcall(function() highlight:Destroy() end)
        end)
    end

    local function hitLog(entry)
        if flag("combat_redirect_hit_logs", true) ~= true then return end
        local reporter = G.__runtime_report_predicted_hit
        if type(reporter) == "function" then
            pcall(reporter, entry.player, entry.part, entry.damage, math.max(0, 100 - entry.damage), 1)
        end
    end

    local function record(entry)
        local combat = G.__bloxstrike_combat
        if type(combat) == "table" then
            combat.lastRedirectTarget = entry.player
            combat.lastRedirectPart = entry.part
            combat.lastRedirectEstimatedDamage = entry.damage
            combat.lastRedirectWallThickness = entry.thickness
            combat.redirectedBullets = (tonumber(combat.redirectedBullets) or 0) + 1
            combat.redirectCount = combat.redirectedBullets
            combat.lastRedirectAt = os.clock()
        end
        G.__eclipse_last_redirect = entry
        hitOutline(entry)
        hitLog(entry)
    end

    if not state.installed and type(Bullet) == "table" and type(Bullet._performRaycast) == "function" and type(hookfunction) == "function" then
        local original = Bullet._performRaycast
        local function hooked(self, spread)
            local native = original(self, spread)
            if flag("combat_bullet_redirect", false) ~= true then return native end
            local chance = math.clamp(tonumber(flag("combat_redirect_hit_chance", 100)) or 100, 0, 100)
            if chance <= 0 or (chance < 100 and math.random() * 100 > chance) then
                return native
            end
            if type(native) ~= "table" or typeof(native.Origin) ~= "Vector3" then return native end
            local weapon = (type(self) == "table" and rawget(self, "Weapon")) or currentWeapon()
            local origin = muzzle(weapon, native.Origin)
            local entry = chooseTarget(origin, weapon)
            if not entry then return native end
            if not directHit(origin, entry.point, entry.character) and flag("combat_auto_wall", false) ~= true then
                return native
            end
            if flag("combat_auto_wall", false) == true then
                local minDamage = math.max(0, tonumber(flag("combat_auto_wall_min_damage", 1)) or 1)
                if entry.damage < minDamage and flag("combat_override_damage", false) ~= true then
                    return native
                end
            end
            record(entry)
            return resultFor(native.Origin, entry.point, entry.part, entry.distance) or native
        end
        local ok = pcall(function()
            hookfunction(Bullet._performRaycast, hooked)
        end)
        state.installed = ok
    end

    local nextRefresh = 0
    local function refreshWeaponProperties()
        local now = os.clock()
        if now < nextRefresh then return end
        nextRefresh = now + 0.15
        local weapon = currentWeapon()
        if type(weapon) ~= "table" then return end
        local properties = rawget(weapon, "Properties")
        if type(properties) ~= "table" then return end
        if not state.props[properties] then
            state.props[properties] = {
                Penetration = rawget(properties, "Penetration"),
                DamagePerPart = type(rawget(properties, "DamagePerPart")) == "table" and table.clone(rawget(properties, "DamagePerPart")) or nil,
            }
        end
        local saved = state.props[properties]
        properties.Penetration = flag("combat_infinite_penetration", false) == true and math.huge or saved.Penetration
        if flag("combat_override_damage", false) == true and type(rawget(properties, "DamagePerPart")) == "table" then
            local value = math.max(1, tonumber(flag("combat_override_damage_value", 100)) or 100)
            for key in pairs(properties.DamagePerPart) do
                properties.DamagePerPart[key] = value
            end
        elseif saved.DamagePerPart then
            properties.DamagePerPart = table.clone(saved.DamagePerPart)
        end
    end

    G.__eclipse_refresh_bullet_redirect = refreshWeaponProperties
    G.__eclipse_autowall_scan = function(origin)
        local camera = Workspace.CurrentCamera
        if typeof(origin) ~= "Vector3" then
            origin = camera and camera.CFrame.Position
        end
        if typeof(origin) ~= "Vector3" then return nil end
        return chooseTarget(origin, currentWeapon())
    end
    RunService.Heartbeat:Connect(refreshWeaponProperties)
end
