                if not scriptRunning or not Config.Misc.ThirdPerson then return end
                if c.Name == "HumanoidRootPart" or c:IsA("Humanoid") then
                    task.wait(0.05); pcall(_tpEnable)
                end
            end)
            connectSignal(ccAdded)
        end
    end))

    connectSignal(LocalPlayer.CharacterRemoving:Connect(function()
        pcall(_clearMirror)
        pcall(_clearSelfDummy)
    end))
end

do
    local RunS = game:GetService("RunService")

    local _highlights = {}
    local _cache      = {}
    local _visualCache = setmetatable({}, { __mode = "k" })
    local _whShells   = setmetatable({}, { __mode = "k" })
    local function _clearWHShell(part)
        local sh = _whShells[part]
        if sh then pcall(function() sh:Destroy() end); _whShells[part] = nil end
