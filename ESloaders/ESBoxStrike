function ActiveRCS()
    local mode = _cfgMode(Config.RCS.Mode or "Global")
    if mode == "Global" then
        return Config.RCS.Vertical, Config.RCS.Horizontal
    end
    local n = _heldWeaponNameNormalized()
    if not n then
        local cam = Workspace.CurrentCamera
        if cam then
            for _, ch in ipairs(cam:GetChildren()) do
                if ch:IsA("Model") then
                    local nn = ch.Name
                    if nn ~= "Arms" and nn ~= "Arms1" and nn ~= "Arms2" and nn ~= "Viewmodel" then n = _normalizeWeaponName(nn); break end
                end
            end
        end
    end
    n = n or _normalizeWeaponName(Config.RCS.SelectedWeapon)
    local o = n and Config.RCS.PerWeapon[n] or nil
    return (o and o.Vertical) or Config.RCS.Vertical, (o and o.Horizontal) or Config.RCS.Horizontal
end

