-- cache downloaded http sounds as temporary data when possible
local HitSoundCache = {}
local function resolveHitSoundId(id)
    if type(id) ~= "string" or id == "" then return nil end
    if id:find("rbxassetid://", 1, true) or id:match("^%d+$") then
        if id:match("^%d+$") then return "rbxassetid://" .. id end
        return id
    end
    if HitSoundCache[id] then return HitSoundCache[id] end
    -- try writefile + getcustomasset for http wavs
    pcall(function()
        local req = (syn and syn.request) or http_request or request
        if not req then return end
        local res = req({ Url = id, Method = "GET" })
        if res and res.Body and #res.Body > 64 then
            local fname = "eclipse_hs_" .. tostring(math.floor(os.clock() * 1000)) .. ".wav"
            if writefile then writefile(fname, res.Body) end
            if getcustomasset then
                HitSoundCache[id] = getcustomasset(fname)
            elseif getsynasset then
                HitSoundCache[id] = getsynasset(fname)
            end
        end
    end)
    return HitSoundCache[id] or id
end
