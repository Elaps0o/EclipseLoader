    end

    local function _snapshot(part)
        if _cache[part] then return end
        local ok, snap = pcall(function()
            return {
                mat   = part.Material,
                refl  = part.Reflectance,
                col   = part.Color,
                tr    = part.Transparency,
                ltm   = part.LocalTransparencyModifier,
                texID = (part:IsA("MeshPart")) and part.TextureID or nil,
            }
        end)
        if ok then _cache[part] = snap end
    end

    local function _restore(part)
        local s = _cache[part]; if not s then return end
        pcall(function()
            if part and part.Parent then
                part.Material                  = s.mat
                part.Reflectance               = s.refl
                part.Color                     = s.col
                part.Transparency              = s.tr
                part.LocalTransparencyModifier = s.ltm
                if s.texID ~= nil and part:IsA("MeshPart") then
                    part.TextureID = s.texID
                end
            end
        end)
        _clearWHShell(part)
        _cache[part] = nil
    end

    local function _snapshotVisual(inst)
        if _visualCache[inst] then return end
        local ok, snap = pcall(function()
            if inst:IsA("Decal") or inst:IsA("Texture") then
                return { kind = "texture", tr = inst.Transparency, color = inst.Color3 }
            elseif inst:IsA("SurfaceAppearance") then
                return {
                    kind = "surface",
                    ColorMap = inst.ColorMap,
                    NormalMap = inst.NormalMap,
                    RoughnessMap = inst.RoughnessMap,
                    MetalnessMap = inst.MetalnessMap,
                    AlphaMode = inst.AlphaMode,
                }
            elseif inst:IsA("SpecialMesh") then
                return { kind = "mesh", textureId = inst.TextureId }
            end
        end)
        if ok and snap then _visualCache[inst] = snap end
    end

    local function _restoreVisual(inst)
        local s = _visualCache[inst]; if not s then return end
        pcall(function()
            if inst and inst.Parent then
                if s.kind == "texture" then
                    inst.Transparency = s.tr
                    inst.Color3 = s.color
                elseif s.kind == "surface" then
                    pcall(function() inst.ColorMap = s.ColorMap end)
                    pcall(function() inst.NormalMap = s.NormalMap end)
                    pcall(function() inst.RoughnessMap = s.RoughnessMap end)
                    pcall(function() inst.MetalnessMap = s.MetalnessMap end)
                    pcall(function() inst.AlphaMode = s.AlphaMode end)
                elseif s.kind == "mesh" then
                    inst.TextureId = s.textureId
                end
            end
        end)
        _visualCache[inst] = nil
    end

    local function _restoreAllTouched(rec)
        if not rec or not rec.touched then return end
        for part,_ in pairs(rec.touched) do _restore(part) end
        rec.touched = {}
        if rec.visuals then
            for inst,_ in pairs(rec.visuals) do _restoreVisual(inst) end
            rec.visuals = {}
        end
    end

    local function _clearOne(m)
        local h = _highlights[m]; if not h then return end
        _restoreAllTouched(h)
        if h.fill then pcall(function() h.fill:Destroy() end) end
        if h.rim  then pcall(function() h.rim:Destroy()  end) end
        pcall(function()
            local ff = m and m.Parent and m:FindFirstChild("ECLIPSE_HUBWHGhostFF")
            if ff then ff:Destroy() end
        end)
        _highlights[m] = nil
    end

    local function _clearAll()
        for m,_ in pairs(_highlights) do _clearOne(m) end

        for p,_ in pairs(_cache) do _restore(p) end
        _cache = {}
        for inst,_ in pairs(_visualCache) do _restoreVisual(inst) end
        _visualCache = setmetatable({}, { __mode = "k" })
        pcall(function()
            local cam = workspace.CurrentCamera
            if cam then
                local f = cam:FindFirstChild("_EclipseWeaponChamsOverlay")
                if f then pcall(function() f:Destroy() end) end
            end
            for _, root in ipairs({ workspace.CurrentCamera, workspace }) do
                if root then
                    for _, d in ipairs(root:GetDescendants()) do
                        if (d:IsA("BasePart") and (d:GetAttribute("ECLIPSE_HUBWHShell") or d:GetAttribute("ECLIPSE_HUBWHShellFlag") or d.Name == "ECLIPSE_HUBWHShell" or d.Name == "ECLIPSE_HUBWHGhostShell"))
                        or (d:IsA("Highlight") and (d.Name == "ECLIPSE_HUBWH" or d.Name == "ECLIPSE_HUBWHRim"))
                        or (d:IsA("ForceField") and d.Name == "ECLIPSE_HUBWHGhostFF")
                        or (d:IsA("WeldConstraint") and d.Name == "ECLIPSE_HUBWHWeld") then
                            pcall(function() d:Destroy() end)
                        end
                    end
                end
            end
        end)
    end

    local Lighting = game:GetService("Lighting")
    local function _WHFX_disable()
        pcall(function()
            for _, d in ipairs(Lighting:GetChildren()) do
                if d.Name == "ECLIPSE_HUBWHBlur" or d.Name == "ECLIPSE_HUBWHBloom" then
                    pcall(function() d:Destroy() end)
                end
            end
        end)
    end
    local function _WHFX_ensure() _WHFX_disable() end
    local function _WHFX_apply(_,_) _WHFX_disable() end
    pcall(_WHFX_disable)

    _G.ECLIPSE_HUBWHClear = _clearAll

    if LocalPlayer then
        connectSignal(LocalPlayer.CharacterAdded:Connect(function()
            if scriptRunning then _clearAll(); task.wait(0.4) end
        end))
        connectSignal(LocalPlayer.CharacterRemoving:Connect(function()
            if scriptRunning then _clearAll() end
        end))
    end

    local KNIFE_KEYWORDS = {
        "knife","bayonet","karambit","butterfly","stiletto","skeleton","huntsman",
        "talon","gut","navaja","nomad","paracord","survival","shadow","daggers",
        "classic","ursus","flip","m9",
    }
    local function _isKnifeName(n)
        n = tostring(n or ""):lower()
        for _, kw in ipairs(KNIFE_KEYWORDS) do
            if n:find(kw, 1, true) then return true end
        end
        return false
    end

    local WH_BODY_WORDS = {
        arm=true, arms=true, hand=true, hands=true, glove=true, gloves=true,
        sleeve=true, sleeves=true,
    }
    local WH_WEAPON_WORDS = {
        weapon=true, weapons=true, gun=true, rifle=true, pistol=true, smg=true, shotgun=true, sniper=true,
        knife=true, blade=true, bayonet=true, karambit=true, butterfly=true, stiletto=true, skeleton=true,
        ak=true, ak47=true, m4=true, m4a1=true, m4a4=true, awp=true, aug=true, famas=true, galil=true, glock=true,
        usp=true, p2000=true, p250=true, tec=true, tec9=true, five=true, fiveseven=true, cz=true, cz75=true,
        deagle=true, revolver=true, r8=true, beretta=true, dualies=true, mac=true, mac10=true, mp=true, mp5=true,
        mp7=true, mp9=true, ump=true, p90=true, bizon=true, nova=true, mag=true, mag7=true,
        sawed=true, sawedoff=true, xm=true, xm1014=true, negev=true, m249=true, scar=true, scar20=true,
        g3sg1=true, ssg=true, ssg08=true, sg=true, sg553=true, taser=true, zeus=true, c4=true, bomb=true,
        handle=true, barrel=true, magazine=true, slide=true, receiver=true, scope=true, muzzle=true, stock=true,
    }
    local function _whHasWord(name, words)
        local n = tostring(name or ""):lower():gsub("[%p_]+", " ")
        for w in n:gmatch("%w+") do if words[w] then return true end end
        return false
    end
    local function _whBodyHint(inst, root)
        local p = inst
        while p and p ~= workspace and p ~= root do
            if _whHasWord(p.Name, WH_BODY_WORDS) then return true end
            p = p.Parent
        end
        return false
    end
    local function _whWeaponHint(inst, root)
        local p = inst
        while p and p ~= workspace and p ~= root do
            if _whHasWord(p.Name, WH_WEAPON_WORDS) or _isKnifeName(p.Name) then return true end
            p = p.Parent
        end
        return false
    end
    local function _whModelWeaponLike(model)
        if not model then return false end
        if _whHasWord(model.Name, WH_WEAPON_WORDS) or _isKnifeName(model.Name) then return true end
        local checked = 0
        for _, d in ipairs(model:GetDescendants()) do
            checked = checked + 1
            if checked > 80 then break end
            if _whHasWord(d.Name, WH_WEAPON_WORDS) or _isKnifeName(d.Name) then return true end
        end
        return false
    end

    local function _collectVMWeapons()
        local out, seen = {}, {}
        local function add(m)
            if m and m:IsA("Model") and not seen[m]
               and m:IsDescendantOf(workspace.CurrentCamera or Camera) then
                seen[m] = true
                table.insert(out, m)
            end
        end
        local cam = workspace.CurrentCamera
        if cam then
            local function scan(node, depth)
                if not node or depth > 5 then return false end
                local added = false
                for _, ch in ipairs(node:GetChildren()) do
                    if ch:IsA("Model") then
                        local weaponLike = _whWeaponHint(ch, node) or _whModelWeaponLike(ch)
                        local bodyLike = _whHasWord(ch.Name, WH_BODY_WORDS)
                        if weaponLike and not bodyLike then
                            add(ch); added = true
                        end
                        if scan(ch, depth + 1) then added = true end
                    elseif ch:IsA("Folder") then
                        if scan(ch, depth + 1) then added = true end
                    end
                end
                return added
            end
            for _, top in ipairs(cam:GetChildren()) do
                if top:IsA("Model") then
                    local addedChild = scan(top, 1)
                    if not addedChild and (_whModelWeaponLike(top) or _whWeaponHint(top, cam)) and not _whHasWord(top.Name, WH_BODY_WORDS) then
                        add(top)
                    end
                    if not addedChild then
                        local partCount, bodyCount, hitboxCount = 0, 0, 0
                        for _, d in ipairs(top:GetDescendants()) do
                            if d:IsA("BasePart") then
                                partCount = partCount + 1
                                local lname = tostring(d.Name or ""):lower()
                                if _whBodyHint(d, top) then bodyCount = bodyCount + 1 end
                                if lname:find("hitbox", 1, true) or lname:find("hurtbox", 1, true)
                                   or lname:find("collider", 1, true) or lname:find("collision", 1, true) then
                                    hitboxCount = hitboxCount + 1
                                end
                            end
                            if partCount > 80 then break end
                        end
                        if partCount > 0 and hitboxCount < partCount and bodyCount < partCount then
                            add(top)
                        end
                    end
                end
            end
        end
        return out
    end

    local whPartBlacklist = {
        humanoidrootpart=true, rootpart=true, root=true, camera=true, aim=true,
    }
    local function _isWHPart(part, root)
        if not (part and part:IsA("BasePart")) then return false end
        if part.Name == "ECLIPSE_HUBWHGhostShell" or part:GetAttribute("ECLIPSE_HUBWHShellFlag") then return false end
        if _whBodyHint(part, root) and not _whWeaponHint(part, root) then return false end
        local n = tostring(part.Name or ""):lower()
        if whPartBlacklist[n] then return false end
        if n:find("hitbox", 1, true) or n:find("hurtbox", 1, true)
           or n:find("collider", 1, true) or n:find("collision", 1, true)
           or n:find("bound", 1, true) or n:find("bbox", 1, true) then
            return false
        end

        local origTr = _cache[part] and _cache[part].tr or part.Transparency
        if origTr >= 0.98 and not part:FindFirstChildOfClass("SpecialMesh")
           and not part:IsA("MeshPart") and not part:FindFirstChildOfClass("SurfaceAppearance") then
            return false
        end
        local s = part.Size
        if s and (s.X > 8 or s.Y > 8 or s.Z > 8) then return false end
        local anc = part.Parent
        local depth = 0
        while anc and anc ~= root and depth < 4 do
            if _whHasWord(anc.Name, WH_BODY_WORDS) then return false end
            anc = anc.Parent; depth = depth + 1
        end
        return true
    end

    local WH_STYLES = {
        Illum = { mat = Enum.Material.Neon,       refl = 0.00, partTr = 0.00, clearTex = true },
        Ghost = { mat = Enum.Material.ForceField, refl = 0.00, partTr = 1.00, clearTex = true,
                  shell = true, shellMat = Enum.Material.ForceField, shellT = 0.15, shellScale = 1.004 },
    }

    local WH_SHELL_NAME = "ECLIPSE_HUBWHGhostShell"

    local function _ensureWHShell(part, color, st)
        local sh = _whShells[part]
        if not (sh and sh.Parent) then
            local ok, clone = pcall(function() return part:Clone() end)
            if not ok or not clone or not clone:IsA("BasePart") then return end
            pcall(function()
                for _, c in ipairs(clone:GetDescendants()) do
                    if c:IsA("SurfaceAppearance") or c:IsA("Decal") or c:IsA("Texture")
                       or c:IsA("Highlight") or c:IsA("PointLight") or c:IsA("SpotLight")
                       or c:IsA("Beam") or c:IsA("Trail") or c:IsA("ParticleEmitter")
                       or c:IsA("Script") or c:IsA("LocalScript") or c:IsA("ModuleScript")
                       or c:IsA("Sound") or c:IsA("BasePart") or c:IsA("Motor6D")
                       or c:IsA("WeldConstraint") or c:IsA("Weld") then
                        pcall(function() c:Destroy() end)
                    end
                end
                clone.Name         = WH_SHELL_NAME
                clone.Anchored     = false
                clone.CanCollide   = false
                clone.CanQuery     = false
                clone.CanTouch     = false
                clone.Massless     = true
                clone.CastShadow   = false
                clone.Material     = st.shellMat
                clone.Reflectance  = 0
                clone.Color        = color
                clone.Transparency = st.shellT
                clone.LocalTransparencyModifier = 0
                clone.Size         = part.Size * (st.shellScale or 1.03)
                clone.CFrame       = part.CFrame
                clone:SetAttribute("ECLIPSE_HUBWHShellFlag", true)
                clone.Parent       = part
                local w = Instance.new("WeldConstraint")
                w.Name = "ECLIPSE_HUBWHWeld"
                w.Part0 = part; w.Part1 = clone; w.Parent = clone
            end)
            _whShells[part] = clone
        else
            pcall(function()
                sh.Material     = st.shellMat
                sh.Color        = color
                sh.Transparency = st.shellT
                sh.LocalTransparencyModifier = 0
                sh.Size         = part.Size * (st.shellScale or 1.03)
            end)
        end
    end

    local function _applyChams(model, color, inten)
        if not model or not model.Parent then return end
        local rec = _highlights[model]
        if not rec then rec = { touched = {}, visuals = {} }; _highlights[model] = rec end
        rec.touched = rec.touched or {}
        rec.visuals = rec.visuals or {}

        if rec.fill then pcall(function() rec.fill:Destroy() end); rec.fill = nil end
        if rec.rim  then pcall(function() rec.rim:Destroy()  end); rec.rim  = nil end

        local styleName = tostring(Config.Misc.WeaponChamsStyle or "Illum")
        local st = WH_STYLES[styleName] or WH_STYLES.Illum
        local a  = math.clamp(inten or 1, 0.2, 3.0)
        local partTr = math.clamp(st.partTr * (1 / a), 0.00, 0.90)
        if styleName == "Ghost" then
            partTr = 1.00
        end

        do
            local old = model:FindFirstChild("ECLIPSE_HUBWHGhostFF")
            if old then pcall(function() old:Destroy() end) end
        end

        local seen = {}
        for _, part in ipairs(model:GetDescendants()) do
            if _isWHPart(part, model) then
                seen[part] = true
                _snapshot(part)
                pcall(function()
                    part.Material    = st.mat
                    part.Reflectance = st.refl
                    part.Color       = color
                    part.Transparency = partTr
                    part.LocalTransparencyModifier = 0
                    if st.clearTex and part:IsA("MeshPart") and part.TextureID ~= "" then
                        if styleName == "Ghost" or styleName == "Illum" then
                            part.TextureID = ""
                        end
                    end
                    for _, child in ipairs(part:GetChildren()) do
                        if child:IsA("Decal") or child:IsA("Texture") then
                            _snapshotVisual(child)
                            child.Transparency = 1
                            child.Color3 = color
                            rec.visuals[child] = true
                        elseif child:IsA("SurfaceAppearance") then
                            _snapshotVisual(child)
                            pcall(function() child.ColorMap = "" end)
                            pcall(function() child.NormalMap = "" end)
                            pcall(function() child.RoughnessMap = "" end)
                            pcall(function() child.MetalnessMap = "" end)
                            rec.visuals[child] = true
                        elseif child:IsA("SpecialMesh") then
                            _snapshotVisual(child)
                            pcall(function() child.TextureId = "" end)
                            rec.visuals[child] = true
                        end
                    end
                end)
                if st.shell then
                    _ensureWHShell(part, color, st)
                else
                    _clearWHShell(part)
                end
                rec.touched[part] = true
            end
        end

        for part,_ in pairs(rec.touched) do
            if (not seen[part]) or (not part.Parent) then
                _restore(part)
                rec.touched[part] = nil
            end
        end
        for inst,_ in pairs(rec.visuals) do
            if not inst.Parent then
                _visualCache[inst] = nil
                rec.visuals[inst] = nil
            end
        end
    end

    connectSignal(RunS.Heartbeat:Connect(ES152.guard("WH.sync", function()
        if not scriptRunning then return end
        if not Config.Misc.WeaponHighlight then
            if next(_highlights) or next(_cache) then _clearAll() end
            return
        end
        local lpChar = LocalPlayer and LocalPlayer.Character
        local hum = lpChar and lpChar:FindFirstChildOfClass("Humanoid")
        if not (lpChar and hum and hum.Health > 0 and workspace.CurrentCamera) then
            if next(_highlights) or next(_cache) then _clearAll() end
            return
        end
        local inTP = Config.Misc and Config.Misc.ThirdPerson
        local list
        if inTP then
            local mc = _G.__ECLIPSE_MIRROR_CLONE
            list = (mc and mc.Parent) and { mc } or {}
        else
            list = _collectVMWeapons()
        end
        local active = {}
        for _, m in ipairs(list) do active[m] = true end
        for m,_ in pairs(_highlights) do
            if not active[m] or not m.Parent then _clearOne(m) end
        end
        local inten = tonumber(Config.Misc.WeaponHighlightIntensity) or 1.0
        if inten < 0.2 then inten = 0.2 end
        local col = Config.Misc.WeaponHighlightColor or Color3.fromRGB(0, 170, 255)
        for _, m in ipairs(list) do _applyChams(m, col, inten) end
        if #list > 0 then _WHFX_apply(inten, col) else _WHFX_disable() end
    end)))

end

