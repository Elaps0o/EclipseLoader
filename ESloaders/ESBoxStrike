    _G.ECLIPSE_Extrapolate = function(pos, vel, pingMs)
        if not (Toggles.ExtrapolationEnabled and Toggles.ExtrapolationEnabled.Value) then
            return pos
        end
        local scale = Options.ExtrapolationScale and Options.ExtrapolationScale.Value or 3
        -- 30ms -> scale 3, so factor = scale/30 per ms, applied as seconds * scale/30 * 1000 roughly
        -- interpret: units of extrapolation = (pingMs/30) * scale * 0.1 studs direction of vel
        local factor = (pingMs or 30) / 30 * (scale / 10)
        if not vel or vel.Magnitude < 0.05 then return pos end
        return pos + vel * factor
    end

    _G.ECLIPSE_BacktrackPos = function(plr)
        if not (Toggles.BacktrackEnabled and Toggles.BacktrackEnabled.Value) then return nil end
        local h = BT.history[plr]
