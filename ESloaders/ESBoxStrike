        if C4UI.avatarBox then C4UI.avatarBox.Visible = false end
        C4UI.avatar.Image = ""
        C4UI.avFallback.Visible = false
        C4UI.hpBg.Visible = false
        C4UI.hpText.Visible = false
        C4UI.distText.Visible = false
        C4UI.infoStatus.Text = subtitle
    end

    local hasAvatar = (info and info.player) ~= nil
    if C4UI.avatarBox then
        C4UI.avatarBox.Visible = hasAvatar
    end
    if C4UI.infoName then
        C4UI.infoName.Text = title
        pcall(function()
            local TweenService = game:GetService("TweenService")
