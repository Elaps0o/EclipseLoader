        local tMdl = targetPlayer and targetPlayer.Character
        local tHum = tMdl and tMdl:FindFirstChildOfClass("Humanoid")
        local isKill = (tHum and tHum.Health > 0 and (tHum.Health - dmg) <= 0) or false

        pcall(function()
