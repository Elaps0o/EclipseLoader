function _collectGuiInstances(obj, out, depth, seen)
    out = out or {}; depth = depth or 0; seen = seen or {}
    if type(obj) ~= "table" or depth > 3 or seen[obj] then return out end
    seen[obj] = true

    local inst = rawget(obj, "Instance")
    if typeof(inst) == "Instance" and inst:IsA("GuiObject") then
        table.insert(out, inst)
    end
    local items = rawget(obj, "Items")
    if type(items) == "table" then
        for _, v in pairs(items) do
            if typeof(v) == "Instance" and v:IsA("GuiObject") then
                table.insert(out, v)
            elseif type(v) == "table" then
                _collectGuiInstances(v, out, depth + 1, seen)
            end
        end
    end
    local nl = rawget(obj, "_nl")
    if type(nl) == "table" then _collectGuiInstances(nl, out, depth + 1, seen) end
    return out
end

function _uiSetDisabled(obj, disabled)
