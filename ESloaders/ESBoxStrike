    local baseTh = Options.TracerThickness and Options.TracerThickness.Value or 0.04
    local dist = (startPos - endPos).Magnitude
    if dist < 0.15 then return end
    local mid = (startPos + endPos) / 2
    local cf = CFrame.lookAt(mid, endPos)

    local function makeCore(th, mat, trans, col)
        local p = Instance.new("Part")
        p.Name = "ECLIPSE_Tracer"
        p.Anchored = true
        p.CanCollide = false
        p.CanQuery = false
        p.CanTouch = false
        p.CastShadow = false
        p.Material = mat or Enum.Material.Neon
        p.Color = col or tracerColor
        p.Transparency = trans or 0.05
        p.Size = Vector3.new(th, th, dist)
        p.CFrame = cf
        p.Parent = Workspace
        return p
    end

    local parts = {}
    if style == "Laser" then
        parts[#parts+1] = makeCore(baseTh * 0.55, Enum.Material.Neon, 0.02, tracerColor)
        local g = makeCore(baseTh * 1.4, Enum.Material.Neon, 0.72, tracerColor)
        parts[#parts+1] = g
    elseif style == "Plasma" then
        parts[#parts+1] = makeCore(baseTh * 0.7, Enum.Material.ForceField, 0.15, tracerColor)
        local outer = makeCore(baseTh * 1.8, Enum.Material.ForceField, 0.7, tracerColor:Lerp(Color3.new(1,1,1), 0.35))
        parts[#parts+1] = outer
    elseif style == "Ribbon" then
        local p = makeCore(baseTh * 0.35, Enum.Material.Neon, 0.08, tracerColor)
        p.Size = Vector3.new(baseTh * 2.2, baseTh * 0.25, dist)
        p.CFrame = cf
        parts[#parts+1] = p
        local g = makeCore(baseTh * 0.9, Enum.Material.Neon, 0.65, tracerColor)
        g.Size = Vector3.new(baseTh * 3.2, baseTh * 0.45, dist)
        g.CFrame = cf
