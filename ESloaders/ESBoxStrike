function _ECLIPSE_HUBMobileAimAt(worldPos, alpha)
    if typeof(worldPos) ~= "Vector3" then return end
    local cam = workspace.CurrentCamera; if not cam then return end
    alpha = tonumber(alpha) or 1
    if alpha <= 0 then return end

    local now = tick()
    local last = _G.__ECLIPSE_HUBMobileAimTick or (now - 1/60)
    _G.__ECLIPSE_HUBMobileAimTick = now
    local dt = math.clamp(now - last, 1/240, 1/30)
    alpha = math.clamp(alpha, 0, 0.34)
    alpha = math.min(alpha, 1 - math.exp(-dt * 18))
    local pos = cam.CFrame.Position
    local dir = worldPos - pos
    if dir.Magnitude < 1e-3 then return end

    local target = CFrame.lookAt(pos, worldPos, Vector3.new(0, 1, 0))

    local curRot = cam.CFrame - pos
    local tgtRot = target - pos
    local newRot = curRot:Lerp(tgtRot, alpha)

    if newRot.UpVector.Y < 0.05 then newRot = tgtRot end
    cam.CFrame = CFrame.new(pos) * (newRot - newRot.Position)
end

