task.spawn(function()
    local lastShot = 0
    while true do
        task.wait(0.004) -- faster scan
        pcall(function()
            if not (Toggles.Ragebot and Toggles.Ragebot.Value) then return end
            if Toggles.GlobalEnabled and Toggles.GlobalEnabled.Value == false then return end
            if not Weapon or not pcall(function() return Weapon.IsEquipped end) then
                if getEquipped then Weapon = getEquipped() end
            end
            if not Weapon or not Weapon.IsEquipped then return end
            local rounds = pcall(function() return Weapon.Rounds end) and Weapon.Rounds or 0
            if rounds <= 0 then return end

            local cam = Workspace.CurrentCamera
            if not cam then return end
            local origin = cam.CFrame.Position
            local hitName = Options.RageHitPart and Options.RageHitPart.Value or "Head"
            local maxPen = Options.RageAutowallPen and Options.RageAutowallPen.Value or 8
            local useAW = Toggles.RageAutowall and Toggles.RageAutowall.Value
            local bestPart, bestScore = nil, -1

            -- scan all enemies in Characters (map-wide, realtime)
            local folder = Workspace:FindFirstChild("Characters")
            local candidates = {}
            if folder then
                for _, m in ipairs(folder:GetChildren()) do
                    if m:IsA("Model") and m ~= LP.Character then
                        candidates[#candidates+1] = m
                    end
                end
            else
                for _, plr in ipairs(Players:GetPlayers()) do
                    if plr ~= LP and plr.Character then candidates[#candidates+1] = plr.Character end
                end
            end

            for _, char in ipairs(candidates) do
                if char:GetAttribute("Dead") or char:GetAttribute("Invincible") then
                    -- skip
                else
                    local hum = char:FindFirstChildOfClass("Humanoid")
                    if not (hum and hum.Health <= 0) then
                        local teamOk = true
                        if Toggles.RagebotTeamCheck and Toggles.RagebotTeamCheck.Value then
                            local plr = Players:GetPlayerFromCharacter(char)
                            if plr and get_player_team then
                                local a, b = get_player_team(LP), get_player_team(plr)
                                if a ~= nil and b ~= nil and a == b then teamOk = false end
                            end
                        end
                        if teamOk then
                            local part = char:FindFirstChild(hitName) or char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
                            if part then
                                local aimPos = part.Position
                                -- extrapolation
                                pcall(function()
                                    if _G.ECLIPSE_Extrapolate and Toggles.ExtrapolationEnabled and Toggles.ExtrapolationEnabled.Value then
                                        local vel = part.AssemblyLinearVelocity or Vector3.zero
                                        local ping = 30
                                        pcall(function() ping = math.floor(LP:GetNetworkPing() * 1000) end)
                                        aimPos = _G.ECLIPSE_Extrapolate(aimPos, vel, ping)
                                    end
                                    if _G.ECLIPSE_BacktrackPos and Toggles.BacktrackEnabled and Toggles.BacktrackEnabled.Value then
                                        local plr = Players:GetPlayerFromCharacter(char)
                                        local bp = plr and _G.ECLIPSE_BacktrackPos(plr)
                                        if bp then aimPos = bp end
                                    end
                                end)
                                local canHit = false
                                if useAW and GetPenetrationStats then
                                    local dir = (aimPos - origin)
                                    if dir.Magnitude > 0.5 then
                                        local stats = GetPenetrationStats(origin, dir.Unit, maxPen, {LP.Character, cam}, char)
                                        canHit = stats and stats.Success == true
                                    end
                                elseif Toggles.RagebotWallCheck and Toggles.RagebotWallCheck.Value then
                                    canHit = isVisible and isVisible(part) or false
                                else
                                    canHit = true
                                end
                                if Toggles.RagebotVisibleCheck and Toggles.RagebotVisibleCheck.Value then
                                    local _, onScreen = cam:WorldToViewportPoint(aimPos)
                                    if not onScreen then canHit = false end
                                end
                                if canHit then
                                    local dist = (aimPos - origin).Magnitude
                                    local score = 10000 - dist
                                    if score > bestScore then
                                        bestScore = score
                                        bestPart = part
                                        RageTarget = part
                                    end
                                end
                            end
                        end
                    end
                end
            end

            if not bestPart then return end
            local delay = Options.RageDelay and Options.RageDelay.Value or 0.01
            local now = tick()
            if now - lastShot < delay then return end
            lastShot = now
            pcall(function() Weapon:shoot() end)
        end)
    end
end)
