            PV.chams[part] = nil
        end
    end

    local function updateChams()
        if PV.hl then pcall(function() PV.hl:Destroy() end); PV.hl = nil end
        if not (Config.ESP.Chams and rig) then clearPreviewChams() return end

        local col = Config.ESP.ChamsColor or Color3.fromRGB(255, 60, 60)
        if Config.ESP.VisibleCheck then
            col = Config.ESP.VisibleChamsColor or col
        end
        local tr = math.clamp(1 - 0.65 * (Config.ESP.ChamsIntensity or 1), 0, 0.9)

        local seen = {}
        for _, part in ipairs(rig:GetDescendants()) do
            if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart"
                and not (part.Parent and part.Parent:IsA("Accessory"))
                and part.Transparency < 1 then
                seen[part] = true
                local shell = PV.chams[part]
                if not shell or not shell.Parent then
                    shell = Instance.new("Part")
                    shell.Name = "ECLIPSE_PVChams"
                    shell.Anchored = true
                    shell.CanCollide = false
                    shell.CanQuery = false
                    shell.CanTouch = false
                    shell.CastShadow = false
                    shell.Material = Enum.Material.Neon
                    shell.Parent = wm
                    PV.chams[part] = shell
                end
                pcall(function()
                    shell.Size = part.Size * 1.03
                    shell.CFrame = part.CFrame
                    shell.Color = col
                    shell.Transparency = tr
                end)
