    _G.ECLIPSE_HUBImpactFire = function(hitPart, hitPos)
        if not (Config and Config.Visuals and Config.Visuals.BulletImpact) then return end
        if typeof(hitPos) ~= "Vector3" then return end
        local now = os.clock()
        if now - IMP.lastAt < 0.02 then return end
        IMP.lastAt = now
        local col = Config.Visuals.BulletImpactColor
        if typeof(col) ~= "Color3" then col = Color3.fromRGB(255,80,80) end
        local life = tonumber(Config.Visuals.BulletImpactDuration) or 0.6
        life = math.clamp(life, 0.15, 2.0)
        local style = tostring(Config.Visuals.BulletImpactStyle or "Crosshair")
        pcall(function()
            if style == "Colored" then
                local isEnemy = _isEnemyPart(hitPart)
                if isEnemy then
                    _spawnColored(hitPart, col, life)
                else
                    _spawnCrosshair(hitPos, col, life)
                end
            elseif style == "Square" then
                _spawnSquare(hitPos, col, life)
            else
                _spawnCrosshair(hitPos, col, life)
            end

            if style ~= "Square" then _spawnSquare(hitPos, col, life) end
        end)
    end

