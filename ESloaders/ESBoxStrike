    local function _tpDisable()
        Config.Misc.ThirdPerson = false
        if _tpConn then pcall(function() _tpConn:Disconnect() end); _tpConn = nil end
        pcall(_clearMirror)
        pcall(_clearSelfDummy)
        pcall(function()
            LocalPlayer.CameraMaxZoomDistance = _tpOldMax  or 0.5
            LocalPlayer.CameraMinZoomDistance = _tpOldMin  or 0.5
            LocalPlayer.CameraMode            = _tpOldMode or Enum.CameraMode.Classic
            local cam = workspace.CurrentCamera
            if cam then
                cam.CameraType = _tpOldType or Enum.CameraType.Custom
                cam.CameraSubject = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") or cam.CameraSubject
            end
        end)
        _tpOldMax, _tpOldMin, _tpOldMode, _tpOldType = nil, nil, nil, nil
        pcall(_restoreVM)
        pcall(_showLocalChar)
        task.delay(0.1, function() pcall(_restoreVM); pcall(_showLocalChar) end)
        task.delay(0.4, function() pcall(_restoreVM); pcall(_showLocalChar) end)
