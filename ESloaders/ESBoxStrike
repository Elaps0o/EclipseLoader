function GetCharacter(plr)
    if not plr then return nil end
    local function usable(c)
        if not (c and c.Parent) then return false end
        local root = c:FindFirstChild("HumanoidRootPart")
        local head = c:FindFirstChild("Head")
        local hum  = c:FindFirstChildOfClass("Humanoid")
        if not (root and head and hum and hum.Health > 0) then return false end
        local okState, st = pcall(function() return hum:GetState() end)
        if okState and st == Enum.HumanoidStateType.Dead then return false end
        return true
    end
    local char = plr.Character
    if usable(char) then
        return char
    end

    local chars = Characters or Workspace:FindFirstChild("Characters")
    if chars then
        Characters = chars
        local direct = chars:FindFirstChild(plr.Name)
        if usable(direct) then return direct end
        for _, folder in ipairs(chars:GetChildren()) do
            local found = folder:FindFirstChild(plr.Name)
            if usable(found) then return found end
        end
    end
    return nil
end
