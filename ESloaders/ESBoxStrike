    local function findBomb()
        for _, tag in ipairs({"Bomb", "C4", "PlantedBomb"}) do
            for _, obj in ipairs(Workspace:GetDescendants()) do
                if obj.Name == tag or (obj:IsA("Model") and (obj:GetAttribute("BombPlanted") or obj:GetAttribute("Weapon") == "C4")) then
                    return obj
                end
            end
        end
        local ok, tagged = pcall(function() return game:GetService("CollectionService"):GetTagged("Bomb") end)
        if ok and tagged and tagged[1] then return tagged[1] end
        local debris = Workspace:FindFirstChild("Debris")
        if debris then
            for _, m in ipairs(debris:GetChildren()) do
                if m:IsA("Model") and m:GetAttribute("BombPlanted") then return m end
            end
        end
        return nil
    end
