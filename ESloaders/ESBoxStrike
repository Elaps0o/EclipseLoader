Config.Grenade.ZoneESP    = Config.Grenade.ZoneESP    or false
Config.Grenade.ZoneColor  = Config.Grenade.ZoneColor  or Color3.fromRGB(255, 255, 255)
do

    local _GZ = { Zones = {}, Hooked = false }

    local function _gzColor()
        return Config.Grenade.ZoneColor or Color3.fromRGB(255, 255, 255)
    end

    local function _boundsFor(folder)
        local minY, sumX, sumZ, n = math.huge, 0, 0, 0
        local minX, maxX, minZ, maxZ = math.huge, -math.huge, math.huge, -math.huge
        for _, p in ipairs(folder:GetDescendants()) do
            if p:IsA("BasePart") then
                local pos = p.Position
                sumX = sumX + pos.X; sumZ = sumZ + pos.Z; n = n + 1
                if pos.Y < minY then minY = pos.Y end
                if pos.X < minX then minX = pos.X end
                if pos.X > maxX then maxX = pos.X end
                if pos.Z < minZ then minZ = pos.Z end
                if pos.Z > maxZ then maxZ = pos.Z end
            end
        end
        if n == 0 then return nil end
        local cx, cz = sumX / n, sumZ / n
        local rx = math.max(maxX - cx, cx - minX)
        local rz = math.max(maxZ - cz, cz - minZ)
        local radius = math.max(6, math.max(rx, rz) + 2)
        return Vector3.new(cx, minY, cz), radius
    end

    local function _makeZone(folder)
        if _GZ.Zones[folder] then return end
        local center, radius = _boundsFor(folder)
        if not center then return end
        local isFire = folder.Name:find("VoxelFire") ~= nil
        local life   = isFire and 7 or 18

        for other, z in pairs(_GZ.Zones) do
            if other.Parent and z.center and (z.center - center).Magnitude <= 12 then
                z.linked = z.linked or {}
                z.linked[folder] = true
                z.life  = math.max(z.life, life)
                _GZ.Zones[folder] = { proxy = other }
                return
            end
        end

        local col = _gzColor()
        if isFire then
            col = (Config.ESP and Config.ESP.MolotovColor) or col
        else
            col = (Config.ESP and Config.ESP.SmokeColor) or col
        end

        local anchor = Instance.new("Part")
        anchor.Name = "BS_ZoneAnchor"
        anchor.Anchored = true; anchor.CanCollide = false; anchor.CanQuery = false
        anchor.CanTouch = false; anchor.Transparency = 1; anchor.CastShadow = false
        anchor.Size = Vector3.new(0.1, 0.1, 0.1)
        anchor.CFrame = CFrame.lookAt(center + Vector3.new(0, 0.06, 0), center + Vector3.new(0, 1.06, 0))
        anchor.Parent = Workspace

        local ring = Instance.new("CylinderHandleAdornment")
        ring.Name = "BS_ZoneRing"
        ring.Adornee = anchor
        ring.AlwaysOnTop = false
        ring.ZIndex = 0
        ring.Color3 = col
        ring.Transparency = 0.05
        ring.Height = 0.03
        ring.Radius = radius
        ring.InnerRadius = math.max(0.1, radius - 0.10)
        ring.CFrame = CFrame.new()
        ring.Parent = anchor

        local glow = Instance.new("CylinderHandleAdornment")
        glow.Name = "BS_ZoneGlow"
        glow.Adornee = anchor
        glow.AlwaysOnTop = false
        glow.ZIndex = 0
        glow.Color3 = col
        glow.Transparency = 0.65
        glow.Height = 0.02
        glow.Radius = radius + 0.18
        glow.InnerRadius = math.max(0.1, radius - 0.02)
        glow.CFrame = CFrame.new()
        glow.Parent = anchor

        local txtAnchor = Instance.new("Part")
        txtAnchor.Name = "BS_ZoneTxtAnchor"
        txtAnchor.Anchored = true; txtAnchor.CanCollide = false; txtAnchor.CanQuery = false
        txtAnchor.CanTouch = false; txtAnchor.Transparency = 1; txtAnchor.CastShadow = false
        txtAnchor.Size = Vector3.new(0.1, 0.1, 0.1)
        txtAnchor.CFrame = CFrame.new(center + Vector3.new(0, 0.9, 0))
        txtAnchor.Parent = Workspace

        local gui = Instance.new("BillboardGui")
        gui.Name = "BS_ZoneTimer"
        gui.Adornee = txtAnchor
        gui.Size = UDim2.fromOffset(110, 30)
        gui.AlwaysOnTop = true
        gui.LightInfluence = 0
        gui.MaxDistance = 350
        gui.Parent = txtAnchor

        local txt = Instance.new("TextLabel")
        txt.BackgroundTransparency = 1
        txt.Size = UDim2.fromScale(1, 1)
        txt.Font = Enum.Font.Code
        txt.TextSize = 22
        txt.TextScaled = false
        txt.TextColor3 = col
        txt.TextStrokeTransparency = 0.35
        txt.TextStrokeColor3 = Color3.new(0, 0, 0)
        txt.Text = string.format("%.1fs", life)
        txt.Parent = gui

        _GZ.Zones[folder] = {
            anchor = anchor, txtAnchor = txtAnchor, ring = ring, glow = glow,
            gui = gui, txt = txt, center = center, radius = radius,
            start = tick(), life = life, linked = {},
        }
    end

    local function _gzAttachVoxel(child)
        if not child or not child.Parent then return end
        local n = child.Name
        if not (n:find("VoxelFire") or n:find("VoxelSmoke")) then return end

        task.defer(function()
            if child.Parent and Config.Grenade.ZoneESP then _makeZone(child) end
        end)
    end

    local function _gzClear()
        for _, z in pairs(_GZ.Zones) do
            pcall(function() if z.anchor    then z.anchor:Destroy()    end end)
            pcall(function() if z.txtAnchor then z.txtAnchor:Destroy() end end)
        end
        table.clear(_GZ.Zones)
    end

    local function _gzScanDebris(folder)
        if not folder then return end
        for _, c in ipairs(folder:GetChildren()) do _gzAttachVoxel(c) end
        folder.ChildAdded:Connect(function(c)
            if Config.Grenade.ZoneESP then _gzAttachVoxel(c) end
        end)
    end

    local function _gzEnable()
        if _GZ.Hooked then return end
        _GZ.Hooked = true
        local wsDebris = workspace:FindFirstChild("Debris")
        if wsDebris then _gzScanDebris(wsDebris) end
        workspace.ChildAdded:Connect(function(c)
            if not Config.Grenade.ZoneESP then return end
            if c.Name == "Debris" then _gzScanDebris(c) else _gzAttachVoxel(c) end
        end)
        for _, c in ipairs(workspace:GetChildren()) do _gzAttachVoxel(c) end
    end

    task.spawn(function()
        local RunS = game:GetService("RunService")
        while true do
            RunS.RenderStepped:Wait()
            if Config.Grenade and Config.Grenade.ZoneESP then
                for folder, z in pairs(_GZ.Zones) do
                    if z.proxy then
                        if not folder.Parent then _GZ.Zones[folder] = nil end
                    elseif not folder.Parent then
                        pcall(function() if z.anchor    then z.anchor:Destroy()    end end)
                        pcall(function() if z.txtAnchor then z.txtAnchor:Destroy() end end)
                        _GZ.Zones[folder] = nil
                    else
                        local elapsed = tick() - z.start
                        local remain  = math.max(0, z.life - elapsed)
                        z.txt.Text = string.format("%.1fs", remain)

                        local fadeIn  = math.clamp(elapsed / 0.35, 0, 1)
                        local fadeOut = math.clamp(remain  / 1.20, 0, 1)
                        local a = math.min(fadeIn, fadeOut)
                        local pulse = 1 + math.sin(elapsed * 3.2) * 0.012
                        if z.ring then
                            z.ring.Transparency  = 0.05 + (1 - a) * 0.95
                            z.ring.Radius        = z.radius * pulse
                            z.ring.InnerRadius   = math.max(0.1, z.radius * pulse - 0.10)
                        end
                        if z.glow then
                            z.glow.Transparency = 0.65 + (1 - a) * 0.35
                            z.glow.Radius       = z.radius * pulse + 0.18
                            z.glow.InnerRadius  = math.max(0.1, z.radius * pulse - 0.02)
                        end
                        z.txt.TextTransparency = 1 - a
                    end
                end
            end
        end
    end)

    WorldEspGB:AddToggle("Grenade_Zone", { Text = "GRENADE ZONE ESP", Default = Config.Grenade.ZoneESP,
        Callback = function(v)
            Config.Grenade.ZoneESP = v
            if v then _gzEnable() else _gzClear() end
        end })
        :AddColorPicker("Grenade_ZoneCol", { Default = Config.Grenade.ZoneColor, Title = "Zone color",
            Callback = function(c)
                Config.Grenade.ZoneColor = c
                for _, z in pairs(_GZ.Zones) do
                    pcall(function() if z.ring then z.ring.Color3 = c end end)
                    pcall(function() if z.glow then z.glow.Color3 = c end end)
                    pcall(function() if z.txt  then z.txt.TextColor3 = c end end)
                end
            end })
end

