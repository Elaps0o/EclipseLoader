        if _MV.freezeHum ~= hum then
            _MV.freezeHum = hum
            _MV.freezeOrig = {
                WalkSpeed  = (tonumber(hum.WalkSpeed)  or 16) > 0 and hum.WalkSpeed  or 16,
                JumpPower  = (tonumber(hum.JumpPower)  or 50) > 0 and hum.JumpPower  or 50,
                JumpHeight = (tonumber(hum.JumpHeight) or 7.2) > 0 and hum.JumpHeight or 7.2,
