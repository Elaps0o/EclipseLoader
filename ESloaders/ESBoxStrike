        for _, obj in ipairs(snapshot) do
            if type(obj) == "table" and type(obj.SetOpen) == "function" then
                pcall(function() obj:SetOpen(false) end)
            else

                pcall(function()
                    local inst = nil
                    if typeof(obj) == "Instance" then
