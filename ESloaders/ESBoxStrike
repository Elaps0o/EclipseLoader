    state.hitOutlines = state.hitOutlines or setmetatable({}, {__mode = "k"})

    local function library()
        return G.Library or G.eclipseUiLibrary
    end

    local function flag(name, default)
        local l = library()
        local flags = l and l.Flags
        if type(flags) == "table" and flags[name] ~= nil then
            return flags[name]
        end
        return default
    end

    local function req(path)
        local node = ReplicatedStorage
        for part in string.gmatch(path, "[^%.]+") do
            node = node and node:FindFirstChild(part)
            if not node then return nil end
        end
        local ok, result = pcall(function()
            return require(node)
        end)
        return ok and result or nil
    end

    local Bullet = req("Components.Weapon.Classes.Bullet")
    local GetRayIgnore = req("Components.Common.GetRayIgnore")

    -- Eclipse visibility bridge (new game visibility architecture).
    -- Priority: CharacterResolver / presentation ownership -> PVSRuntime ->
    -- runtime occlusion proof (raycast). No direct Players.Character enumeration
    -- is used by the Eclipse combat/redirect layer.
    local CharacterResolver = req("Components.Common.CharacterResolver")
    local PVSRuntime = req("Visibility.PVSRuntime")
    local VisibilityDescriptor = req("Components.Common.CharacterPresentationDescriptor")

    local Visibility = G.__eclipse_visibility_bridge or {}
    G.__eclipse_visibility_bridge = Visibility
    Visibility.Version = "2.0-PVS-CharacterResolver"
    Visibility.Cache = Visibility.Cache or setmetatable({}, {__mode = "k"})
    Visibility.PresentationCache = Visibility.PresentationCache or {}
    Visibility.LastError = nil

    local function safeCall(fn, ...)
        if type(fn) ~= "function" then return false, nil end
        return pcall(fn, ...)
    end

    local function resolvePlayerModel(player)
        if not player or player == LocalPlayer then return nil end

        local cached = Visibility.Cache[player]
        if cached and cached.Parent then
            local visible = VisibilityDescriptor and VisibilityDescriptor.Attributes
            if visible then
                local owner = cached:GetAttribute(VisibilityDescriptor.OwnerUserIdAttribute)
                if owner == nil or tonumber(owner) == player.UserId then
                    local hidden = cached:GetAttribute(VisibilityDescriptor.VisibleAttribute)
                    if hidden ~= false then return cached end
                end
            else
                return cached
            end
        end

        -- New resolver path. This is the supported character entry point in the
        -- updated client and may resolve a presentation-backed character.
        if CharacterResolver then
            local ok, character = safeCall(CharacterResolver.getPlayerCharacter, player)
            if ok and typeof(character) == "Instance" and character.Parent then
                Visibility.Cache[player] = character
                return character
            end
        end

        -- Presentation fallback: resolve by PresentationOwnerUserId instead of
        -- walking Player.Character. Cache the result for the short render window.
        local uid = tostring(player.UserId)
        local cachedPresentation = Visibility.PresentationCache[uid]
        if cachedPresentation and cachedPresentation.Parent then
            local visible = cachedPresentation:GetAttribute("ClientCharacterPresentationVisible")
            if visible ~= false then
                Visibility.Cache[player] = cachedPresentation
                return cachedPresentation
            end
        end

        local ownerAttribute = (VisibilityDescriptor and VisibilityDescriptor.OwnerUserIdAttribute)
            or "PresentationOwnerUserId"
        local visibleAttribute = (VisibilityDescriptor and VisibilityDescriptor.VisibleAttribute)
            or "ClientCharacterPresentationVisible"

        -- Presentation models are normally under the client-owned presentation
        -- container. Limit the search to models carrying the new owner attribute.
        for _, instance in ipairs(Workspace:GetDescendants()) do
            if instance:IsA("Model") then
                local owner = instance:GetAttribute(ownerAttribute)
                if owner ~= nil and tonumber(owner) == player.UserId then
                    if instance:GetAttribute(visibleAttribute) ~= false then
                        Visibility.PresentationCache[uid] = instance
                        Visibility.Cache[player] = instance
                        return instance
                    end
                end
            end
        end

        return nil
    end

    local function resolvePart(model, preferred)
        if not model then return nil end
        if preferred then
            local part = model:FindFirstChild(preferred, true)
            if part and part:IsA("BasePart") then return part end
        end
        for _, name in ipairs({"HumanoidRootPart", "Head", "UpperTorso", "Torso", "LowerTorso"}) do
            local part = model:FindFirstChild(name, true)
            if part and part:IsA("BasePart") then return part end
        end
        return model.PrimaryPart
    end

    local function localModel()
        if CharacterResolver then
            local ok, model = safeCall(CharacterResolver.getLocalCharacter)
            if ok and typeof(model) == "Instance" and model.Parent then
                return model
            end
        end
        return nil
    end

    local function localPosition()
        local model = localModel()
        local root = resolvePart(model, "HumanoidRootPart")
        return root and root.Position or nil
    end

    local function makePVS()
        if Visibility.PVS then return Visibility.PVS end
        if not PVSRuntime then return nil end
        local mapRoot = Workspace:FindFirstChild("Map")
        local storageRoot = ReplicatedStorage:FindFirstChild("Visibility") or ReplicatedStorage
        local attempts = {
            function() return PVSRuntime.new(mapRoot, storageRoot) end,
            function() return PVSRuntime.new(mapRoot) end,
            function() return PVSRuntime.new() end,
        }
        for _, factory in ipairs(attempts) do
            local ok, runtime = pcall(factory)
            if ok and type(runtime) == "table" then
                Visibility.PVS = runtime
                pcall(function()
                    if type(runtime.Refresh) == "function" then runtime:Refresh() end
                end)
                return runtime
            end
