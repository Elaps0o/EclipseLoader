local PresenceUsers = {}
local presenceDirty = true
local presenceLastSignature = ""

function markPresence(userId, on)
    if userId and userId ~= LocalPlayer.UserId then
        local nextValue = on and true or nil
        if PresenceUsers[userId] ~= nextValue then
            PresenceUsers[userId] = nextValue
            presenceDirty = true
        end
    end
end

local function _presenceHeaders()
    return {
        ["Content-Type"]   = "application/json",
        ["x-EclipseHub-key"] = EclipseHub.PresenceKey,
        ["x-api-key"]     = EclipseHub.PresenceKey,
    }
end

local _presenceInflight = false
local function _presenceSyncOnce(action)
    if not httpRequest then return end
    if _presenceInflight then return end
    _presenceInflight = true
    local body = HttpService:JSONEncode({
        action     = action or "heartbeat",
        placeId    = tostring(game.PlaceId),
        jobId      = tostring(game.JobId or "solo"),
        serverId   = tostring(game.JobId or "solo"),
        playerId   = tostring(LocalPlayer.UserId),
        playerName = tostring(LocalPlayer.Name or ""),
    })
    local ok, res = pcall(httpRequest, {
        Url = EclipseHub.PresenceHTTP,
        Method = "POST",
        Headers = _presenceHeaders(),
        Body = body,
    })
    if not ok or not res or not res.Body then _presenceInflight = false; return end
    local ok2, data = pcall(function() return HttpService:JSONDecode(res.Body) end)
    if not ok2 or type(data) ~= "table" or type(data.players) ~= "table" then _presenceInflight = false; return end
    local seen = {}
    local sig = {}
    for _, pl in ipairs(data.players) do
        local uid = tonumber(pl.playerId)
        if uid and uid ~= LocalPlayer.UserId then
            seen[uid] = true
            sig[#sig + 1] = tostring(uid)
            markPresence(uid, true)
        end
    end
    table.sort(sig)
    local nextSignature = table.concat(sig, ",")
    if nextSignature ~= presenceLastSignature then
        presenceLastSignature = nextSignature
        presenceDirty = true
    end
    for uid in pairs(PresenceUsers) do
        if not seen[uid] then markPresence(uid, false) end
    end
    _presenceInflight = false
end

local function _presenceLoop()
    task.spawn(function()
        pcall(_presenceSyncOnce, "join")
        if not getgenv().EclipseHub.connectedFired then
            getgenv().EclipseHub.connectedFired = true
            pcall(function()
                Library:Notify({
                    Title = "EclipseHub",
                    Description = "<b>The connection has been established successfully.</b>",
                    Time = 5,
                })
            end)
            sendWebhook("connected")
        end
        while scriptRunning do
            pcall(_presenceSyncOnce, "heartbeat")
            local count = 0
            pcall(function() count = #Players:GetPlayers() end)
            local base = count > 12 and 12 or 8
            task.wait(base + math.random() * 2)
        end
        pcall(_presenceSyncOnce, "leave")
    end)
end

