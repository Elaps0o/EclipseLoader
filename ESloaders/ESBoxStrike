    local function _localShot()
        if not (Config and Config.Visuals and Config.Visuals.BulletImpact) then return end
        local ch = LP and LP.Character
        local hum = ch and ch:FindFirstChildOfClass("Humanoid")
        if not (hum and hum.Health > 0) then return end
        if Library and (Library._guiOpen or Library.Toggled) then return end
        if UIS:GetFocusedTextBox() then return end
        local now = os.clock()
        if now - lastLocal < 0.05 then return end
        lastLocal = now
        Camera = Workspace.CurrentCamera or Camera
        if not Camera then return end
        local origin = Camera.CFrame.Position
        local dir
        pcall(function()
            local ml = UIS:GetMouseLocation()
            local ray = Camera:ViewportPointToRay(ml.X, ml.Y)
            origin = ray.Origin; dir = ray.Direction
        end)
        if typeof(dir) ~= "Vector3" or dir.Magnitude <= 0.001 then dir = Camera.CFrame.LookVector end
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Blacklist
        params.FilterDescendantsInstances = { ch }
        params.IgnoreWater = true
        local ok, result = pcall(function() return Workspace:Raycast(origin, dir.Unit * 900, params) end)
        if ok and result and result.Position then
            _G.ECLIPSE_HUBImpactFire(result.Instance, result.Position)
        end
    end
    UIS.InputBegan:Connect(function(input, gp)
