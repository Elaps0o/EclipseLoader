                        end
                    end
                end
            end)
        end
    end)
end

-- ============================================================
-- HUD OVERRIDE (skin / knife names + star on hotbar)
-- Same idea as ESBoxStrike: rewrite WeaponName labels in HUD
-- ============================================================
do
    local STAR = "\226\152\133 " -- ★
    local HUDBox = Tabs.SkinChanger:AddLeftGroupbox("HUD", "monitor")
    HUDBox:AddToggle("HUDSkinOverride", {
        Text = "HUD SKIN / KNIFE NAMES",
        Default = true,
    })
    HUDBox:AddToggle("HUDShowStar", {
        Text = "SHOW ★ ON CUSTOM KNIFE",
        Default = true,
    })
    HUDBox:AddToggle("HUDShowSkinSuffix", {
        Text = "SHOW SKIN AFTER NAME",
        Default = true,
    })

    local function prettySkin(raw)
        if type(raw) ~= "string" or raw == "" then return "" end
        local n = raw:gsub("_", " "):gsub("%-", " "):lower():gsub("^%s+", ""):gsub("%s+$", "")
        if n == "stock" or n == "vanilla" or n == "default" or n == "none"
            or n == "original" or n == "no skin" or n == "sem skin" then
            return ""
        end
        if raw:find("NEBULLA", 1, true) then return "Doppler" end
        if raw:match("_%d+$") then
            local base = raw:gsub("_%d+$", "")
            if base == "" or base:find("NEBULLA", 1, true) then return "Doppler" end
            return base:gsub("_", " ")
        end
        return raw:gsub("_", " ")
    end

    local function isKnifeName(s)
        if type(s) ~= "string" then return false end
        local low = s:lower()
        return low:find("knife", 1, true) or low:find("bayonet", 1, true)
            or low:find("karambit", 1, true) or low:find("butterfly", 1, true)
            or low == "knife" or low == "t knife" or low == "ct knife"
            or low:find("stiletto", 1, true) or low:find("skeleton", 1, true)
    end

    local function desiredKnifeText()
        if not (Config and Config.KnifeChanger and Config.KnifeChanger.Enabled) then
            return nil
        end
        local model = Config.KnifeChanger.Model or "Knife"
        if model == "T Knife" or model == "CT Knife" then model = "Knife" end
        local skin = Config.SkinChanger and Config.SkinChanger.Skins and Config.SkinChanger.Skins[Config.KnifeChanger.Model]
        local pretty = prettySkin(skin or "")
        local star = (Toggles.HUDShowStar and Toggles.HUDShowStar.Value) and STAR or ""
        if Toggles.HUDShowSkinSuffix and Toggles.HUDShowSkinSuffix.Value and pretty ~= "" then
            return star .. model .. " | " .. pretty
        end
        return star .. model
    end

    local function desiredWeaponText(rawName)
        if not rawName or rawName == "" then return nil end
        if isKnifeName(rawName) then return desiredKnifeText() end
        if not (Config and Config.SkinChanger and Config.SkinChanger.Enabled) then
            return nil
        end
        local skin = Config.SkinChanger.Skins and Config.SkinChanger.Skins[rawName]
        local pretty = prettySkin(skin or "")
        if pretty == "" then return nil end
        if Toggles.HUDShowSkinSuffix and Toggles.HUDShowSkinSuffix.Value then
            return rawName .. " | " .. pretty
        end
        return nil
    end

    local OrigHUDText = {} -- [TextLabel] = original text

    local function patchHUD()
        if not (Toggles.HUDSkinOverride and Toggles.HUDSkinOverride.Value) then
            for lbl, orig in pairs(OrigHUDText) do
                if lbl and lbl.Parent then
                    pcall(function() lbl.Text = orig end)
                end
            end
            return
        end
        local pg = LP:FindFirstChild("PlayerGui")
        if not pg then return end
        for _, gui in ipairs(pg:GetDescendants()) do
            if gui:IsA("TextLabel") and (gui.Name == "WeaponName" or gui.Name == "WeaponNameLabel") then
                if not OrigHUDText[gui] then
                    OrigHUDText[gui] = gui.Text
                end
                local raw = OrigHUDText[gui] or gui.Text
                -- strip previous star / skin suffix so we re-apply cleanly
                local clean = raw:gsub("^%s*" .. STAR, ""):gsub("%s*|%s*.+$", ""):gsub("^%s+", ""):gsub("%s+$", "")
                if clean == "" then clean = raw end
                local desired = desiredWeaponText(clean)
                if not desired and isKnifeName(clean) then
                    desired = desiredKnifeText()
                end
                if desired and gui.Text ~= desired then
                    pcall(function() gui.Text = desired end)
                end
            end
        end
    end

    RunService.Heartbeat:Connect(function()
        pcall(patchHUD)
    end)

    -- also watch inventory equip events if available
    pcall(function()
        local IC = require(ReplicatedStorage.Controllers.InventoryController)
        if IC.OnInventoryItemEquipped then
            IC.OnInventoryItemEquipped:Connect(function()
                task.defer(function()
                    pcall(patchHUD)
                end)
            end)
        end
    end)
end

