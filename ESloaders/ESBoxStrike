function updateESP()
    local wantOn = Config.GlobalEnable and Config.ESP.Enabled and IsAlive()
    if wantOn ~= _ESP_ANIM.on then
        _ESP_ANIM.on = wantOn
        _ESP_ANIM.t0 = tick()
    end
    local animScale = _espAnimScale()
    local espOn = wantOn or animScale > 0.001
    local myChar = GetCharacter(LocalPlayer)
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not espOn or not myRoot then
        for _, d in pairs(ESPObjects) do d._wantVisible = false end
        _espFadeTick()
        if TargetLine then TargetLine.Visible = false end
        return
    end
    local espInterval = (ES152.Load and ES152.Load > 0.55) and 0.05 or ((ES152.Load and ES152.Load > 0.25) and 0.033 or 0)
    if espInterval > 0 and not ES152.tick("ESP.scan", espInterval) then

        _espFadeTick()
        return
    end

    local closest, closestDist = nil, math.huge
    local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    local seen = {}

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            seen[plr] = true
            local info = _espProcessPlayer(plr, myRoot, center)
            if info and info.aimDist < closestDist then
                closestDist = info.aimDist
                closest = info
            end
        end
    end

