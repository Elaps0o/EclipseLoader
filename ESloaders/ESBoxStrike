            or low:find("talon", 1, true) or low:find("stiletto", 1, true)
            or low:find("shadow daggers", 1, true) or low:find("navaja", 1, true)
        if isKnife then return _MIRROR_OFFSET_KNIFE end
        local ov = _MIRROR_OFFSET_OVERRIDES[n]
        if ov then return ov end
        local cat = (WEAPON_CATEGORY and WEAPON_CATEGORY[n]) or nil
        if cat == "Pistols"  then return _MIRROR_OFFSET_PISTOL end
        if cat == "Snipers"  then return _MIRROR_OFFSET_SNIPER end
        if cat == "SMGs"     then return _MIRROR_OFFSET_SMG end
        if cat == "Shotguns" then return _MIRROR_OFFSET_SHOTGUN end
        if cat == "Rifles"   then return _MIRROR_OFFSET_LONG end
        if cat == "LMGs" or cat == "Heavy" then return _MIRROR_OFFSET_HEAVY end
        if low:find("awp") or low:find("scar%-20") or low:find("scar 20")
            or low:find("g3sg1") or low:find("ssg") or low:find("ssg08")
            or low:find("sniper") or low:find("scout") then
            return _MIRROR_OFFSET_SNIPER
        end
        if low:find("nova") or low:find("xm1014") or low:find("mag%-7")
            or low:find("sawed") then
            return _MIRROR_OFFSET_SHOTGUN
        end
        if low:find("negev") or low:find("m249") then
            return _MIRROR_OFFSET_HEAVY
        end
        if low:find("mp5") or low:find("mp7") or low:find("mp9")
            or low:find("mac%-10") or low:find("mac10") or low:find("ump")
            or low:find("p90") or low:find("pp%-bizon") or low:find("bizon") then
            return _MIRROR_OFFSET_SMG
        end
        if low:find("deagle") or low:find("glock") or low:find("usp")
            or low:find("p250") or low:find("p2000") or low:find("cz75")
            or low:find("five") or low:find("tec") or low:find("dual")
            or low:find("revolver") or low:find("r8") then
            return _MIRROR_OFFSET_PISTOL
        end
        return _MIRROR_OFFSET_LONG
    end

    local function _isMirrorInstance(inst)
        if not inst then return false end
        if inst == _mirrorClone then return true end
        local n = tostring(inst.Name or "")
        return n == "_EclipseTPMirror" or n:sub(1, 8) == "_Eclipse"
    end

    local function _mirrorScaleFor(weaponName)
        local n = tostring(weaponName or "")
        local low = n:lower()
        if (KNIVES and KNIVES[n]) or low:find("knife", 1, true)
            or low:find("bayonet", 1, true) or low:find("karambit", 1, true)
            or low:find("daggers", 1, true) or low:find("kukri", 1, true) then
            return 0.58
        end
        local cat = (WEAPON_CATEGORY and WEAPON_CATEGORY[n]) or nil
        if cat == "Pistols"  then return 0.70 end
        if cat == "SMGs"     then return 0.78 end
        if cat == "Shotguns" or cat == "Rifles" then return 0.82 end
        if cat == "Snipers" or cat == "Heavy"   then return 0.88 end
        if low:find("awp") or low:find("scout") or low:find("ssg")
            or low:find("scar") or low:find("g3sg") then return 0.88 end
        if low:find("ak") or low:find("m4") or low:find("aug") or low:find("famas")
            or low:find("galil") or low:find("sg 553") then return 0.82 end
        return 0.78
    end

    local function _clearMirror()
        if _mirrorClone then pcall(function() _mirrorClone:Destroy() end); _mirrorClone = nil end
        local cam = workspace.CurrentCamera
        if cam then
            for _, child in ipairs(cam:GetChildren()) do
                if child and (child.Name == "_EclipseTPMirror" or child.Name == "_EclipseTPMirrorFolder") then
                    pcall(function() child:Destroy() end)
                end
            end
        end
        _G.__ECLIPSE_MIRROR_CLONE = nil
        _mirrorSourceName, _mirrorSourceRef, _mirrorRootRel = nil, nil, nil
        _mirrorOffset = nil
        _mirrorLastSeen, _mirrorNextUnhide = nil, nil
        _mirrorWeaponCache, _mirrorWeaponCacheAt = nil, 0
    end

    local function _axisFromViewmodel(root)
        local cam = workspace.CurrentCamera
        if not (root and root:IsA("BasePart") and cam) then return Vector3.new(0, 0, -1) end
        local ok, localLook = pcall(function()
            return root.CFrame:VectorToObjectSpace(cam.CFrame.LookVector)
        end)
        if not ok or not localLook then return Vector3.new(0, 0, -1) end
        local ax, ay, az = math.abs(localLook.X), math.abs(localLook.Y), math.abs(localLook.Z)
        if ax >= ay and ax >= az then
            return Vector3.new(localLook.X >= 0 and 1 or -1, 0, 0)
        elseif ay >= ax and ay >= az then
            return Vector3.new(0, localLook.Y >= 0 and 1 or -1, 0)
        end
        return Vector3.new(0, 0, localLook.Z >= 0 and 1 or -1)
    end

    local function _axisToLookCorrection(axis)
        axis = axis or Vector3.new(0, 0, -1)
        if axis.X == 1 then return CFrame.Angles(0, math.rad(90), 0) end
        if axis.X == -1 then return CFrame.Angles(0, math.rad(-90), 0) end
        if axis.Y == 1 then return CFrame.Angles(math.rad(-90), 0, 0) end
        if axis.Y == -1 then return CFrame.Angles(math.rad(90), 0, 0) end
        if axis.Z == 1 then return CFrame.Angles(0, math.rad(180), 0) end
        return CFrame.new()
    end

    local function _isViewmodelBlockedName(n)
        n = tostring(n or "")
        return n == "" or n == "Arms" or n == "Arms1" or n == "Arms2" or n == "Viewmodel"
            or n == "_EclipseTPMirror" or n:sub(1, 8) == "_Eclipse"
    end

    local function _mirrorHasBodyWord(name)
        local s = tostring(name or ""):lower():gsub("[%p_]+", " ")
        for w in s:gmatch("%w+") do
            if w == "arm" or w == "arms" or w == "hand" or w == "hands"
            or w == "glove" or w == "gloves" or w == "sleeve" or w == "sleeves"
            or w == "wrist" or w == "wrists" or w == "finger" or w == "fingers"
            or w == "thumb" or w == "palm" or w == "forearm" or w == "bicep"
            or w == "upperarm" or w == "lowerarm" or w == "elbow" or w == "cuff"
            or w == "body" or w == "skin" or w == "player" or w == "playerbody"
            or w == "playerarms" or w == "playermodel" or w == "torso" then
                return true
            end
        end
        return false
    end

    local function _isKnifePartName(name)
        local s = tostring(name or ""):lower()
        return s:find("blade")  or s:find("handle") or s:find("grip")
            or s:find("guard")  or s:find("pommel") or s:find("hilt")
            or s:find("edge")   or s:find("knife")  or s:find("bayonet")
            or s:find("karambit") or s:find("dagger") or s:find("kukri")
            or s:find("butterfly") or s:find("flip") or s:find("stiletto")
            or s:find("skeleton")
            or s == "root" or s == "primarypart"
    end

    local function _mirrorIsBodyDesc(inst, root)
        local p = inst
        while p and p ~= root and p ~= workspace do
            if _mirrorHasBodyWord(p.Name) then return true end
            p = p.Parent
        end
        return false
    end

    local function _isWeaponCandidate(m)
        if not m or _isMirrorInstance(m) then return false end
        if not m:IsA("Model") then return false end
        if _isViewmodelBlockedName(m.Name) or _mirrorHasBodyWord(m.Name) then return false end
        return m:FindFirstChildWhichIsA("BasePart", true) ~= nil
    end

    local function _findViewmodelWeapon()
        local cam = workspace.CurrentCamera; if not cam then return nil end
        local best
        local function scan(container, depth)
            if not container or depth > 4 then return end
            for _, ch in ipairs(container:GetChildren()) do
                if _isWeaponCandidate(ch) then
                    best = ch
                    return
                elseif (ch:IsA("Model") or ch:IsA("Folder")) and not _isMirrorInstance(ch) then
                    scan(ch, depth + 1)
                    if best then return end
                end
            end
        end
        for _, v in ipairs(cam:GetChildren()) do
            if _isWeaponCandidate(v) and not _mirrorIsBodyDesc(v, cam) then return v end
            if (v:IsA("Model") or v:IsA("Folder")) and not _isMirrorInstance(v) then scan(v, 1); if best then return best end end
        end
        return nil
    end

    local function _getHand(ch)
        return ch and (ch:FindFirstChild("RightHand") or ch:FindFirstChild("Right Arm")) or nil
    end

    local function _pickMirrorRoot(model)
        local h = model and (model:FindFirstChild("Handle", true) or model:FindFirstChild("Grip", true)) or nil
        if h and h:IsA("BasePart") then return h end
        if model and model.PrimaryPart and model.PrimaryPart:IsA("BasePart") then return model.PrimaryPart end
        local best, bestVol = nil, -1
        if model then
            for _, p in ipairs(model:GetDescendants()) do
                if p:IsA("BasePart") then
                    local s = p.Size
                    local vol = s.X * s.Y * s.Z
                    if vol > bestVol then best, bestVol = p, vol end
                end
            end
        end
        return best
    end

    local _mirrorAlign, _mirrorGrip

    local function _mirrorGripFor(weaponName)
        local n   = tostring(weaponName or "")
        local low = n:lower()
        local cat = (WEAPON_CATEGORY and WEAPON_CATEGORY[n]) or nil
        if (KNIVES and KNIVES[n]) or low:find("knife", 1, true) or low:find("bayonet", 1, true)
            or low:find("karambit", 1, true) or low:find("daggers", 1, true) or low:find("kukri", 1, true) then
            return Vector3.new(0.05, -0.05, -0.08)
        end
        if cat == "Pistols" or low:find("deagle") or low:find("glock") or low:find("usp")
            or low:find("p250") or low:find("p2000") or low:find("cz75") or low:find("five")
            or low:find("tec") or low:find("dual") or low:find("revolver") or low:find("r8") then
            return Vector3.new(0.06, -0.06, -0.12)
        end
        if cat == "SMGs" or low:find("mp5") or low:find("mp7") or low:find("mp9")
            or low:find("mac") or low:find("ump") or low:find("p90") or low:find("bizon") then
            return Vector3.new(0.06, -0.07, -0.18)
        end
        if cat == "Snipers" or cat == "Heavy" or cat == "LMGs"
            or low:find("awp") or low:find("scout") or low:find("ssg") or low:find("scar")
            or low:find("g3sg") or low:find("negev") or low:find("m249") then
            return Vector3.new(0.07, -0.08, -0.26)
        end
        return Vector3.new(0.07, -0.07, -0.22)
    end

    local function _computeMirrorAlign(model, root)
        local okAll, result = pcall(function()
            local rcf   = root.CFrame
            local parts = {}
            for _, pp in ipairs(model:GetDescendants()) do
                if pp:IsA("BasePart") then parts[#parts + 1] = pp end
            end
            if #parts == 0 then return nil end

            local mn = Vector3.new(math.huge, math.huge, math.huge)
            local mx = Vector3.new(-math.huge, -math.huge, -math.huge)
            local info = {}
            for _, pp in ipairs(parts) do
                local c  = rcf:PointToObjectSpace(pp.Position)
                local sz = pp.Size
                local ex = rcf:VectorToObjectSpace(pp.CFrame.RightVector * sz.X * 0.5)
                local ey = rcf:VectorToObjectSpace(pp.CFrame.UpVector    * sz.Y * 0.5)
                local ez = rcf:VectorToObjectSpace(pp.CFrame.LookVector  * sz.Z * 0.5)
                local h  = Vector3.new(
                    math.abs(ex.X) + math.abs(ey.X) + math.abs(ez.X),
                    math.abs(ex.Y) + math.abs(ey.Y) + math.abs(ez.Y),
                    math.abs(ex.Z) + math.abs(ey.Z) + math.abs(ez.Z))
                mn = Vector3.new(math.min(mn.X, c.X - h.X), math.min(mn.Y, c.Y - h.Y), math.min(mn.Z, c.Z - h.Z))
                mx = Vector3.new(math.max(mx.X, c.X + h.X), math.max(mx.Y, c.Y + h.Y), math.max(mx.Z, c.Z + h.Z))
                info[#info + 1] = { c = c, h = h }
            end

            local size   = mx - mn
            local center = (mx + mn) * 0.5
            local dim    = { size.X, size.Y, size.Z }
            local cen    = { center.X, center.Y, center.Z }

            local fAxis = 1
            for i = 2, 3 do if dim[i] > dim[fAxis] then fAxis = i end end
            local sAxis = 1
            for i = 2, 3 do if dim[i] < dim[sAxis] then sAxis = i end end
            if sAxis == fAxis then sAxis = (fAxis % 3) + 1 end
            local uAxis = 6 - fAxis - sAxis

            local function comp(v, i)
                if i == 1 then return v.X elseif i == 2 then return v.Y else return v.Z end
            end

            local fSign = 1
            do
                local pos, posN, neg, negN = 0, 0, 0, 0
                for _, it in ipairs(info) do
                    local along = comp(it.c, fAxis) - cen[fAxis]
                    local thick = comp(it.h, uAxis) + comp(it.h, sAxis)
                    if along >= 0 then pos, posN = pos + thick, posN + 1
                    else neg, negN = neg + thick, negN + 1 end
                end
                if posN > 0 and negN > 0 then
                    local pa, na = pos / posN, neg / negN
                    if pa > na * 1.02 then fSign = -1 elseif na > pa * 1.02 then fSign = 1
                    elseif math.abs(cen[fAxis]) > dim[fAxis] * 0.05 then
                        fSign = (cen[fAxis] >= 0) and 1 or -1
                    end
                elseif math.abs(cen[fAxis]) > 1e-3 then
                    fSign = (cen[fAxis] >= 0) and 1 or -1
                end
            end

            local uSign = 1
            do
                local pos, neg = 0, 0
                for _, it in ipairs(info) do
                    local along = comp(it.c, uAxis) - cen[uAxis]
                    local run   = comp(it.h, fAxis)
                    if along >= 0 then pos = pos + run else neg = neg + run end
                end
                if pos > neg * 1.02 then uSign = 1
                elseif neg > pos * 1.02 then uSign = -1
                elseif math.abs(cen[uAxis]) > 1e-3 then
                    uSign = (cen[uAxis] >= 0) and 1 or -1
                end
            end

            local axes = { Vector3.new(1, 0, 0), Vector3.new(0, 1, 0), Vector3.new(0, 0, 1) }
            local f = axes[fAxis] * fSign
            local u = axes[uAxis] * uSign
            local r = u:Cross(-f)
            if r.Magnitude < 1e-3 then return nil end
            r = r.Unit
            u = (-f):Cross(r).Unit
            local L = CFrame.fromMatrix(Vector3.zero, r, u, -f)
            return L:Inverse()
        end)
        if okAll and result then return result end
        return CFrame.new()
    end

    local function _forceMirrorVisible()
        if not _mirrorClone then return end
        for _, d in ipairs(_mirrorClone:GetDescendants()) do
            if d:IsA("BasePart") or d:IsA("Decal") or d:IsA("Texture") then
                pcall(function() d.LocalTransparencyModifier = 0 end)
            end
        end
    end

    local function _rebuildMirror(weapon)
        _clearMirror()
        local ok, clone = pcall(function() return weapon:Clone() end)
        if not ok or not clone then return end

        local _wname = tostring(weapon.Name or "")
        local _wlow  = _wname:lower()
        local _isKnife = (KNIVES and KNIVES[_wname])
            or _wlow:find("knife", 1, true)   or _wlow:find("bayonet", 1, true)
            or _wlow:find("karambit", 1, true) or _wlow:find("daggers", 1, true)
            or _wlow:find("kukri", 1, true)

        for _, d in ipairs(clone:GetDescendants()) do
            if d:IsA("Script") or d:IsA("LocalScript") or d:IsA("ModuleScript") then
                pcall(function() d:Destroy() end)
            elseif d:IsA("BasePart") then
                if _mirrorIsBodyDesc(d, clone) then
                    pcall(function() d:Destroy() end)
                else
                    d.CanCollide = false; d.CanQuery = false; d.CanTouch = false
                    d.Massless   = true
                    d.Anchored   = true
                    pcall(function() d.LocalTransparencyModifier = 0 end)
                end
            elseif d:IsA("Decal") or d:IsA("Texture") then
                pcall(function() d.LocalTransparencyModifier = 0 end)
            elseif d:IsA("Light") or d:IsA("PointLight") or d:IsA("SpotLight")
                or d:IsA("SurfaceLight") or d:IsA("ParticleEmitter")
                or d:IsA("Beam") or d:IsA("Trail") or d:IsA("Highlight")
                or d:IsA("Fire") or d:IsA("Smoke") or d:IsA("Sparkles")
                or d:IsA("Explosion") or d:IsA("SelectionBox")
                or d:IsA("SelectionSphere") or d:IsA("BoxHandleAdornment")
                or d:IsA("SphereHandleAdornment") or d:IsA("CylinderHandleAdornment")
                or d:IsA("SurfaceGui") or d:IsA("BillboardGui") then
                pcall(function() d:Destroy() end)
            end
        end

        if _isKnife then
            local _rescan
            _rescan = function()
                local removed = false
                for _, d in ipairs(clone:GetDescendants()) do
                    if d:IsA("BasePart") then
                        local ok2, isKnifePart = pcall(_isKnifePartName, d.Name)
                        if not (ok2 and isKnifePart) then
                            local a, allow = d.Parent, false
                            while a and a ~= clone and a ~= workspace do
                                if a:IsA("Model") then
                                    local ok3, ok3v = pcall(_isKnifePartName, a.Name)
                                    if ok3 and ok3v then allow = true; break end
                                end
                                a = a.Parent
                            end
                            if not allow then
                                pcall(function() d:Destroy() end)
                                removed = true
                            end
                        end
                    end
                end
                return removed
            end
            pcall(_rescan)
        end

        for _, d in ipairs(clone:GetDescendants()) do
            if d:IsA("BasePart") then
                pcall(function()
                    if d.Material == Enum.Material.Neon
                        or d.Material == Enum.Material.ForceField
                        or d.Material == Enum.Material.Glass then
                        d.Material = Enum.Material.SmoothPlastic
                    end
                    d.Reflectance = 0
                    d.CastShadow = false
                end)
            end
        end
        clone.Name = "_EclipseTPMirror"
        pcall(function() clone.Archivable = false end)
        local root = _pickMirrorRoot(clone)
        if not root then pcall(function() clone:Destroy() end); return end
        clone.PrimaryPart = root
        clone.Parent = workspace.CurrentCamera
        pcall(function() clone:ScaleTo(_mirrorScaleFor(weapon.Name)) end)
        _mirrorRootRel = clone:GetPivot():ToObjectSpace(root.CFrame)
        _mirrorOffset  = _mirrorOffsetFor(weapon.Name)
        _mirrorAlign   = _computeMirrorAlign(clone, root)
        _mirrorGrip    = _mirrorGripFor(weapon.Name)
        _mirrorClone   = clone
        _mirrorSourceName = weapon.Name
        _mirrorSourceRef  = weapon
        _G.__ECLIPSE_MIRROR_CLONE = clone
        _forceMirrorVisible()
    end

    -- Definitive orientation: the weapon is NEVER placed with the model's own
    -- (unreliable) axes. We build an aim frame from the camera/character and
    -- rotate the clone by the auto-computed alignment, which maps the model's
    -- real long axis to "forward" for every weapon, no per-model tuning.
    local function _positionMirror(hand)
        if not (_mirrorClone and _mirrorClone.Parent and hand) then return end
        local rel = _mirrorRootRel or CFrame.new()
        pcall(function()
            local align = _mirrorAlign or CFrame.new()
            local grip  = _mirrorGrip or Vector3.new(0.07, -0.07, -0.22)

            local ch  = LocalPlayer.Character
            local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
            local cam = workspace.CurrentCamera

            local dir
            if cam then dir = cam.CFrame.LookVector end
            if (not dir or dir.Magnitude < 1e-3) and hrp then dir = hrp.CFrame.LookVector end
            if not dir or dir.Magnitude < 1e-3 then dir = hand.CFrame.LookVector end
            dir = dir.Unit

            local up    = Vector3.new(0, 1, 0)
            local right = dir:Cross(up)
            if right.Magnitude < 1e-3 then
                right = (hrp and hrp.CFrame.RightVector) or hand.CFrame.RightVector
            end
            right = right.Unit
            up = right:Cross(dir).Unit

            -- anchor at the hand, offsets expressed in aim space (x right, y up, -z forward)
            local base = CFrame.fromMatrix(hand.CFrame.Position, right, up, -dir)
                * CFrame.new(grip.X, grip.Y, grip.Z)

            _mirrorClone:PivotTo((base * align) * rel:Inverse())
        end)
        local now = tick()
        if not _mirrorNextUnhide or now >= _mirrorNextUnhide then
            _mirrorNextUnhide = now + 0.20
            _forceMirrorVisible()
        end
    end


    local function _updateMirror()
        local ch = LocalPlayer.Character; if not ch then return _clearMirror() end
        local hum = ch:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 or hum:GetState() == Enum.HumanoidStateType.Dead then return _clearMirror() end
        local hand = _getHand(ch); if not hand then return _clearMirror() end
        local now = tick()
        local weapon = _mirrorWeaponCache
        if not (weapon and weapon.Parent) or (now - _mirrorWeaponCacheAt) > 0.15 then
            weapon = _findViewmodelWeapon()
            _mirrorWeaponCache   = weapon
            _mirrorWeaponCacheAt = now
        end
        if not weapon then

            if _mirrorClone and _mirrorClone.Parent then
                _positionMirror(hand)
                return
            end
            if _mirrorLastSeen and now - _mirrorLastSeen < 2.0 then return end
            return _clearMirror()
        end
        _mirrorLastSeen = now
        if not (_mirrorClone and _mirrorClone.Parent) or _mirrorSourceRef ~= weapon or _mirrorSourceName ~= weapon.Name then
            _rebuildMirror(weapon)
        end
        _positionMirror(hand)
    end

    local function _showLocalChar()
        local ch = LocalPlayer.Character; if not ch then return end
        for _, p in ipairs(ch:GetDescendants()) do
            if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then
                pcall(function() p.LocalTransparencyModifier = 0 end)
            end
        end
    end

    local _tpVMParts, _tpVMPartsAt = {}, 0
    local function _getVMVisualParts()
        local cam = workspace.CurrentCamera; if not cam then return {} end
        local now = tick()
        if _tpVMParts and (now - (_tpVMPartsAt or 0)) < 0.35 then return _tpVMParts end
        local out = {}
        for _, v in ipairs(cam:GetChildren()) do
            if (v:IsA("Model") or v:IsA("Folder")) and not _isMirrorInstance(v) then
                for _, p in ipairs(v:GetDescendants()) do
                    if p:IsA("BasePart") or p:IsA("Decal") or p:IsA("Texture") then
                        out[#out + 1] = p
                        ES152.yieldEvery(#out, 160)
                    end
                end
            end
        end
        _tpVMParts, _tpVMPartsAt = out, now
        return out
    end

    local function _restoreVM()
        for _, p in ipairs(_getVMVisualParts()) do
            if p and p.Parent then
                pcall(function() p.LocalTransparencyModifier = 0 end)
            end
        end
        _tpVMParts, _tpVMPartsAt = {}, 0
    end

    local function _hideVM()
        for _, p in ipairs(_getVMVisualParts()) do
            if p and p.Parent then pcall(function() p.LocalTransparencyModifier = 1 end) end
        end
    end

    local _selfDummy, _selfHidden = nil, {}
    local _selfDummyChar = nil

    local function _purgeLegacySelfDummies()
        pcall(function()
            for _, root in ipairs({ workspace, workspace.CurrentCamera }) do
                if root then
                    for _, d in ipairs(root:GetChildren()) do
                        if d.Name == "_EclipseSelfDummy" or d.Name == "ECLIPSE_HUBSelfDummy" then
                            pcall(function() d:Destroy() end)
                        end
                    end
                end
            end
        end)
    end

    local function _clearSelfDummy()
        if _selfDummy then pcall(function() _selfDummy:Destroy() end) end
        _selfDummy = nil
        _selfDummyChar = nil
        _G.__ECLIPSE_SELF_DUMMY = nil
        for part, val in pairs(_selfHidden) do
            if part and part.Parent then
                pcall(function() part.LocalTransparencyModifier = val end)
            end
        end
        _selfHidden = {}
        _purgeLegacySelfDummies()
    end

    local function _isInventoryDesc(d)
        if not d then return false end
        if d:IsA("Tool") or d:IsA("Backpack") then return true end
        local n = tostring(d.Name or "")
        local low = n:lower()
        if (WEAPON_CATEGORY and WEAPON_CATEGORY[n]) or (KNIVES and KNIVES[n])
            or (GLOVES and GLOVES[n]) or (IgnoreFolders and IgnoreFolders[n]) then
            return true
        end
        if low:find("weapon") or low:find("inventory") or low:find("loadout")
            or low:find("viewmodel") or low:find("holster") or low:find("equipped")
            or low:find("gun") or low:find("knife") or low:find("grenade")
            or low:find("m4a") or low:find("ak%-?47") or low:find("deagle")
            or low:find("glock") or low:find("usp") or low:find("awp")
            or low:find("ssg") or low:find("aug") or low:find("famas")
            or low:find("galil") or low:find("p250") or low:find("tec")
            or low:find("mp%d") or low:find("mac%-?10") or low:find("ump")
            or low:find("p90") or low:find("bizon") or low:find("negev")
            or low:find("m249") or low:find("nova") or low:find("xm1014")
            or low:find("mag%-?7") or low:find("sawed") or low:find("c4") then
            return true
        end
        local p = d.Parent
        while p and p ~= workspace do
            if p:IsA("Tool") then return true end
            local pn = tostring(p.Name or "")
            local pl = pn:lower()
            if (WEAPON_CATEGORY and WEAPON_CATEGORY[pn]) or (KNIVES and KNIVES[pn])
                or (GLOVES and GLOVES[pn]) or (IgnoreFolders and IgnoreFolders[pn]) then
                return true
            end
            if pl:find("weapon") or pl:find("inventory") or pl:find("loadout")
                or pl:find("viewmodel") or pl:find("holster") or pl:find("equipped") then
                return true
            end
            p = p.Parent
        end
        return false
    end

    local function _selfDummyHiddenPartName(name)
        local low = tostring(name or ""):lower()
        return low == "humanoidrootpart" or low == "rootpart" or low == "root"
            or low:find("hitbox", 1, true) or low:find("hurtbox", 1, true)
            or low:find("collider", 1, true) or low:find("collision", 1, true)
            or low:find("bound", 1, true) or low:find("debug", 1, true)
    end

    local function _sterileVisualPartFrom(src)
        if not (src and src:IsA("BasePart")) then return nil end
        if _isInventoryDesc(src) then return nil end
        local ok, cp = pcall(function() return src:Clone() end)
        if not ok or not cp then return nil end
        pcall(function()
            for attr in pairs(cp:GetAttributes()) do cp:SetAttribute(attr, nil) end
        end)
        for _, d in ipairs(cp:GetDescendants()) do
            if not (d:IsA("SpecialMesh") or d:IsA("BlockMesh") or d:IsA("CylinderMesh")
                or d:IsA("SurfaceAppearance") or d:IsA("Decal") or d:IsA("Texture")) then
                pcall(function() d:Destroy() end)
            end
        end
        pcall(function()
            cp.Anchored   = false
            cp.CanCollide = false
            cp.CanQuery   = false
            cp.CanTouch   = false
            cp.Massless   = true
            cp.CastShadow = false
            cp.CFrame     = src.CFrame
        end)
        if _selfDummyHiddenPartName(src.Name) then
            pcall(function()
                cp.Transparency = 1
                cp.LocalTransparencyModifier = 1
            end)
        end
        return cp
    end

    -- The old part-by-part clone dummy could not carry Shirt/Pants/BodyColors
    -- (they live on the character Model, not on the parts), which is exactly
    -- why the third person body showed up with missing clothing pieces, and it
    -- also spawned an extra body in workspace that confused the bunny hop
    -- ground checks. We now render the REAL character instead: no clone, no
    -- ghost hitbox, clothing and accessories always correct.
    local function _buildSelfDummy()
        _clearSelfDummy()
        local ch = LocalPlayer.Character; if not ch then return end
        for _, p in ipairs(ch:GetDescendants()) do
            if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then
                pcall(function() p.LocalTransparencyModifier = 0 end)
            elseif p:IsA("Decal") or p:IsA("Texture") then
                pcall(function() p.LocalTransparencyModifier = 0 end)
            end
        end
    end

    _G.ECLIPSE_HUBSelfDummyBuild = _buildSelfDummy
    _G.ECLIPSE_HUBSelfDummyClear = _clearSelfDummy

    local _tpOldType = nil
