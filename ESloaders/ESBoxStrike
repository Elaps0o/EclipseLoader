    local XH = {
        lines = {},
        glow = {},
        dot = nil,
        angle = 0,
        pulseT = 0,
        ready = false,
    }
    local function buildXH()
        if XH.ready then return end
        for i = 1, 4 do
            local l = Drawing.new("Line")
            l.Visible = false
            l.Thickness = 1
            l.Color = Color3.fromRGB(0, 255, 0)
            l.Transparency = 1
            XH.lines[i] = l
            local g = Drawing.new("Line")
            g.Visible = false
            g.Thickness = 3
            g.Color = Color3.fromRGB(140, 100, 255)
            g.Transparency = 0.45
            XH.glow[i] = g
        end
        local d = Drawing.new("Circle")
        d.Visible = false
        d.Filled = true
        d.NumSides = 12
        d.Radius = 1.5
        d.Color = Color3.fromRGB(0, 255, 0)
        d.Transparency = 1
        XH.dot = d
        XH.ready = true
    end
    local function hideXH()
        for _, l in ipairs(XH.lines) do l.Visible = false end
        for _, g in ipairs(XH.glow) do g.Visible = false end
        if XH.dot then XH.dot.Visible = false end
    end
    local function isAimingEnemy()
        if SilentTarget and SilentTarget.Parent then return true end
        if CubeSmartTarget and CubeSmartTarget.Parent then return true end
        return false
    end

    RunService.RenderStepped:Connect(function(dt)
        pcall(function()
            if not (Toggles.CustomCrosshairEnabled and Toggles.CustomCrosshairEnabled.Value) then
                hideXH()
                return
            end
            if Library.Toggled then
                hideXH()
                return
            end
            buildXH()
            local cam = Workspace.CurrentCamera
            if not cam then hideXH(); return end
            local vp = cam.ViewportSize
            local cx, cy = vp.X / 2, vp.Y / 2
            local length = Options.XHLength and Options.XHLength.Value or 5
            local thick = Options.XHThickness and Options.XHThickness.Value or 1
            local gap = Options.XHGap and Options.XHGap.Value or 2
            local col = Options.XHColor and Options.XHColor.Value or Color3.fromRGB(0, 255, 0)
            if Toggles.XHOnTarget and Toggles.XHOnTarget.Value and isAimingEnemy() then
                col = Options.XHTargetColor and Options.XHTargetColor.Value or Color3.fromRGB(255, 50, 50)
            end
            if Toggles.XHSpin and Toggles.XHSpin.Value then
                XH.angle = (XH.angle + (Options.XHSpinSpeed and Options.XHSpinSpeed.Value or 90) * dt) % 360
            else
                XH.angle = 0
            end
            -- open / close pulse (gap expands then contracts)
            local pulseGap = 0
            if Toggles.XHPulse and Toggles.XHPulse.Value then
                XH.pulseT = XH.pulseT + dt * (Options.XHPulseSpeed and Options.XHPulseSpeed.Value or 1.2)
                local wave = (math.sin(XH.pulseT * math.pi * 2) + 1) * 0.5 -- 0..1
                pulseGap = wave * (Options.XHPulseAmount and Options.XHPulseAmount.Value or 6)
            end
            local useGap = gap + pulseGap
            local rad = math.rad(XH.angle)
            local dirs = {
                Vector2.new(math.sin(rad), -math.cos(rad)),
                Vector2.new(math.sin(rad + math.pi), -math.cos(rad + math.pi)),
                Vector2.new(math.sin(rad + math.pi/2), -math.cos(rad + math.pi/2)),
                Vector2.new(math.sin(rad - math.pi/2), -math.cos(rad - math.pi/2)),
            }
            local tStyle = Toggles.XHTStyle and Toggles.XHTStyle.Value
            local glowOn = Toggles.XHGlow and Toggles.XHGlow.Value
            local glowCol = Options.XHGlowColor and Options.XHGlowColor.Value or Color3.fromRGB(140, 100, 255)
            local glowSz = Options.XHGlowSize and Options.XHGlowSize.Value or 2.5
            for i = 1, 4 do
                local l = XH.lines[i]
                local g = XH.glow[i]
                if tStyle and i == 1 then
                    l.Visible = false
                    if g then g.Visible = false end
                else
                    local dir = dirs[i]
                    local from = Vector2.new(cx, cy) + dir * useGap
                    local to = Vector2.new(cx, cy) + dir * (useGap + length)
                    if glowOn and g then
                        g.From = from
                        g.To = to
                        g.Color = glowCol
                        g.Thickness = thick + glowSz
                        g.Transparency = 0.4
                        g.Visible = true
                    elseif g then
                        g.Visible = false
                    end
                    l.From = from
                    l.To = to
                    l.Color = col
                    l.Thickness = thick
                    l.Visible = true
                end
            end
            if Toggles.XHCenterDot and Toggles.XHCenterDot.Value then
                XH.dot.Position = Vector2.new(cx, cy)
                XH.dot.Color = col
                XH.dot.Visible = true
            else
                XH.dot.Visible = false
            end
        end)
    end)

