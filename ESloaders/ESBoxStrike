            if onlyScoped and not isScopedNow() then
                hideScopeLines()
                return
            end
            local cam = Workspace.CurrentCamera
            if not cam then hideScopeLines(); return end
            local vp = cam.ViewportSize
            local cx, cy = vp.X / 2, vp.Y / 2
