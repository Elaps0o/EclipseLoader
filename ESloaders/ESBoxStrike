    _G.ECLIPSE_HUBTPEnable  = _tpEnable
    _G.ECLIPSE_HUBTPDisable = _tpDisable

    connectSignal(LocalPlayer.CharacterAdded:Connect(function(ch)
        if not scriptRunning then return end
        pcall(_clearMirror)
        pcall(_clearSelfDummy)
