        return nil
    end

    local function pvsAllows(a, b)
        local pvs = makePVS()
        if not pvs or typeof(a) ~= "Vector3" or typeof(b) ~= "Vector3" then return nil end
        local okA, cellsA = pcall(pvs.FindCells, pvs, a)
        local okB, cellsB = pcall(pvs.FindCells, pvs, b)
        if not okA or not okB or type(cellsA) ~= "table" or type(cellsB) ~= "table" then return nil end

        local okClass, class = pcall(pvs.ClassifyCells, pvs, cellsA, cellsB)
        if okClass and class == "VisibleWithoutRuntimeProof" then return true end
        if okClass and class == "NeedsRuntimeOcclusionProof" then return false end

        local okVisible, visible = pcall(pvs.CouldCellsSee, pvs, cellsA, cellsB)
        if okVisible then return visible == true end
        return nil
    end

