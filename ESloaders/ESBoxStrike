            local th = Options.SniperLinesThickness and Options.SniperLinesThickness.Value or 1
            local opacity = Options.SniperLinesOpacity and Options.SniperLinesOpacity.Value or 1
            local gap = Options.SniperLinesGap and Options.SniperLinesGap.Value or 0
            local lenH = Options.SniperLinesLengthH and Options.SniperLinesLengthH.Value or 0
            local lenV = Options.SniperLinesLengthV and Options.SniperLinesLengthV.Value or 0
            local showH = not (Toggles.SniperLinesHorizontal and Toggles.SniperLinesHorizontal.Value == false)
            local showV = not (Toggles.SniperLinesVertical and Toggles.SniperLinesVertical.Value == false)
            -- H: left + right segments (0 length = full screen)
            if showH then
                local half = (lenH > 0) and (lenH * 0.5) or (vp.X * 0.5)
                ScopeLines.hL.From = Vector2.new(cx - half, cy)
                ScopeLines.hL.To = Vector2.new(cx - gap, cy)
                ScopeLines.hR.From = Vector2.new(cx + gap, cy)
                ScopeLines.hR.To = Vector2.new(cx + half, cy)
                for _, k in ipairs({"hL", "hR"}) do
                    local l = ScopeLines[k]
                    l.Color = col
                    l.Thickness = th
                    l.Transparency = opacity
                    l.Visible = half > gap
                end
            else
                ScopeLines.hL.Visible = false
                ScopeLines.hR.Visible = false
            end
            -- V: top + bottom
            if showV then
                local half = (lenV > 0) and (lenV * 0.5) or (vp.Y * 0.5)
                ScopeLines.vT.From = Vector2.new(cx, cy - half)
                ScopeLines.vT.To = Vector2.new(cx, cy - gap)
                ScopeLines.vB.From = Vector2.new(cx, cy + gap)
                ScopeLines.vB.To = Vector2.new(cx, cy + half)
                for _, k in ipairs({"vT", "vB"}) do
                    local l = ScopeLines[k]
                    l.Color = col
                    l.Thickness = th
                    l.Transparency = opacity
                    l.Visible = half > gap
                end
            else
                ScopeLines.vT.Visible = false
                ScopeLines.vB.Visible = false
            end
        end)
    end)

    ----------------------------------------------------------------
    -- ESP FOOT TRAILS (Drawing lines under each player)
    ----------------------------------------------------------------
    local Trails = {} -- [char] = { points = {Vector3}, lines = {Drawing} }
    local TRAIL_MAX = 40
    local function getTrailPack(char)
        if Trails[char] then return Trails[char] end
        local pack = { points = {}, lines = {} }
        for i = 1, TRAIL_MAX do
            local l = Drawing.new("Line")
            l.Visible = false
            l.Thickness = 1.5
            l.Transparency = 1
            pack.lines[i] = l
        end
        Trails[char] = pack
        return pack
    end
    local function clearTrail(char)
        local pack = Trails[char]
        if not pack then return end
        for _, l in ipairs(pack.lines) do pcall(function() l:Remove() end) end
        Trails[char] = nil
    end
    RunService.RenderStepped:Connect(function()
        pcall(function()
            local enabled = not (Toggles.ESPTrails and Toggles.ESPTrails.Value == false)
            -- default ON: only off if explicitly toggled false
            if Toggles.ESPTrails and Toggles.ESPTrails.Value == false then
                for char, _ in pairs(Trails) do clearTrail(char) end
                return
            end
            local cam = Workspace.CurrentCamera
            if not cam then return end
            local col = Options.ESPTrailsColor and Options.ESPTrailsColor.Value or Color3.fromRGB(140, 100, 255)
            local maxLen = math.clamp(Options.ESPTrailsLength and Options.ESPTrailsLength.Value or 12, 4, TRAIL_MAX)
            local thick = Options.ESPTrailsThickness and Options.ESPTrailsThickness.Value or 1.5
            local seen = {}
            local function processChar(char)
                if not char or char == LP.Character then return end
                local root = char:FindFirstChild("HumanoidRootPart")
                if not root then return end
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health <= 0 then return end
                seen[char] = true
                local pack = getTrailPack(char)
                local pos = root.Position - Vector3.new(0, 2.9, 0) -- under feet
                table.insert(pack.points, 1, pos)
                while #pack.points > maxLen do table.remove(pack.points) end
                for i = 1, TRAIL_MAX do
                    local l = pack.lines[i]
                    local p1, p2 = pack.points[i], pack.points[i + 1]
                    if p1 and p2 then
                        local s1, o1 = cam:WorldToViewportPoint(p1)
                        local s2, o2 = cam:WorldToViewportPoint(p2)
                        if (o1 or o2) and s1.Z > 0 and s2.Z > 0 then
                            local fade = 1 - (i / maxLen)
                            l.From = Vector2.new(s1.X, s1.Y)
                            l.To = Vector2.new(s2.X, s2.Y)
                            l.Color = col
                            l.Thickness = thick * fade
                            l.Transparency = fade
                            l.Visible = true
                        else
                            l.Visible = false
                        end
                    else
                        l.Visible = false
                    end
                end
            end
            local folder = Workspace:FindFirstChild("Characters")
            if folder then
                for _, m in ipairs(folder:GetChildren()) do
                    if m:IsA("Model") then processChar(m) end
                end
            else
                for _, plr in ipairs(Players:GetPlayers()) do
                    if plr ~= LP and plr.Character then processChar(plr.Character) end
                end
            end
            for char, _ in pairs(Trails) do
                if not seen[char] then clearTrail(char) end
            end
        end)
    end)

