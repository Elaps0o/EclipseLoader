        if per and per ~= "Default" then
            return _presetInfo(per)
        end
        return nil
    end

    local function _isFireSound(catName, snd)
        local n = (snd.Name or ""):lower()
        local pn = (snd.Parent and snd.Parent.Name or ""):lower()
        if n:find("deploy") or n:find("draw") or n:find("pullout") or n:find("pull_out")
           or n:find("reload") or n:find("empty") or n:find("bolt") or n:find("zoom")
           or n:find("scope") or n:find("trigger") or n:find("dry") or n:find("switch")
           or n:find("pickup") or n:find("drop") or n:find("clip") or n:find("magazine")
           or n:find("inspect") or n:find("melee") or n:find("silencer") then return false end
        if pn:find("deploy") or pn:find("reload") or pn:find("empty") or pn:find("silencer")
           or pn:find("bolt") or pn:find("zoom") or pn:find("scope") or pn:find("inspect")
           or pn:find("pickup") or pn:find("drop") then return false end
        if n:find("fire") or n:find("shoot") or n:find("shot") or n == "1" or n == "2" or n == "3"
           or pn:find("fire") or pn:find("shoot") or pn:find("shot") then return true end
        return false
    end
    local _ContentProvider = game:GetService("ContentProvider")
    local function _preload(snd)
        task.spawn(function() pcall(function() _ContentProvider:PreloadAsync({ snd }) end) end)
    end

    EX.applySoundOverrides = function()
        if EX_LIMITED then return end
        if not Config.Sounds.Enabled then
            for snd, data in pairs(EX.originalSoundIds) do
                if snd and snd.Parent then pcall(function()
                    if type(data) == "table" then
                        snd.SoundId = data.SoundId or snd.SoundId
                        snd.Volume = data.Volume or snd.Volume
                        snd.PlaybackSpeed = data.PlaybackSpeed or snd.PlaybackSpeed
                    else
                        snd.SoundId = data
                    end
                end) end
            end
            return
        end
        walkSounds(function(catName, snd, weaponName)
            if not EX.originalSoundIds[snd] then EX.originalSoundIds[snd] = { SoundId=snd.SoundId, Volume=snd.Volume, PlaybackSpeed=snd.PlaybackSpeed } end
            if catName == "Bullet" or not _isFireSound(catName, snd) then
                local data = EX.originalSoundIds[snd]
                pcall(function()
                    if type(data) == "table" then
                        snd.SoundId = data.SoundId or snd.SoundId
                        snd.Volume = data.Volume or snd.Volume
                        snd.PlaybackSpeed = data.PlaybackSpeed or snd.PlaybackSpeed
                    else
                        snd.SoundId = data
                    end
                end)
                return
            end
            local inf = resolvePresetInfo(catName, weaponName)
            if inf then
                pcall(function()
                    snd.SoundId = inf.Id
                    snd.Volume = inf.Volume
                    snd.PlaybackSpeed = inf.Pitch
                end)
                _preload(snd)
            else
                local data = EX.originalSoundIds[snd]
                pcall(function()
                    if type(data) == "table" then
                        snd.SoundId = data.SoundId or snd.SoundId
                        snd.Volume = data.Volume or snd.Volume
                        snd.PlaybackSpeed = data.PlaybackSpeed or snd.PlaybackSpeed
                    else
                        snd.SoundId = data
                    end
                end)
            end
        end)
    end

    EX.patchShootSound = function(snd)
        if not (snd and snd:IsA("Sound")) then return end
        if not (Config and Config.Sounds and Config.Sounds.Enabled) then return end
        local catName = snd.Parent and snd.Parent.Name or ""
        local weaponName = _weaponNameForSound(snd, catName)
        if catName == "Bullet" or not _isFireSound(catName, snd) then return end
        local inf = resolvePresetInfo(catName, weaponName)
        if not inf then return end
        if not EX.originalSoundIds[snd] then EX.originalSoundIds[snd] = { SoundId=snd.SoundId, Volume=snd.Volume, PlaybackSpeed=snd.PlaybackSpeed } end
        pcall(function()
            snd.SoundId = inf.Id
            snd.Volume = inf.Volume
            snd.PlaybackSpeed = inf.Pitch
        end)
    end

    EX.restoreAllSounds = function()
        for snd, data in pairs(EX.originalSoundIds) do
            if snd and snd.Parent then pcall(function()
                if type(data) == "table" then
                    snd.SoundId = data.SoundId or snd.SoundId
                    snd.Volume = data.Volume or snd.Volume
                    snd.PlaybackSpeed = data.PlaybackSpeed or snd.PlaybackSpeed
                else
                    snd.SoundId = data
                end
            end) end
        end
    end
    EX.SoundLoopAlive = true

    task.spawn(function()
        while EX.SoundLoopAlive do
            task.wait(0.75)
            if Config and Config.Sounds and Config.Sounds.Enabled then pcall(EX.applySoundOverrides) end
        end
    end)
end)()

