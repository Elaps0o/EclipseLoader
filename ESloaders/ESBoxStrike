                    local str = Options.PixelSurfStrength and Options.PixelSurfStrength.Value or 0.35
                    local flat = Vector3.new(vel.X, 0, vel.Z)
                    if flat.Magnitude > 1 then
                        local boost = flat.Unit * (flat.Magnitude + str * 6)
                        root.AssemblyLinearVelocity = Vector3.new(boost.X, math.max(vel.Y, -1.5), boost.Z)
