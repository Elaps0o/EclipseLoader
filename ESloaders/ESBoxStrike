function _espProcessPlayer(plr, myRoot, center)

    if not _IS_DEATHMATCH and Config.TeamCheck and IsAlly(plr) then
        local old = ESPObjects[plr]
        if old then old._wantVisible = false end
        return nil
    end
    local char = GetCharacter(plr)
    local data = ESPObjects[plr]

    local root, head, hum
    if char then
        root = char:FindFirstChild("HumanoidRootPart")
        head = char:FindFirstChild("Head")
        hum  = char:FindFirstChildOfClass("Humanoid")
    end

    local aliveOk = char and char.Parent and root and head and hum and hum.Health > 0
    if aliveOk then

        local okState, st = pcall(function() return hum:GetState() end)
        if okState and (st == Enum.HumanoidStateType.Dead
                     or st == Enum.HumanoidStateType.PlatformStanding and hum.Health <= 1) then
            aliveOk = false
        end
    end
    local hp, maxHp
    if aliveOk then
        hp, maxHp = _espHealthValues(plr, char, hum)
        if not hp or hp <= 0 then aliveOk = false end
    end

    local isFrozen = false
    local headPos, rootPos

    if not aliveOk then
        if data and data._lastHeadPos and data._lastRootPos then
            if not data._frozen then
                data._frozen  = true
                data._deathAt = tick()
            end
            isFrozen = true
            headPos  = data._lastHeadPos
            rootPos  = data._lastRootPos
            hp       = data._lastHP or 0
            maxHp    = data._lastMaxHP or 100
        else
            if data then data._wantVisible = false end
            return nil
        end
    else
        headPos = head.Position
        rootPos = root.Position
    end

    local dist = (myRoot.Position - rootPos).Magnitude
    local maxD = Config.ESP.MaxDistance
    if Config.Aimbot.Enabled then maxD = math.max(maxD, 600) end
    if dist > maxD then if data then data._wantVisible = false end; return nil end

    if not data then
        if isFrozen then return nil end
        data = createESPObjects()
        ESPObjects[plr] = data
        data._alpha = 0
    end

    if not isFrozen then
        data._lastHeadPos = headPos
        data._lastRootPos = rootPos
        data._lastHP      = hp
        data._lastMaxHP   = maxHp
        if data._frozen then data._frozen = false; data._deathAt = nil end
    end

    if isFrozen then data._wantVisible = true end

    local hP, hOn = Camera:WorldToViewportPoint(headPos + Vector3.new(0,0.75,0))
    local fP, fOn = Camera:WorldToViewportPoint(rootPos - Vector3.new(0,3.35,0))
    local onScreen = hOn and fOn and hP.Z > 0 and fP.Z > 0
    if not onScreen then
        data._wantVisible = false
        if Config.ESP.Arrows and not isFrozen then _espDrawArrow(data, { Position = rootPos }) end
        return nil
    end

    local height  = math.abs(hP.Y - fP.Y); local width = height * 0.78
    local cx = hP.X; local cy = ((hP.Y + fP.Y)/2)
    local L, R = cx - width/2, cx + width/2
    local T, B = cy - height/2, cy + height/2

    local vs = Camera.ViewportSize

    local scopedNow = (isScopedIn and isScopedIn()) or (Camera.FieldOfView and Camera.FieldOfView < (OriginalCameraFOV or 70) * 0.6)
    local margin = scopedNow and math.max(vs.X, vs.Y) or 6
    if L < -margin or R > vs.X + margin or T < -margin or B > vs.Y + margin then
        local anyInside = (cx >= -margin and cx <= vs.X + margin and cy >= -margin and cy <= vs.Y + margin)
        if not anyInside then
            data._wantVisible = false
            if Config.ESP.Arrows and not isFrozen then _espDrawArrow(data, { Position = rootPos }) end

            return nil
        end
        L = math.clamp(L, 0, vs.X); R = math.clamp(R, 0, vs.X)
        T = math.clamp(T, 0, vs.Y); B = math.clamp(B, 0, vs.Y)
    end

    if Config.ESP.CornerBox then
        _espDrawCornerBox(data, plr, L, R, T, B, width*0.25, height*0.25)
    else
        for _, l in pairs(data.CornerLines) do l.Visible=false end
        if data.BoxGlow then for _, l in pairs(data.BoxGlow) do l.Visible=false end end
        if data.GuiBox then data.GuiBox.Visible = false end
    end

    local layout = _espTextLayout(L, R, T, B, cx)
    local weaponName = _espGetWeaponName(plr)

    local wantTag = Config.ESP.Name or Config.ESP.Distance or Config.ESP.WeaponName or (Config.ESP.IdentifyMoney and _isWarmup and _isWarmup())
    if wantTag then
        _espDrawTag(data, L, R, T, cx, plr, dist, weaponName, B)
        data.NameTag.Visible = false
        data.DistTag.Visible = false
        if data.WeaponTag then data.WeaponTag.Visible = false end
    else
        data.NameTag.Visible = false
        data.DistTag.Visible = false
        if data.WeaponTag then data.WeaponTag.Visible = false end
        if data.TagBg then data.TagBg.Visible = false end
        if data.TagBorder then for _, l in pairs(data.TagBorder) do l.Visible = false end end
        if data.TagGrad then for _, l in pairs(data.TagGrad) do l.Visible = false end end
        _espHideAmmo(data)
        if data.TagText then data.TagText.Visible = false end
        if data.MoneyText then data.MoneyText.Visible = false end
        if data.WeaponIcon then data.WeaponIcon.Visible = false end
    end

    if Config.ESP.HealthBar and hp and hp > 0 then
        _espDrawHealth(data, hp, maxHp, L, R, T, B, height)
    else
        data.HealthBg.Visible=false; data.HealthFill.Visible=false; data.HealthText.Visible=false
        for _, l in pairs(data.HealthSegments) do l.Visible = false end
        if data.HealthTicks then for _, l in pairs(data.HealthTicks) do l.Visible = false end end
    end

    _espHideAmmo(data)

    data.Presence.Visible = false

    local _unused_layout = layout

    if Config.ESP.HeadDot then
        if _DRAW_OK and data.HeadDot then

            local r = math.clamp(height * 0.04, 2, 5)
            pcall(function()
                data.HeadDot.Position = Vector2.new(math.floor(hP.X), math.floor(hP.Y))
                data.HeadDot.Radius   = r
                data.HeadDot.Filled   = true
                data.HeadDot.NumSides = 16
                data.HeadDot.Color    = Config.ESP.HeadDotColor
                data.HeadDot.Visible  = true
                data.HeadDot.ZIndex   = 23
            end)
            if data.GuiHeadDot then data.GuiHeadDot.Visible = false end
        else
            local dot = _espEnsureHeadDotGui(data)
            if dot then
                local r = math.clamp(height * 0.04, 2, 5)
                dot.Size = UDim2.fromOffset(math.floor(r * 2), math.floor(r * 2))
                dot.Position = UDim2.fromOffset(math.floor(hP.X), math.floor(hP.Y))
                dot.BackgroundColor3 = Config.ESP.HeadDotColor
                dot.Visible = true
            end
        end
    else
        if data.HeadDot then pcall(function() data.HeadDot.Visible = false end) end
        if data.GuiHeadDot then data.GuiHeadDot.Visible = false end
    end

    if Config.ESP.Skeleton and data.Skeleton and not isFrozen and char then
        _espDrawSkeleton(data, char)
    else
        if data.Skeleton then
            for _, ln in pairs(data.Skeleton) do
                if type(ln) ~= "table" then pcall(function() ln.Visible = false end) end
            end
        end
        if data.GuiSkeleton then for _, f in pairs(data.GuiSkeleton) do f.Visible = false end end
    end

    if Config.ESP.ChinaHat and data.ChinaHat and not isFrozen and char then
        _espDrawChinaHat(data, char)
    else
        if data.ChinaHat then
            for _, ln in pairs(data.ChinaHat) do pcall(function() ln.Visible = false end) end
        end
        if data.GuiChinaHat then for _, f in pairs(data.GuiChinaHat) do f.Visible = false end end
    end

    if data.Arrow then data.Arrow.Visible = false end

    local aimDist = (Vector2.new(hP.X, hP.Y) - center).Magnitude
    data._wantVisible = true
    if isFrozen then return nil end
    return { player=plr, head=head, root=root, hum=hum, dist=dist, aimDist=aimDist }
end

local ChamsData = setmetatable({}, { __mode = "k" })
local _ChamsHolder = nil
local function _getChamsHolder()
    if _ChamsHolder and _ChamsHolder.Parent then return _ChamsHolder end
    local ok, cg = pcall(function() return game:GetService("CoreGui") end)
    local parent = (ok and cg) or workspace
    local f = parent:FindFirstChild("ECLIPSE_HUBChamsHolder")
    if not f then
        f = Instance.new("Folder")
        f.Name = "ECLIPSE_HUBChamsHolder"
        f.Parent = parent
    end
    _ChamsHolder = f
    return f
end

local function _destroyChamsFor(plr)
    local data = ChamsData[plr]
    if not data then return end
    if data.main then pcall(function() data.main:Destroy() end) end
    if data.glow then pcall(function() data.glow:Destroy() end) end
    if data.boxes then
        for _, b in pairs(data.boxes) do pcall(function() b:Destroy() end) end
        data.boxes = nil
    end
    ChamsData[plr] = nil
end

local function _chamsPartIncluded(part)
    if not part or not part:IsA("BasePart") then return false end

    if part.Name == "HumanoidRootPart" then return false end
    local parent = part.Parent
    if parent and parent:IsA("Accessory") then return false end
    if part.Transparency >= 1 then return false end
    return true
end

local function _getChamsData(plr, holder)
    local data = ChamsData[plr]
    if not data then
        data = { boxes = {} }
        ChamsData[plr] = data
    end
    data.boxes = data.boxes or {}

    if data.main then pcall(function() data.main:Destroy() end); data.main = nil end
    if data.glow then pcall(function() data.glow:Destroy() end); data.glow = nil end
    return data
end

function updateChams()

    local on = Config.GlobalEnable and Config.ESP.Enabled and Config.ESP.Chams
    if not on then
        for plr, _ in pairs(ChamsData) do _destroyChamsFor(plr) end
        return
    end

    local holder = _getChamsHolder()
    if not ES152.tick("Chams.scan", 0.15) then return end

    local baseColor = Config.ESP.ChamsColor or Color3.fromRGB(255, 60, 60)
    local visColor  = Config.ESP.VisibleChamsColor or baseColor
    local invColor  = Config.ESP.InvisibleChamsColor or baseColor

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            if IsAlly(plr) and not (PresenceUsers and PresenceUsers[plr.UserId]) then
                _destroyChamsFor(plr)
            else
                local char = plr.Character
                local hum  = char and char:FindFirstChildOfClass("Humanoid")
                if not char or not char.Parent or not hum or hum.Health <= 0 then
                    _destroyChamsFor(plr)
                else
                    local data = _getChamsData(plr, holder)
                    local col = baseColor
                    if Config.ESP.VisibleCheck then
                        local head = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
                        local vis = head and IsVisible(head)
                        col = vis and visColor or invColor
                    end

                    local seen = {}
                    for _, part in ipairs(char:GetDescendants()) do
                        if _chamsPartIncluded(part) then
                            seen[part] = true
                            local box = data.boxes[part]
                            if not box or not box.Parent then
                                box = Instance.new("BoxHandleAdornment")
                                box.Name = "ECLIPSE_HUBChamsBox"
                                box.AlwaysOnTop = true
                                box.ZIndex = 5
                                box.Transparency = 0.35
                                box.Parent = holder
                                data.boxes[part] = box
                            end
                            pcall(function()
                                box.Adornee = part
                                box.Size    = part.Size
                                box.Color3  = col
                            end)
                        end
                    end

                    for part, box in pairs(data.boxes) do
                        if not seen[part] then
                            pcall(function() box:Destroy() end)
                            data.boxes[part] = nil
                        end
                    end
                end
            end
        end
    end

    for plr, _ in pairs(ChamsData) do
        if not plr.Parent then _destroyChamsFor(plr) end
    end
end

