    ----------------------------------------------------------------
    local ScopeLines = { hL = nil, hR = nil, vT = nil, vB = nil }
    local function ensureScopeLines()
        if ScopeLines.hL then return end
        for _, key in ipairs({"hL", "hR", "vT", "vB"}) do
            local l = Drawing.new("Line")
            l.Visible = false
            l.Thickness = 1
            l.Color = Color3.new(0, 0, 0)
            l.Transparency = 1
            ScopeLines[key] = l
        end
    end
    local function hideScopeLines()
        for _, key in ipairs({"hL", "hR", "vT", "vB"}) do
            if ScopeLines[key] then ScopeLines[key].Visible = false end
        end
    end
    local function isScopedNow()
        local cam = Workspace.CurrentCamera
        if not cam then return false end
        if cam.FieldOfView < 55 then return true end
        local ok, IC = pcall(function()
            return require(ReplicatedStorage.Controllers.InventoryController)
        end)
        if ok and IC then
            local w = IC.getCurrentEquipped and IC.getCurrentEquipped()
            if w then
                if w.IsAiming or w.Aiming or w.Scoped then return true end
                local props = w.Properties
                if props and (props.HasScope or props.AimingOptions == "SniperScope") then
                    if w.IsAiming == true or (cam.FieldOfView < 60) then return true end
                end
            end
        end
        return false
    end
