    MoveAdv:AddSlider("PixelSurfStrength", { Text = "PIXEL SURF STRENGTH", Default = 0.35, Min = 0.1, Max = 1, Rounding = 2 })

    local edgeCooldown, jumpBugCooldown = 0, 0
    RunService.Heartbeat:Connect(function(dt)
        pcall(function()
            local char = LP.Character
            if not char then return end
            local root = char:FindFirstChild("HumanoidRootPart")
            local hum = char:FindFirstChildOfClass("Humanoid")
            if not root or not hum then return end
            local vel = root.AssemblyLinearVelocity
            local now = tick()

            -- Edge bug: cancel downward velocity near ledge lip
            if Toggles.EdgeBug and Toggles.EdgeBug.Value and now > edgeCooldown then
                if vel.Y < -8 and vel.Y > -55 then
                    local rp = RaycastParams.new()
                    rp.FilterDescendantsInstances = {char}
                    rp.FilterType = Enum.RaycastFilterType.Exclude
                    local down = Workspace:Raycast(root.Position, Vector3.new(0, -3.2, 0), rp)
                    local ahead = Workspace:Raycast(root.Position + root.CFrame.LookVector * 1.1, Vector3.new(0, -4, 0), rp)
                    if down and not ahead then
                        root.AssemblyLinearVelocity = Vector3.new(vel.X * 1.02, math.max(vel.Y * 0.15, -4), vel.Z * 1.02)
                        edgeCooldown = now + 0.12
                    end
                end
            end

            -- Jump bug: micro crouch-stand to clip jump height on space edge
            if Toggles.JumpBug and Toggles.JumpBug.Value and now > jumpBugCooldown then
                if UserInputService:IsKeyDown(Enum.KeyCode.Space) and vel.Y > 2 and vel.Y < 40 then
                    pcall(function()
                        hum:ChangeState(Enum.HumanoidStateType.Jumping)
                    end)
                    jumpBugCooldown = now + 0.18
                end
            end

            -- Pixel surf: stick to thin surfaces / maintain horizontal while barely grounded
            if Toggles.PixelSurf and Toggles.PixelSurf.Value then
                local rp = RaycastParams.new()
                rp.FilterDescendantsInstances = {char}
                rp.FilterType = Enum.RaycastFilterType.Exclude
