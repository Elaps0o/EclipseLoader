            spark.CanCollide = false
            spark.Material = Enum.Material.Neon
            spark.Color = tracerColor:Lerp(Color3.new(1,1,1), 0.4)
            spark.Transparency = 0.1
            spark.CFrame = CFrame.new(startPos:Lerp(endPos, i / 4))
            spark.Parent = Workspace
            parts[#parts+1] = spark
        end
    elseif style == "Ghost" then
        parts[#parts+1] = makeCore(baseTh * 0.9, Enum.Material.ForceField, 0.45, tracerColor)
        local g = makeCore(baseTh * 1.6, Enum.Material.ForceField, 0.8, tracerColor)
        parts[#parts+1] = g
    else -- Beam Thin (default premium)
        parts[#parts+1] = makeCore(baseTh * 0.6, Enum.Material.Neon, 0.03, tracerColor)
        local g = makeCore(baseTh * 1.35, Enum.Material.Neon, 0.68, tracerColor)
        parts[#parts+1] = g
    end

    task.spawn(function()
        local t0 = tick()
        while tick() - t0 < duration do
            local a = (tick() - t0) / duration
