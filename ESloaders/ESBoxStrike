    local bodyOrig = {}
    local bodyCurrent = 0 -- 0 = opaque, 1 = fully at target transparency
    RunService.RenderStepped:Connect(function(dt)
        pcall(function()
            local char = LP.Character
            if not char then
                bodyCurrent = 0
                return
            end
            local bodyOn = Toggles.AimBodyTransparent and Toggles.AimBodyTransparent.Value
            local aiming = isLocalAiming()
            local tpOn = Toggles.ThirdPerson and Toggles.ThirdPerson.Value
            local alsoTP = not (Toggles.AimBodyInThirdPerson and Toggles.AimBodyInThirdPerson.Value == false)
            -- active when: feature on AND (aiming OR third person with alsoTP)
            local want = bodyOn and (aiming or (tpOn and alsoTP))
            local tVal = Options.AimBodyTransparency and Options.AimBodyTransparency.Value or 0.85
            local speed = 8
            local target = want and 1 or 0
            -- smooth transition
            local step = math.clamp(dt * speed, 0, 1)
            if bodyCurrent < target then
                bodyCurrent = math.min(bodyCurrent + step, target)
            elseif bodyCurrent > target then
                bodyCurrent = math.max(bodyCurrent - step, target)
            end
            local applied = tVal * bodyCurrent
            for _, p in ipairs(char:GetDescendants()) do
                if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then
                    if bodyCurrent > 0.001 and bodyOn then
                        if bodyOrig[p] == nil then bodyOrig[p] = p.LocalTransparencyModifier end
                        p.LocalTransparencyModifier = applied
                    elseif bodyOrig[p] ~= nil then
