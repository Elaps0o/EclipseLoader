                    playSound(Options.HVH_HitSnd.Value, Options.HVH_HitVol.Value, Options.HVH_HitPitch.Value)
                end
            end
        end)
        return true
    end

    local function tick_autoshoot()
        if not (Toggles.HVH_AutoKill and Toggles.HVH_AutoKill.Value) then return end
        if type(_ECLIPSE_HUB_AllowIC) == "function" then pcall(_ECLIPSE_HUB_AllowIC) end
        local now = tick()
        if now < nextShotAllowed then return end
        if akIsReloading then return end
        local id, wn = getWeaponIdAndName()
        if not id then return end

        local eq = (type(_ECLIPSE_HUB_GetEquipped) == "function") and _ECLIPSE_HUB_GetEquipped() or nil
        if not eq then return end
        local rounds = tonumber(rawget(eq, "Rounds") or eq.Rounds)
        if not rounds then return end
        if rounds <= 0 then return end
        local stats = WeaponDB[wn]
        local fireRate = (stats and stats.FR) or 0.12

        local pl, part = findBest()
        if not pl or not part then return end

        if not (Toggles.HVH_AK_Silent and Toggles.HVH_AK_Silent.Value) then
            local cam = Workspace.CurrentCamera
            if cam then cam.CFrame = CFrame.new(cam.CFrame.Position, part.Position) end
        end

        if fireShot(part, pl) then
            nextShotAllowed = now + fireRate
        end
    end

