    local ChinaHats = {} -- [char] = {lines}
    local function clearHat(char)
        local pack = ChinaHats[char]
        if pack then
            for _, l in ipairs(pack) do pcall(function() l:Remove() end) end
            ChinaHats[char] = nil
        end
    end
    local function drawHat(char)
        local head = char:FindFirstChild("Head")
        if not head then clearHat(char); return end
        local cam = Workspace.CurrentCamera
        if not cam then return end
        local size = Options.ChinaHatSize and Options.ChinaHatSize.Value or 1
        local col = Options.ChinaHatColor and Options.ChinaHatColor.Value or Color3.fromRGB(220, 220, 220)
        local n = 12
        local radius = 1.15 * size
        local height = 0.55 * size
        local top = head.Position + Vector3.new(0, 0.85 * size, 0)
        local pts = {}
        for i = 1, n do
            local a = (i / n) * math.pi * 2
            pts[i] = top + Vector3.new(math.cos(a) * radius, -height, math.sin(a) * radius)
        end
        if not ChinaHats[char] then
            ChinaHats[char] = {}
            for i = 1, n * 2 do
                local l = Drawing.new("Line")
                l.Thickness = 1.2
                l.Color = col
                l.Visible = false
                ChinaHats[char][i] = l
            end
        end
        local lines = ChinaHats[char]
        for i = 1, n do
            local a, b = pts[i], pts[(i % n) + 1]
            local sa, oa = cam:WorldToViewportPoint(a)
            local sb, ob = cam:WorldToViewportPoint(b)
            local st, ot = cam:WorldToViewportPoint(top)
            local rim = lines[i]
            local spoke = lines[n + i]
            if oa and ob and sa.Z > 0 and sb.Z > 0 then
                rim.From = Vector2.new(sa.X, sa.Y)
                rim.To = Vector2.new(sb.X, sb.Y)
                rim.Color = col
                rim.Visible = true
            else
                rim.Visible = false
            end
            if oa and ot and sa.Z > 0 and st.Z > 0 then
                spoke.From = Vector2.new(sa.X, sa.Y)
                spoke.To = Vector2.new(st.X, st.Y)
                spoke.Color = col
                spoke.Visible = true
            else
                spoke.Visible = false
            end
        end
    end

