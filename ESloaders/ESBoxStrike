-- Resolve the live position every frame (never cached), exactly like player ESP.
function liveWorldPivot(inst, kind)
    local cached = WorldEspPivotPart[inst]
    if cached and cached.Parent then return cached.Position, cached.Size end
    if kind == "bomb" then
        local part = findBombPivotPart(inst)
        if part then
            WorldEspPivotPart[inst] = part
            return part.Position, part.Size
        end
    end
    if inst:IsA("BasePart") then
        WorldEspPivotPart[inst] = inst
        return inst.Position, inst.Size
    end
    if inst:IsA("Model") then
        if inst.PrimaryPart then
            WorldEspPivotPart[inst] = inst.PrimaryPart
            return inst.PrimaryPart.Position, inst.PrimaryPart.Size
        end
        local ok, cf, sz = pcall(function() return inst:GetBoundingBox() end)
        if ok and cf then return cf.Position, sz end
    end
    if inst:IsA("Folder") then
        local sum, n = Vector3.new(), 0
        for _, ch in ipairs(inst:GetChildren()) do
            if ch:IsA("BasePart") then sum = sum + ch.Position; n = n + 1 end
        end
        if n > 0 then return sum / n, Vector3.new(6, 6, 6) end
    end
    return nil
end

-- Slow pass: discover/classify items in Debris.
function scanWorldESP()
    local debris = Workspace:FindFirstChild("Debris")
    if not debris then WorldEspTracked = {}; return end
    local fresh = {}
    for _, child in ipairs(debris:GetChildren()) do
        local info = classifyDebrisItem(child)
        if info then fresh[#fresh + 1] = { inst = child, info = info } end
    end
    WorldEspTracked = fresh
end

-- Fast pass: runs EVERY frame so markers stick to the world like player ESP.
function updateWorldESP()
    if not Config.GlobalEnable or not (Config.ESP.WorldBomb or Config.ESP.WorldWeapons or Config.ESP.WorldMolotov or Config.ESP.WorldSmoke) then
        for _, e in pairs(WorldEspPool) do hideWorldEntry(e) end
        WorldEspTracked = {}
        return
    end
    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then
        for _, e in pairs(WorldEspPool) do hideWorldEntry(e) end
        return
    end

    if ES152.tick("WorldESP.scan", 0.25) then scanWorldESP() end

    local debrisRef = Workspace:FindFirstChild("Debris")
    WorldEspSeen = {}

    for _, item in ipairs(WorldEspTracked) do
        local child, info = item.inst, item.info
        if child and child.Parent and debrisRef and child:IsDescendantOf(debrisRef) then
            local pos = liveWorldPivot(child, info.kind)
            if pos then
                WorldEspSeen[child] = true
                local e = getWorldEspEntry(child)
                local sp, on = Camera:WorldToViewportPoint(pos)
                if on then
                    local dist = (myRoot.Position - pos).Magnitude
                    local s = math.clamp(260 / math.max(1, dist), 10, 30)
                    local bx, by = sp.X - s/2, sp.Y - s/2

                    local fade = math.clamp(1 - (dist - 40) / math.max(1, (Config.ESP.MaxDistance or 500) - 40), 0.55, 1)

                    local pulse = 1
                    if info.kind == "bomb"    then pulse = 0.75 + 0.25 * math.sin(tick() * 6)
                    elseif info.kind == "molotov" then pulse = 0.80 + 0.20 * math.sin(tick() * 3)
                    elseif info.kind == "smoke"   then pulse = 0.85 + 0.15 * math.sin(tick() * 2) end

                    local isGrenade = (info.kind == "smoke" or info.kind == "molotov")

                    if e.Fill then e.Fill.Visible = false end
                    if isGrenade then
                        e.Box.Visible = false
                        e.Dot.Visible = false
                        e.Tag.Visible = false
                        if e.WeaponIcon then pcall(function() e.WeaponIcon.Visible = false end) end
                    else
                        e.Box.Size = Vector2.new(s, s)
                        e.Box.Position = Vector2.new(bx, by)
                        e.Box.Color = info.color
                        e.Box.Transparency = fade * pulse
                        e.Box.Visible = true
                        e.Dot.Position = Vector2.new(sp.X, sp.Y)
                        e.Dot.Color = info.color
                        e.Dot.Transparency = fade * pulse
                        e.Dot.Visible = true
                        e.Tag.Text = string.format("%s  [%dm]", info.label, math.floor(dist))
                        e.Tag.Color = info.color
                        e.Tag.Transparency = fade
                        e.Tag.Position = Vector2.new(sp.X, by - 18)
                        e.Tag.Visible = true

                        local iconAsset = nil
                        if info.kind == "weapon" and info.weapon and type(_espIconAssetForWeapon) == "function" then
                            local okI, a = pcall(_espIconAssetForWeapon, info.weapon)
                            if okI then iconAsset = a end
                        end
                        if iconAsset and type(_ensureESPWeaponIcon) == "function" then
                            local img = _ensureESPWeaponIcon(e)
                            if img then
                                local isz = math.clamp(s * 1.3, 18, 42)
                                pcall(function()
                                    if img.Image ~= iconAsset then img.Image = iconAsset end
                                    img.Size = UDim2.fromOffset(isz, isz)
                                    img.Position = UDim2.fromOffset(sp.X - isz / 2, (by - 18) - 9 - isz)
                                    img.ImageColor3 = info.color
                                    img.ImageTransparency = 1 - fade
                                    img.Visible = true
                                end)
                            end
                        elseif e.WeaponIcon then
                            pcall(function() e.WeaponIcon.Visible = false end)
                        end
                    end

                    if e.Timer then e.Timer.Visible = false end
                else
                    hideWorldEntry(e)
                end
            end
        end
    end

    for inst, e in pairs(WorldEspPool) do
        local alive = inst.Parent ~= nil and debrisRef and (inst.Parent == debrisRef or inst:IsDescendantOf(debrisRef))
        if not WorldEspSeen[inst] or not alive then
            hideWorldEntry(e)
            if not alive then
                pcall(function() e.Tag:Remove() end); pcall(function() e.Box:Remove() end); pcall(function() if e.Fill then e.Fill:Remove() end end); pcall(function() if e.Dot then e.Dot:Remove() end end); pcall(function() if e.Timer then e.Timer:Remove() end end)
                pcall(function() if e.WeaponIcon then e.WeaponIcon:Destroy() end end)
                WorldEspPool[inst] = nil
                WorldEspPivotPart[inst] = nil
                WorldGrenadeFirstSeen[inst] = nil
            end
        end
    end
end

