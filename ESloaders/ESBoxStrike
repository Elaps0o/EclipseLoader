        if character:GetAttribute("ClientCharacterPresentationVisible") == false then return false end
        local origin = localPosition()
        if not origin then return false end
        local pvs = pvsAllows(origin, point)
        if pvs == true then return true end
        -- The new PVS classifier explicitly asks for runtime proof here.
        return runtimeOcclusion(origin, point, character)
    end

    G.__eclipse_visibility = Visibility

    local function currentWeapon()
