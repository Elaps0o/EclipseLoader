        if not bomb then return nil end
        local attrs = {"ExplodeTime","ExplosionTime","DetonationTime","DetonateTime","ExplodesAt","DetonatesAt","EndTime","TimeLeft","RemainingTime","BombTimeLeft","FuseRemaining","Countdown"}
        local now = c4ServerNow()
        for _, a in ipairs(attrs) do
            local v = bomb:GetAttribute(a)
            if type(v) == "number" then
                if v > 1000 then return math.max(0, v - now) end
                if v >= 0 and v <= 90 then return v end
            end
        end
        return nil
    end
