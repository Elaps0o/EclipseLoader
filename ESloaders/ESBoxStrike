    ----------------------------------------------------------------
    -- THIRD PERSON: camera offset + persistent viewmodel hide
    ----------------------------------------------------------------
    RunService.RenderStepped:Connect(function()
        pcall(function()
            if not (Toggles.ThirdPerson and Toggles.ThirdPerson.Value) then return end
            local cam = Workspace.CurrentCamera
            local char = LP.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            if not cam or not root then return end
            local dist = Options.ThirdPersonDist and Options.ThirdPersonDist.Value or 8
            local ox = Options.ThirdPersonOffsetX and Options.ThirdPersonOffsetX.Value or 1.5
            local oy = Options.ThirdPersonOffsetY and Options.ThirdPersonOffsetY.Value or 1.0
            local look = cam.CFrame.LookVector
            local right = cam.CFrame.RightVector
            -- soft orbit behind player with offset
            local target = root.Position - look * dist + right * ox + Vector3.new(0, oy, 0)
            local current = cam.CFrame.Position
            local blended = current:Lerp(target, 0.35)
            cam.CFrame = CFrame.lookAt(blended, blended + look)

            -- hide viewmodel persistently
            if Toggles.ThirdPersonHideVM and Toggles.ThirdPersonHideVM.Value then
                for _, child in ipairs(cam:GetChildren()) do
                    if child:IsA("Model") then
                        for _, p in ipairs(child:GetDescendants()) do
                            if p:IsA("BasePart") then
                                p.LocalTransparencyModifier = 1
                            end
                        end
                    end
                end
            end

            -- custom player model force-visible
            local mode = Options.CustomPlayerModel and Options.CustomPlayerModel.Value or "Off"
            if mode ~= "Off" and char then
                for _, p in ipairs(char:GetDescendants()) do
                    if p:IsA("BasePart") then
                        p.LocalTransparencyModifier = 0
                        if p.Transparency > 0.85 then p.Transparency = 0 end
                    end
                end
            end
        end)
    end)

