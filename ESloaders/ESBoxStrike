    local function runtimeOcclusion(origin, point, character)
        if typeof(origin) ~= "Vector3" or typeof(point) ~= "Vector3" then return false end
        local params = rayParams()
        local ray = Workspace:Raycast(origin, point - origin, params)
        return ray and ray.Instance and character and ray.Instance:IsDescendantOf(character) or false
    end

