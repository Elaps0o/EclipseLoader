    local _bundleCache = {}
    local function _fetchBundle(bundleId)
        if not bundleId then return nil end
        if _bundleCache[bundleId] then return _bundleCache[bundleId] end
        local out = { body = {}, accessories = {}, all = {} }
        local ok, details = pcall(function() return AssetService:GetBundleDetailsAsync(bundleId) end)
        if not ok or type(details) ~= "table" then _bundleCache[bundleId] = out; return out end
        for _, item in ipairs(details.Items or {}) do
            if item.Type == "Asset" and item.Id then
                out.all[#out.all+1] = item.Id
                local ok2, info = pcall(function() return MarketplaceSvc:GetProductInfo(item.Id) end)
                if ok2 and type(info) == "table" then
                    local t = tonumber(info.AssetTypeId)
                    if BODY_TYPE_FIELDS[t] then
                        out.body[BODY_TYPE_FIELDS[t]] = item.Id
                    elseif ACC_TYPE_FIELDS[t] then
                        local f = ACC_TYPE_FIELDS[t]
                        out.accessories[f] = out.accessories[f] or {}
                        table.insert(out.accessories[f], item.Id)
                    end
                end
            end
        end
        _bundleCache[bundleId] = out
        return out
    end

