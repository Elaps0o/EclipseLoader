    local function _charPlayerFromAny(obj, depth)
        depth = depth or 0
        if depth > 3 or obj == nil then return nil, nil end
        if typeof(obj) == "Instance" then
            if obj:IsA("Player") then return obj.Character, obj end
            local model = obj:IsA("Model") and obj or obj:FindFirstAncestorOfClass("Model")
            if model then
                local plr = Players:GetPlayerFromCharacter(model)
                if plr then return model, plr end
                local byName = Players:FindFirstChild(model.Name)
                if byName and byName:IsA("Player") then return model, byName end
            end
        elseif type(obj) == "table" then
            for _, key in ipairs({"Player","player","Victim","victim","Character","character","Model","model","Target","target","Killer","killer","Attacker","attacker","Creator","creator"}) do
                local ch, pl = _charPlayerFromAny(rawget(obj, key), depth + 1)
                if pl then return ch, pl end
            end
        elseif type(obj) == "string" then
            local plr = Players:FindFirstChild(obj)
            if plr and plr:IsA("Player") then return plr.Character, plr end
        elseif type(obj) == "number" then
