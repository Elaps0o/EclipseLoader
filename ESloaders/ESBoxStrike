    local function project(world)
        if not (pcam and viewport) then return nil end
        local rel = pcam.CFrame:PointToObjectSpace(world)
        if rel.Z > -0.05 then return nil end
        local sz = viewport.AbsoluteSize
        if sz.X < 2 or sz.Y < 2 then return nil end
        local tan = math.tan(math.rad(pcam.FieldOfView) * 0.5)
        local aspect = sz.X / sz.Y
        local x = ((rel.X / (-rel.Z)) / (tan * aspect)) * 0.5 + 0.5
        local y = 0.5 - ((rel.Y / (-rel.Z)) / tan) * 0.5
        return Vector2.new(x * sz.X, y * sz.Y)
    end

    local function findRigSource()
        for _, p in ipairs(PlayersS:GetPlayers()) do
            if p ~= LP and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                return p.Character, p.Name
            end
        end
        if LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then
            return LP.Character, LP.Name
        end
        return nil, nil
    end

    local function buildRig()
        if rig then rig:Destroy() rig = nil end
        local src, nm = findRigSource()
        if not src then return end
        local clone
        local ok = pcall(function()
            local prev = {}
            for _, d in ipairs(src:GetDescendants()) do
                if not d.Archivable then prev[d] = true; d.Archivable = true end
            end
            src.Archivable = true
            clone = src:Clone()
            for d in pairs(prev) do if d and d.Parent then d.Archivable = false end end
        end)
        if not ok or not clone then return end
        PV.rigName = nm or "PREVIEW"
        local WEP_POOL = { "AK-47", "M4A1", "AWP", "Glock", "Deagle", "MP5", "Famas", "Scout", "USP", "Vector" }
        PV.fakeWeapon = WEP_POOL[math.random(1, #WEP_POOL)]
        PV.wepIconAsset = nil
        PV.fakeDist = math.random(8, 42)
        for _, d in ipairs(clone:GetDescendants()) do
            if d:IsA("BasePart") then
                d.CanCollide = false
                d.Massless = true
                d.CanQuery = false
                d.CanTouch = false
            elseif d:IsA("ForceField") or d:IsA("Highlight") or d:IsA("BillboardGui") or d:IsA("Sound") then
                d:Destroy()
            elseif d:IsA("Script") or d:IsA("LocalScript") then
                d:Destroy()
            end
        end
        local root0 = clone:FindFirstChild("HumanoidRootPart")
        if root0 then clone.PrimaryPart = root0 end
        clone.Parent = wm
        pcall(function() clone:PivotTo(CFrame.new(0, 0, 0)) end)
        hum = clone:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
            hum.BreakJointsOnDeath = false
            hum.Health = hum.MaxHealth
        end
        PV.track = nil
        local function freezePose()
            if not clone or not clone.Parent then return end
            pcall(function()
                for _, d in ipairs(clone:GetDescendants()) do
                    if d:IsA("Animator") then
                        for _, t in ipairs(d:GetPlayingAnimationTracks()) do pcall(function() t:Stop(0) end) end
                        d:Destroy()
                    elseif d:IsA("Animation") or d:IsA("AnimationController") then
                        d:Destroy()
                    end
                end
                for _, d in ipairs(clone:GetDescendants()) do
                    if d:IsA("Motor6D") then d.Transform = CFrame.new() end
                end
            end)
        end
        freezePose()
        task.delay(0.15, freezePose)
        task.delay(0.5, freezePose)
        rig = clone
        PV.hl = nil
    end

    PV.chams = PV.chams or {}
    local function clearPreviewChams()
        for part, shell in pairs(PV.chams) do
