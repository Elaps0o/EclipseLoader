local function _walkControlGui(obj, fn, seen, depth)
    if not obj or type(fn) ~= "function" then return end
    seen = seen or {}
    depth = depth or 0
    if depth > 4 or seen[obj] then return end
    seen[obj] = true
    if typeof(obj) == "Instance" then
        if obj:IsA("GuiObject") then pcall(fn, obj) end
        return
    end
    if type(obj) ~= "table" then return end

    local inst = rawget(obj, "Instance")
    if typeof(inst) == "Instance" and inst:IsA("GuiObject") then pcall(fn, inst) end

    local items = rawget(obj, "Items")
    if type(items) == "table" then
        for _, v in pairs(items) do _walkControlGui(v, fn, seen, depth + 1) end
    end

    local nl = rawget(obj, "_nl")
    if type(nl) == "table" then _walkControlGui(nl, fn, seen, depth + 1) end
end

local function _setControlVisible(nlObj, visible)
    local did = false
    pcall(function()
        if nlObj and type(nlObj.SetVisibility) == "function" then
            nlObj:SetVisibility(visible)
            did = true
        end
    end)
    if did then return end
    _walkControlGui(nlObj, function(gui) gui.Visible = visible and true or false end)
end

local function _setControlDisabled(nlObj, disabled)
    disabled = disabled and true or false
    _walkControlGui(nlObj, function(gui)
        pcall(function()
            if gui:IsA("GuiButton") then
                gui.Interactable = not disabled
                gui.AutoButtonColor = not disabled
            end
        end)
    end)

end

local _ECLIPSE_HUBInlineCounts = setmetatable({}, { __mode = "k" })
local function _findNLToggleRow(nlToggle)
    local sec = nlToggle and rawget(nlToggle, "Section")
    local items = sec and rawget(sec, "Items")
    local content = items and items.Content and items.Content.Instance
    if not (typeof(content) == "Instance") then return nil, nil end
    local wanted = tostring((nlToggle and nlToggle.Name) or "")
    for _, d in ipairs(content:GetDescendants()) do
        if d:IsA("TextLabel") and d.Text == wanted then
            local row = d.Parent
            while row and row ~= content and not row:IsA("GuiButton") do row = row.Parent end
            if row and row ~= content then return row, d end
        end
    end
    return nil, nil
end

function _ECLIPSE_HUB_TrackColorPopup(cp, slot)
    if type(cp) ~= "table" or typeof(slot) ~= "Instance" then return end
    local pops = {}
    local function consider(v)
        if typeof(v) == "Instance" and v:IsA("GuiObject") and not v:IsDescendantOf(slot) and v ~= slot then
            pops[#pops + 1] = v
        end
    end
    for _, v in pairs(cp) do
        consider(v)
        if type(v) == "table" then consider(rawget(v, "Instance")) end
    end
    if #pops == 0 then return end

    local function place(pop)
        pcall(function()
            if not pop.Parent then return end
            local par = pop.Parent
            local base = (par:IsA("GuiObject") and par.AbsolutePosition) or Vector2.new(0, 0)
            local sp, ss = slot.AbsolutePosition, slot.AbsoluteSize
            local w, h = pop.AbsoluteSize.X, pop.AbsoluteSize.Y
            local cam = workspace.CurrentCamera
            local vp = (cam and cam.ViewportSize) or Vector2.new(1280, 720)

            local x = sp.X + ss.X * 0.5 - w * 0.5
            local y = sp.Y - h - 6
            if y < 4 then y = sp.Y + ss.Y + 6 end
            if x < 4 then x = 4 end
            if x + w > vp.X - 4 then x = vp.X - w - 4 end

            pop.AnchorPoint = Vector2.new(0, 0)
            pop.Position = UDim2.fromOffset(math.floor(x - base.X), math.floor(y - base.Y))
            pop.ZIndex = 5000
            for _, d in ipairs(pop:GetDescendants()) do
                if d:IsA("GuiObject") then d.ZIndex = math.max(d.ZIndex, 5001) end
            end
        end)
    end

    for _, pop in ipairs(pops) do
        connectSignal(pop:GetPropertyChangedSignal("Visible"):Connect(function()
            if pop.Visible then
                task.defer(function() place(pop) end)
            end
        end))
        if pop.Visible then task.defer(function() place(pop) end) end
    end
end


