    RunService.Heartbeat:Connect(function()
        pcall(function()
            if not (Toggles.AutoStrafeEnabled and Toggles.AutoStrafeEnabled.Value) then return end
            local char = LP.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if not root or not hum then return end
            local state = hum:GetState()
            local inAir = state == Enum.HumanoidStateType.Freefall or state == Enum.HumanoidStateType.Jumping
            if not inAir then return end
            local mode = Options.AutoStrafeMode and Options.AutoStrafeMode.Value or "Camera"
            local speed = Options.AutoStrafeSpeed and Options.AutoStrafeSpeed.Value or 1.5
            local cam = Workspace.CurrentCamera
            if not cam then return end
            local look = cam.CFrame.LookVector
            local camFlat = Vector3.new(look.X, 0, look.Z)
            if camFlat.Magnitude < 0.05 then return end
            camFlat = camFlat.Unit
            local move = hum.MoveDirection
            local inputFlat = (move.Magnitude > 0.05) and Vector3.new(move.X, 0, move.Z) or nil
            local dir
            if mode == "Keys" then
                if not inputFlat or inputFlat.Magnitude < 0.05 then return end
                dir = inputFlat.Unit
            elseif mode == "Always" then
                dir = (inputFlat and inputFlat.Magnitude > 0.05) and inputFlat.Unit:Lerp(camFlat, 0.4).Unit or camFlat
            else -- Camera
                dir = (inputFlat and inputFlat.Magnitude > 0.05) and camFlat:Lerp(inputFlat.Unit, 0.35).Unit or camFlat
            end
            local vel = root.AssemblyLinearVelocity
            local horiz = Vector3.new(vel.X, 0, vel.Z)
            local targetSpeed = math.max(horiz.Magnitude, hum.WalkSpeed) * speed
            local newHoriz = dir * targetSpeed
            root.AssemblyLinearVelocity = Vector3.new(newHoriz.X, vel.Y, newHoriz.Z)
        end)
    end)

