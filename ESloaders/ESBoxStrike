function _EMT.set(name, state)
    if _EMT.btnState[name] == nil then return end
    _EMT.btnState[name] = state and true or false
    if state then _EMT.pulse[name] = tick() end
    _EMT.recompute()
end

function _EMT.recompute()
    local down = { Jump = false, Shoot = false, Aim = false }
    for _, name in pairs(_EMT.touches) do down[name] = true end
    local now = tick()
    for name in pairs(down) do
        if _EMT.btnState[name] then down[name] = true end
        if (now - (_EMT.pulse[name] or 0)) < 0.18 then down[name] = true end
    end
    _EMT.jumpDown = down.Jump
    _EMT.fireDown = down.Shoot
    _EMT.aimDown  = down.Aim
end

function _EMT.bind(name, btn)
    if not btn or _EMT.btnConns[btn] then return end
    local held = {}
    local conns = {}
    local function down(input)
        if input then
            local t = input.UserInputType
            if t ~= Enum.UserInputType.Touch and t ~= Enum.UserInputType.MouseButton1 then return end
            held[input] = true
        else
            held.__mouse = true
        end
        _EMT.set(name, true)
    end
    local function up(input)
        if input then held[input] = nil else held.__mouse = nil end
        if next(held) == nil then _EMT.set(name, false) else _EMT.pulse[name] = tick() end
    end
    pcall(function() conns[#conns+1] = btn.InputBegan:Connect(down) end)
    pcall(function() conns[#conns+1] = btn.InputEnded:Connect(up) end)
    pcall(function()
        if btn:IsA("GuiButton") then
            conns[#conns+1] = btn.MouseButton1Down:Connect(function() down(nil) end)
            conns[#conns+1] = btn.MouseButton1Up:Connect(function() up(nil) end)
            conns[#conns+1] = btn.MouseLeave:Connect(function() up(nil) end)
        end
    end)
    pcall(function()
        conns[#conns+1] = btn.AncestryChanged:Connect(function()
            if not btn.Parent then
                held = {}
                _EMT.btnConns[btn] = nil
                _EMT.set(name, false)
            end
        end)
    end)
    _EMT.btnConns[btn] = conns
end

