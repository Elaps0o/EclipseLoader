function ApplyWeatherSpeed()
    local sp = tonumber(Config and Config.World and Config.World.WeatherSpeed) or 0
    sp = math.clamp(sp, 0, 5)
    local mult = 1 + sp
    if not (WeatherPart and WeatherPart.Parent) then return end
    for _, em in ipairs(WeatherPart:GetChildren()) do
        if em:IsA("ParticleEmitter") then
            pcall(function()
                if em:GetAttribute("ECL_BaseRate") == nil then
                    em:SetAttribute("ECL_BaseRate", em.Rate)
