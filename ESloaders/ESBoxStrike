function ensureESPArrow(data)
    if not data or data.Arrow then return data and data.Arrow end
    if data.ArrowTried then return nil end
    data.ArrowTried = true
    local ok, arrow = pcall(function() return Drawing.new("Triangle") end)
    if not ok or not arrow then return nil end
    arrow.Thickness=1; arrow.Filled=true; arrow.Transparency=1; arrow.Visible=false
    data.Arrow = arrow
    return arrow
end

function hideESP(data)
    for _, l in pairs(data.CornerLines) do l.Visible = false end
    if data.BoxGlow then for _, l in pairs(data.BoxGlow) do l.Visible = false end end
    for _, l in pairs(data.HealthSegments) do l.Visible = false end
    if data.HealthTicks then for _, l in pairs(data.HealthTicks) do l.Visible = false end end
    if data.Skeleton then for _, l in pairs(data.Skeleton) do l.Visible = false end end
    if data.ChinaHat then for _, l in pairs(data.ChinaHat) do l.Visible = false end end
    data.NameTag.Visible=false; data.DistTag.Visible=false
    data.HealthBg.Visible=false; data.HealthFill.Visible=false; data.HealthText.Visible=false
    data.Presence.Visible=false
    if data.WeaponTag then data.WeaponTag.Visible=false end
    if data.HeadDot then data.HeadDot.Visible=false end
