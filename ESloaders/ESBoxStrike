    local function aliveCharacter(player)
        local character = resolvePlayerModel(player)
        if not character or not character.Parent then return nil end
        if character:GetAttribute("Dead") == true or character:GetAttribute("IsDead") == true then return nil end
        local health = tonumber(character:GetAttribute("Health"))
        if health ~= nil and health <= 0 then return nil end
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if humanoid and humanoid.Health <= 0 then return nil end
        return character
    end

    local function sameTeam(player)
        if not player or player == LocalPlayer then return true end
        if LocalPlayer.Team ~= nil and player.Team ~= nil then
            return LocalPlayer.Team == player.Team
        end
