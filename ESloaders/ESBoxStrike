    do
        local RunS    = game:GetService("RunService")
        local JOINT_C0 = setmetatable({}, { __mode = "k" })
        local JOINT_CACHE = setmetatable({}, { __mode = "k" })
        local HUM_AUTOROTATE = setmetatable({}, { __mode = "k" })
        local AA_STATE = { char = nil, yawMode = nil, pitchMode = nil, spin = nil, baseYaw = 0, yawRad = 0, lastT = nil }

        local function _findMotor(char, motorName)
            if not char then return nil end
            for _, d in ipairs(char:GetDescendants()) do
                if d:IsA("Motor6D") and d.Name == motorName then return d end
            end
            return nil
        end

        local function _collectJoints(char)
            if not char then return {} end
            local cached = JOINT_CACHE[char]
            if cached and cached._valid and cached._valid.Parent then return cached end
            local out = {}
            local neck = _findMotor(char, "Neck")
            if neck then table.insert(out, { m = neck, role = "neck", k = 1.00 }) end
            local waist = _findMotor(char, "Waist")
            if waist then table.insert(out, { m = waist, role = "waist", k = 0.34 }) end
            local ls = _findMotor(char, "LeftShoulder") or _findMotor(char, "Left Shoulder")
            local rs = _findMotor(char, "RightShoulder") or _findMotor(char, "Right Shoulder")
            if ls then table.insert(out, { m = ls, role = "arm", k = 0.20 }) end
            if rs then table.insert(out, { m = rs, role = "arm", k = 0.20 }) end
            out._valid = neck or waist or ls or rs
            JOINT_CACHE[char] = out
            return out
        end

        local function _rememberC0(m)
            if not m then return nil end
            if JOINT_C0[m] == nil then JOINT_C0[m] = m.C0 end
            return JOINT_C0[m]
        end

        local function _restoreJoints(char)
            if not char then return end
            for m, c0 in pairs(JOINT_C0) do
                if m and c0 and m.Parent and m:IsDescendantOf(char) then
                    pcall(function() m.C0 = c0 end)
                end
            end
        end

        local function _setAutoRotate(hum, enabled)
            if not hum then return end
            if HUM_AUTOROTATE[hum] == nil then HUM_AUTOROTATE[hum] = hum.AutoRotate end
            pcall(function() hum.AutoRotate = enabled end)
        end

        local function _restoreAutoRotate(hum)
            if not hum then return end
            local old = HUM_AUTOROTATE[hum]
            if old ~= nil then
                pcall(function() hum.AutoRotate = old end)
                HUM_AUTOROTATE[hum] = nil
            end
        end

        local function _flatYawFromCF(cf)
            local lv = cf.LookVector
            return math.atan2(-lv.X, -lv.Z)
        end

        local function _resetAAState(char, yawMode, pitchMode, spin, seedCF)
            local seedYaw = _flatYawFromCF(seedCF)
            AA_STATE.char = char
            AA_STATE.yawMode = yawMode
            AA_STATE.pitchMode = pitchMode
            AA_STATE.spin = spin
            AA_STATE.baseYaw = seedYaw
            AA_STATE.yawRad = seedYaw + ((yawMode == "Backward") and math.pi or 0)
            AA_STATE.lastT = tick()
        end

        local function _applyPitch(char, pitchMode, amount)
            amount = tonumber(amount) or 58
            if amount < 0 then amount = 0 end
            if amount > 80 then amount = 80 end
            if pitchMode ~= "Up" and pitchMode ~= "Down" or amount <= 0 then
                _restoreJoints(char)
                return
            end

            local sign = (pitchMode == "Up") and 1 or -1
            local rad = math.rad(amount) * sign
            for _, j in ipairs(_collectJoints(char)) do
                local m = j.m
                local base = _rememberC0(m)
                if m and base then
                    pcall(function()
                        m.C0 = base * CFrame.Angles(rad * (j.k or 1), 0, 0)
                    end)
                end
            end
        end

        local function _restoreCharacterAA(char)
            if not char then return end
            _restoreJoints(char)
            _restoreAutoRotate(char:FindFirstChildOfClass("Humanoid"))
        end

        connectSignal(RunS.RenderStepped:Connect(function()
            if not scriptRunning then return end
            local char = LocalPlayer and LocalPlayer.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if not (Toggles.HVH_AA and Toggles.HVH_AA.Value) then
                if char then pcall(function() _restoreCharacterAA(char) end) end
                AA_STATE.char = nil
                return
            end
            if not char then return end
            local hrp = char:FindFirstChild("HumanoidRootPart"); if not hrp then return end
            if not hum or hum.Health <= 0 or hum:GetState() == Enum.HumanoidStateType.Dead then
                pcall(function() _restoreCharacterAA(char) end)
                AA_STATE.char = nil
                return
            end

            local cam   = workspace.CurrentCamera
            local camCF = cam and cam.CFrame
            local seedCF = camCF or hrp.CFrame
            local rawYawMode = tostring(Options.HVH_YawMode.Value or "Forward")
            local yawMode = rawYawMode
            local pitchMode = tostring((Options.HVH_PitchMode and Options.HVH_PitchMode.Value) or "Neutral")
            if rawYawMode == "Up" or rawYawMode == "Down" then
                pitchMode = rawYawMode
                yawMode = "Forward"
            end
            if yawMode ~= "Forward" and yawMode ~= "Backward" and yawMode ~= "Freeze" then yawMode = "Forward" end
            if pitchMode ~= "Neutral" and pitchMode ~= "Up" and pitchMode ~= "Down" then pitchMode = "Neutral" end
            local spin = Toggles.HVH_SpinYaw and Toggles.HVH_SpinYaw.Value and yawMode ~= "Freeze"
            local spd = math.rad(tonumber(Options.HVH_SpinSpeed.Value) or 180)
            local amount = tonumber((Options.HVH_PitchAmount and Options.HVH_PitchAmount.Value) or 58) or 58

            pcall(function()
                local now = tick()
                if AA_STATE.char ~= char or AA_STATE.yawMode ~= yawMode or AA_STATE.pitchMode ~= pitchMode or AA_STATE.spin ~= spin then
                    _restoreJoints(char)
                    _resetAAState(char, yawMode, pitchMode, spin, seedCF)
                end
                local dt = math.max(0, math.min(0.10, now - (AA_STATE.lastT or now)))
                AA_STATE.lastT = now

                local yaw
                if yawMode == "Freeze" then
                    yaw = AA_STATE.baseYaw
                elseif spin then
                    AA_STATE.yawRad = (AA_STATE.yawRad or AA_STATE.baseYaw) + spd * dt
                    yaw = AA_STATE.yawRad
                else
                    yaw = AA_STATE.baseYaw + ((yawMode == "Backward") and math.pi or 0)
                end

                _setAutoRotate(hum, false)
                _applyPitch(char, pitchMode, amount)

                local pos = hrp.Position
                local lin = hrp.AssemblyLinearVelocity
                local ang = hrp.AssemblyAngularVelocity
                hrp.CFrame = CFrame.new(pos) * CFrame.Angles(0, yaw, 0)
                hrp.AssemblyLinearVelocity = lin
                hrp.AssemblyAngularVelocity = ang
                if cam and camCF then cam.CFrame = camCF end
                _G.__ECLIPSE_HUBAA = { mode = yawMode, pitch = pitchMode, spin = spin, yawRad = yaw }
            end)
        end))
    end

