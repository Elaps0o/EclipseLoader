-- AutoStop / QuickStop (ES-style)
do
    local function hasStopOpt(name)
        local v = Options.QuickStopOptions and Options.QuickStopOptions.Value
        if type(v) ~= "table" then return false end
        if v[name] == true then return true end
        for k, x in pairs(v) do
            if x == name or (x == true and k == name) then return true end
        end
        return false
    end
    local function doStop(root, hum)
        if not root then return end
        local vel = root.AssemblyLinearVelocity
        local horiz = Vector3.new(vel.X, 0, vel.Z)
        if horiz.Magnitude > 0.1 then
            root.AssemblyLinearVelocity = Vector3.new(0, vel.Y, 0)
            pcall(function() if hum then hum:MoveTo(root.Position) end end)
        end
    end
    RunService.Heartbeat:Connect(function()
        pcall(function()
            local char = LP.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if not root or not hum then return end
            local grounded = hum.FloorMaterial ~= Enum.Material.Air

            local qsOn = Toggles.QuickStop and Toggles.QuickStop.Value
            if qsOn then
                local kp = Options.QuickStopKey
                local held = true
                if kp and kp.Value and kp.Value ~= "None" and kp.Value ~= "Always" then
                    local ok, st = pcall(function() return kp:GetState() end)
                    held = ok and st == true
                end
                if held then
                    doStop(root, hum)
                    return
                end
            end

            local asOn = Toggles.AutoStop and Toggles.AutoStop.Value
            if not asOn then return end
            local kp = Options.AutoStopKey
            if kp and kp.Value and kp.Value ~= "None" and kp.Value ~= "Always" then
                local ok, st = pcall(function() return kp:GetState() end)
                if ok and st == false then return end
            end

            local isShooting = UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
            local enemyInFov = false
            if not isShooting then
                local cam = Workspace.CurrentCamera
                if cam then
                    local fov = (Options.SilentFovCircleRadius and Options.SilentFovCircleRadius.Value) or 150
                    local vp = cam.ViewportSize
                    local cx, cy = vp.X * 0.5, vp.Y * 0.5
                    local folder = Workspace:FindFirstChild("Characters")
                    local list = {}
                    if folder then
                        for _, m in ipairs(folder:GetChildren()) do
                            if m:IsA("Model") and m ~= char then list[#list+1] = m end
                        end
                    else
                        for _, pl in ipairs(Players:GetPlayers()) do
                            if pl ~= LP and pl.Character then list[#list+1] = pl.Character end
                        end
                    end
                    for _, m in ipairs(list) do
                        local h = m:FindFirstChildOfClass("Humanoid")
                        local hd = m:FindFirstChild("Head") or m:FindFirstChild("HumanoidRootPart")
                        if h and h.Health > 0 and hd then
                            local sp, on = cam:WorldToViewportPoint(hd.Position)
                            if on and sp.Z > 0 then
                                local dx, dy = sp.X - cx, sp.Y - cy
                                if (dx*dx + dy*dy) <= (fov*fov) then
                                    enemyInFov = true
                                    break
                                end
                            end
                        end
                    end
                end
            end

            if not (isShooting or enemyInFov) then return end
            local move = hum.MoveDirection
            local isMoving = move and move.Magnitude > 0
            local shouldStop = (not isMoving) or isShooting
            if hasStopOpt("Move Between Shots") and not isShooting and isMoving then
                shouldStop = false
            end
            local canStop = grounded or hasStopOpt("In Air")
            if hasStopOpt("On Land") and not grounded then canStop = false end
            if shouldStop and canStop then
                doStop(root, hum)
            end
        end)
    end)
end
-- Runtime / CharacterController bhop (MovementV2 ground-pulse)
do
    local CC, runtimeInst = nil, nil
    pcall(function()
        CC = require(ReplicatedStorage.Controllers.CharacterController)
    end)
    pcall(function()
        local ok, gc = pcall(getgc, true)
        if not ok then return end
        for _, v in ipairs(gc) do
            if type(v) == "table" and rawget(v, "_options") ~= nil then
                local opts = rawget(v, "_options")
                if type(opts) == "table" and opts.SampleInput ~= nil and opts.PresentLocal ~= nil then
                    runtimeInst = v
                    break
                end
            end
        end
    end)
    local running, wasInAir, jumping = false, false, false
    local function isOnGround()
        if not runtimeInst then return true end
        local ok, state = pcall(function() return runtimeInst:getPredictedState() end)
        if not ok or state == nil then return true end
        return state.OnGround == true
    end
    local function pulse()
        if jumping or not CC then return end
        jumping = true
        pcall(CC.jump, false)
        task.defer(function()
            pcall(CC.jump, true)
            task.delay(0.05, function()
                pcall(CC.jump, false)
                task.delay(0.05, function()
                    jumping = false
                end)
            end)
        end)
    end
    local function stopBhop()
        running = false
        wasInAir = false
        jumping = false
        if CC then pcall(CC.jump, false) end
    end
    RunService.Heartbeat:Connect(function()
        pcall(function()
            local bhopOn = _G.ECLIPSE_BhopKeyActive and _G.ECLIPSE_BhopKeyActive() or (Toggles.AutoBhop and Toggles.AutoBhop.Value)
            if not bhopOn then
                if running then stopBhop() end
                return
            end
            if not runtimeInst or not CC then return end
            local spaceHeld = UserInputService:IsKeyDown(Enum.KeyCode.Space)
            if not spaceHeld then
                if running then stopBhop() end
                return
            end
            if not running then
                running = true
                wasInAir = false
                pulse()
                return
            end
            local onGround = isOnGround()
            if wasInAir and onGround then
                wasInAir = false
                pulse()
            elseif not onGround then
                wasInAir = true
            end
        end)
    end)
    LP.CharacterRemoving:Connect(function()
        stopBhop()
    end)
end
