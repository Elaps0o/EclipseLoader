    _MV.JBEB_RP.FilterDescendantsInstances = { c, Camera }
end
local function _jbebGround(pos)
    for _, off in ipairs(_MV.GND_OFF) do
        local r = Workspace:Raycast(pos + off, Vector3.new(0, -3.1, 0), _MV.JBEB_RP)
        if r and r.Normal.Y > 0.7 and r.Instance.CanCollide then return true end
    end
    return false
end
local function _jbebNearEdge(pos)
    local c = Workspace:Raycast(pos, Vector3.new(0, -3.5, 0), _MV.JBEB_RP)
    if c and c.Normal.Y > 0.7 then return false end
    local hits = 0
    for _, off in ipairs(_MV.EDGE_SIDE) do
        local r = Workspace:Raycast(pos + off, Vector3.new(0, -5, 0), _MV.JBEB_RP)
        if r and r.Normal.Y > 0.7 then hits = hits + 1 end
    end
    return hits >= 2
end
local function _jbebStillEdge(pos)
    local c = Workspace:Raycast(pos, Vector3.new(0, -3.5, 0), _MV.JBEB_RP)
    if c and c.Normal.Y > 0.7 then return false end
    for _, off in ipairs(_MV.EDGE_STILL) do
        local r = Workspace:Raycast(pos + off, Vector3.new(0, -5, 0), _MV.JBEB_RP)
        if r then return true end
    end
    return false
end

function updateMovement()
    if not Config.GlobalEnable then return end
    local char = LocalPlayer.Character; if not char then return end
    local hum  = char:FindFirstChildOfClass("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")
    if not hum or not root then return end

    local movementOn = Config.Movement.BunnyHop or Config.Movement.AutoStrafe
    _MV.freeze(hum, root, false)

    local spaceHeld = _MV.spaceHeld()

    local hstate    = hum:GetState()
    local floorMat  = hum.FloorMaterial
    local stateGrounded = (floorMat ~= nil and floorMat ~= Enum.Material.Air)
                      and hstate ~= Enum.HumanoidStateType.Jumping
                      and hstate ~= Enum.HumanoidStateType.Freefall

    local rayGrounded = false
    do

        local filter = { char }
        local sd = _G.__ECLIPSE_SELF_DUMMY or (Workspace:FindFirstChild("_EclipseSelfDummy"))
        if sd then filter[#filter+1] = sd end
        local cpm = _G.__ECLIPSE_CPM_MODEL or _G.ECLIPSE_HUBCPMModel
        if cpm then filter[#filter+1] = cpm end
        local mc = _G.__ECLIPSE_MIRROR_CLONE
        if mc then filter[#filter+1] = mc end
        local sp = _G.ECLIPSE_HUB_SURF_PART
        if sp then filter[#filter+1] = sp end

        _MV.ASF_RAY.FilterDescendantsInstances = filter
        local down = Workspace:Raycast(root.Position, Vector3.new(0,-4.5,0), _MV.ASF_RAY)

        if down and down.Instance and down.Instance.CanCollide then rayGrounded = true end
    end
    local cvY_check = root.AssemblyLinearVelocity.Y
    local grounded  = stateGrounded or (rayGrounded and cvY_check <= 0.5)
    local inAir     = not grounded

    if Config.Movement.BunnyHop and spaceHeld then
        local landed = (hstate == Enum.HumanoidStateType.Landed)
                    or (hstate == Enum.HumanoidStateType.Running)
                    or (hstate == Enum.HumanoidStateType.RunningNoPhysics)
        if (grounded or landed) and tick() - _MV.lastBhop > 0.02 then

            pcall(function()
                if (tonumber(hum.JumpPower) or 0) <= 0 and (tonumber(hum.JumpHeight) or 0) <= 0 then
                    hum.UseJumpPower = true
                    hum.JumpPower = 50
                end
            end)
            -- Mobile: virtual tap on the game's Jump button (same dump path as Shoot)
            if _ECLIPSE_HUBIsMobile and type(_ECLIPSE_HUB_VirtualJump) == "function" then
                pcall(_ECLIPSE_HUB_VirtualJump)
            end
            pcall(function() hum:ChangeState(Enum.HumanoidStateType.Jumping) end)
            pcall(function() hum.Jump = true end)
            _MV.lastBhop = tick()
            pcall(function()
                local cv = root.AssemblyLinearVelocity
                local horiz = Vector3.new(cv.X, 0, cv.Z)
                local look = Camera and Camera.CFrame.LookVector or Vector3.new(0,0,-1)
                local camFlat = Vector3.new(look.X, 0, look.Z)
                local move = hum.MoveDirection
                local desired = (move and move.Magnitude > 0.05) and Vector3.new(move.X,0,move.Z) or camFlat
                if desired.Magnitude > 0.05 then desired = desired.Unit end
                if horiz.Magnitude > 4 then
                    local boosted = horiz:Lerp(desired * math.max(horiz.Magnitude, 18), 0.35)
                    local boost = boosted.Unit * math.min(boosted.Magnitude * 0.22, 9)
                    root.AssemblyLinearVelocity = Vector3.new(cv.X + boost.X, cv.Y, cv.Z + boost.Z)
                elseif desired.Magnitude > 0.05 then
                    root.AssemblyLinearVelocity = Vector3.new(desired.X * 18, cv.Y, desired.Z * 18)
                end
            end)
        end
    end

    do
        if not _ASF then _ASF = { chain = 0, wasAir = false, curSpd = 16 } end

        if _ASF.wasAir and not inAir then
            _ASF.chain  = 0
            _ASF.curSpd = 16
        end
        if not _ASF.wasAir and inAir then
            local cap = math.floor((Config.Movement.StrafeSpeed or 1.5) * 8)
            if _ASF.chain < cap then _ASF.chain = _ASF.chain + 1 end
        end
        _ASF.wasAir = inAir

        local strafeMode = tostring(Config.Movement.StrafeMode or "Directional")
        local strafeGate
        if strafeMode == "Keybind" then
            strafeGate = _MV.strafeKeyHeld and _MV.strafeKeyHeld() or false
        elseif strafeMode == "Always" then
            strafeGate = true
        else
            strafeGate = spaceHeld
        end

        if Config.Movement.AutoStrafe and strafeGate and inAir then
                local move = hum.MoveDirection
                if strafeMode == "Camera" then move = Vector3.new() end
                local look = Camera and Camera.CFrame.LookVector or Vector3.new(0,0,-1)
                local camFlat = Vector3.new(look.X, 0, look.Z)
                local inputFlat = (move and move.Magnitude > 0.05) and Vector3.new(move.X, 0, move.Z) or nil
                if not inputFlat and (strafeMode == "Camera" or strafeMode == "Always") and camFlat.Magnitude > 0.05 then
                    inputFlat = camFlat
                end
                local flat = camFlat
                if camFlat.Magnitude < 0.05 then
                    local cv = root.AssemblyLinearVelocity
                    local horiz = Vector3.new(cv.X, 0, cv.Z)
                    flat = (horiz.Magnitude > 0.1) and horiz or Vector3.new()
                end
                if inputFlat and inputFlat.Magnitude > 0.05 and flat.Magnitude > 0.05 then

                    flat = flat.Unit:Lerp(inputFlat.Unit, 0.42)
                elseif inputFlat and inputFlat.Magnitude > 0.05 then
                    flat = inputFlat
            end
            if flat.Magnitude > 0.01 then
                flat = flat.Unit
                local mult    = Config.Movement.StrafeSpeed or 1.5
                local target  = math.min(20 + _ASF.chain * 8, mult * 46)
                _ASF.curSpd = _ASF.curSpd + (target - _ASF.curSpd) * 0.20

                local cv     = root.AssemblyLinearVelocity
                local horiz  = Vector3.new(cv.X, 0, cv.Z)
                local curDir = (horiz.Magnitude > 0.1) and horiz.Unit or flat

                local newDir = curDir:Lerp(flat, 0.28)
                if newDir.Magnitude > 0.01 then newDir = newDir.Unit else newDir = flat end

                local newHoriz = newDir * _ASF.curSpd
                root.AssemblyLinearVelocity = Vector3.new(newHoriz.X, cv.Y, newHoriz.Z)
            end
        end
    end

    if Config.Movement.AutoStop then
        local Options = Config.Movement.QuickStopOptions or {}
        local function HasOpt(n)
            for _,v in pairs(Options) do if v == n then return true end end
            return false
        end
        local isShooting = game:GetService("UserInputService"):IsMouseButtonPressed(Enum.UserInputType.MouseButton1)

        local enemyInFov = false
        if not isShooting then
            local fov  = tonumber(Config.Aimbot and Config.Aimbot.FOV) or 150
            local vp   = Camera and Camera.ViewportSize
            local cx   = vp and (vp.X * 0.5) or 0
            local cy   = vp and (vp.Y * 0.5) or 0
            for _, pl in ipairs(Players:GetPlayers()) do
                if pl ~= LocalPlayer then
                    local skip = (not _IS_DEATHMATCH) and Config.TeamCheck and IsAlly and IsAlly(pl)
                    if not skip then
                        local pch = pl.Character
                        local h   = pch and pch:FindFirstChildOfClass("Humanoid")
                        local hd  = pch and (pch:FindFirstChild("Head") or pch:FindFirstChild("HumanoidRootPart"))
                        if h and h.Health > 0 and hd then
                            local sp, on = Camera:WorldToViewportPoint(hd.Position)
                            if on and sp.Z > 0 then
                                local dx, dy = sp.X - cx, sp.Y - cy
                                if (dx*dx + dy*dy) <= (fov*fov) and IsVisible and IsVisible(hd) then
                                    enemyInFov = true; break
                                end
                            end
                        end
                    end
                end
            end
        end

        if isShooting or enemyInFov then
            local move = hum.MoveDirection
            local isMoving = move and move.Magnitude > 0
            local shouldStop = false
            if not isMoving then shouldStop = true end
            if isShooting then shouldStop = true end
            if HasOpt("Move Between Shots") and not isShooting and isMoving then
                shouldStop = false
            end
            local canStop = grounded or HasOpt("In Air")
            if HasOpt("On Land") and not grounded then canStop = false end
            if shouldStop and canStop then
                local vel = root.AssemblyLinearVelocity
                local horiz = Vector3.new(vel.X, 0, vel.Z)
                if horiz.Magnitude > 0.1 then
                    root.AssemblyLinearVelocity = Vector3.new(0, vel.Y, 0)
                    pcall(function() hum:MoveTo(root.Position) end)
                end
            end
        end
    end

    _doJBEB(char, hum, root)
end

function _doJBEB(char, hum, root)
    if not (Config.Movement.Jumpbug or Config.Movement.Edgebug) then return end
    local now = tick()
    local dt = now - _MV.JB_LastTick; if dt <= 0 then dt = 1/60 end
    _MV.JB_LastTick = now
    _jbebSetFilter(char)
    local vel = root.AssemblyLinearVelocity
    local pos = root.Position
    local vy = vel.Y
    local inAir = (hum.FloorMaterial == Enum.Material.Air)
    local onGround = _jbebGround(pos)
    if _MV.JBCooldown > 0 then _MV.JBCooldown = _MV.JBCooldown - dt end
    if _MV.EB_Active then
        if not Config.Movement.Edgebug then
            _MV.EB_Active = false
        elseif (onGround and vy <= 1) or not _jbebStillEdge(pos) or (tick() - _MV.EB_StartTime > 2.0) then
            _MV.EB_Active = false
        else
            root.AssemblyLinearVelocity = Vector3.new(vel.X * 0.995, 0, vel.Z * 0.995)
            return
        end
    end
    local grd = (onGround and vy <= 1) or not inAir
    if not grd then
        _MV.JBEB_WasAir = true; _MV.JBEB_LandedFrame = false
        if vy < -1 then _MV.JBEB_FallFrames = _MV.JBEB_FallFrames + 1 end
    end
    if grd and _MV.JBEB_WasAir then
        _MV.JBEB_LandedFrame = true; _MV.JBEB_WasAir = false
    elseif grd and not _MV.JBEB_WasAir then
        _MV.JBEB_LandedFrame = false
    end
    if Config.Movement.Jumpbug and _MV.JBEB_LandedFrame and _MV.JBCooldown <= 0
        and _MV.JBEB_FallFrames >= _MV.JB_MIN_FRAMES then
        local hSpeed = math.sqrt(vel.X * vel.X + vel.Z * vel.Z)
        local newH = math.min(hSpeed + _MV.JB_HORIZ_BOOST, 24.5)
        local newVY = vy + _MV.JB_VERT_BOOST
        if hSpeed > 0.5 then
            local dir = Vector3.new(vel.X, 0, vel.Z).Unit
            root.AssemblyLinearVelocity = Vector3.new(dir.X * newH, newVY, dir.Z * newH)
        else
            root.AssemblyLinearVelocity = Vector3.new(vel.X, newVY, vel.Z)
        end
        _MV.JBCooldown = 0.4; _MV.JBActive = true; _MV.JBEB_FallFrames = 0
        task.delay(0.2, function() _MV.JBActive = false end)
    end
    if grd and not _MV.JBEB_LandedFrame then _MV.JBEB_FallFrames = 0 end
    if Config.Movement.Edgebug and not grd and vy < -8
        and not _MV.EB_Active and not _MV.JBActive then
        if _jbebNearEdge(pos) then
            _MV.EB_Active = true; _MV.EB_StartTime = tick(); _MV.JBEB_FallFrames = 0
            root.AssemblyLinearVelocity = Vector3.new(vel.X, 0, vel.Z)
        end
    end
end

