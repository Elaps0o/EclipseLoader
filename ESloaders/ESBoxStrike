    if br then
        pcall(function()
            br.Position  = Vector2.new(math.floor(L), math.floor(T))
            br.Size      = Vector2.new(math.floor(w), math.floor(h))
            br.Color     = col
            br.Thickness = 1
            br.Filled    = false
            br.Visible   = true
        end)
    end

    local pool = data.DrawBoxGrad
    if pool then
        local N       = #pool
        local strips  = math.clamp(math.floor(h / 4), 8, N)
        local strip_h = h / strips
        local thickness = math.max(2, math.ceil(strip_h) + 1)
        local xMid = math.floor(L + w * 0.5)
        for i = 1, N do
            local ln = pool[i]
            if not ln then break end
            if i <= strips then
                local yTop = T + (i - 1) * strip_h
                local yMid = yTop + strip_h * 0.5
                pcall(function()
                    ln.From      = Vector2.new(xMid, math.floor(yMid))
                    ln.To        = Vector2.new(xMid, math.floor(yMid))

                    ln.From      = Vector2.new(math.floor(L),         math.floor(yMid))
                    ln.To        = Vector2.new(math.floor(L + w - 1), math.floor(yMid))
                    ln.Thickness = thickness
                    ln.Color     = col
                    ln.Visible   = true
                end)
            else
                pcall(function() ln.Visible = false end)
            end
        end
    end

    if data.GuiBox then
        pcall(function()
            data.GuiBox.BackgroundTransparency = 1
            if data.GuiBoxStroke then data.GuiBoxStroke.Transparency = 1 end
            if data.GuiBoxGrad   then data.GuiBoxGrad.Transparency = NumberSequence.new(1, 1) end
