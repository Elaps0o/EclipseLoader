function updateAimbot()
    if not Config.GlobalEnable or not Config.Aimbot.Enabled or not Config.Aimbot.DrawFOV then
        _setAimFOVVisible(false)
    end
    if not Config.GlobalEnable or not Config.Aimbot.Enabled then return end
    if Config.Aimbot.DisableInFlash and _isLocalFlashed() then return end

    local mouse
    if _ECLIPSE_HUBIsMobile then
        local vp = Camera.ViewportSize
        mouse = Vector2.new(vp.X/2, vp.Y/2)
    else
        mouse = UserInput:GetMouseLocation()
    end
    local r = ActiveAimFOV()
    _updateAimFOVVisual(mouse, r, Config.Aimbot.FOVColor, Config.Aimbot.DrawFOV)

    local heldName = getHeldWeaponName and getHeldWeaponName() or nil
    local isAWP     = heldName == "AWP"
    local isSniper  = heldName and SniperWeapons[heldName] or false
    local scoped = (isAWP or isSniper) and (isScopedIn and isScopedIn())

    local keyHeld = false
    if _ECLIPSE_HUBIsMobile then

        keyHeld = _mobileFireHeld()
    else
        pcall(function()
            local kp = Library.Options and Library.Options.Aimbot_Key
            if kp and kp.GetState then keyHeld = kp:GetState() end
        end)
        if not keyHeld then
            local kp = Library.Options and Library.Options.Aimbot_Key
            local key = kp and kp.Value or Enum.UserInputType.MouseButton1
            if key == Enum.UserInputType.MouseButton1 then keyHeld = UserInput:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
            elseif key == Enum.UserInputType.MouseButton2 then keyHeld = UserInput:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
            elseif key == Enum.UserInputType.MouseButton3 then keyHeld = UserInput:IsMouseButtonPressed(Enum.UserInputType.MouseButton3)
            elseif typeof(key) == "EnumItem" and key.EnumType == Enum.KeyCode then keyHeld = UserInput:IsKeyDown(key) end
        end
    end

    local aiming = keyHeld or Config.TriggerBot.Enabled or scoped or (isAWP or isSniper)
    if not aiming then return end

    local mp
    if scoped then
        local vp = Camera.ViewportSize
        mp = Vector2.new(vp.X/2, vp.Y/2)
    elseif _ECLIPSE_HUBIsMobile then
        local vp = Camera.ViewportSize
        mp = Vector2.new(vp.X/2, vp.Y/2)
    else
        mp = UserInput:GetMouseLocation()
    end

    local scopeFOV
    if scoped then
        scopeFOV = 220
    else
        scopeFOV = ActiveAimFOV()
    end
    local closestPart, closestDist = nil, scopeFOV
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and IsEnemy(plr) then
            local char = GetCharacter(plr)
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                local part
                if isAWP or isSniper then
                    part = char:FindFirstChild("Head") or GetAimbotTargetPart(char)
                else
                    part = GetAimbotTargetPart(char)
                end

                local okTarget = part ~= nil
                if okTarget and Config.Aimbot.VisibilityCheck then
                    okTarget = _ECLIPSE_HUBHitPossible(part, Config.Aimbot.WallBang)
                end
                if okTarget and Config.Aimbot.DisableInSmoke and Camera and _aimRayHitsSmoke(Camera.CFrame.Position, part.Position) then
                    okTarget = false
                end
                if okTarget then
                    local sp, on = Camera:WorldToViewportPoint(part.Position)
                    if on and sp.Z > 0 and sp.X == sp.X and sp.Y == sp.Y then
                        local d = (Vector2.new(sp.X, sp.Y) - mp).Magnitude
                        if d < closestDist then closestDist = d; closestPart = part end
                    end
                end
            end
        end
    end
    if closestPart then
        local now = tick()
        if AimState.lastTarget ~= closestPart then
            AimState.lastTarget = closestPart
            AimState.acquiredAt = now
            AimState.frameN     = 0
            AimState.aimPos     = closestPart.Position
            AimState.lastAimPos = closestPart.Position
        end
        AimState.frameN = (AimState.frameN or 0) + 1

        local t = math.clamp(AimState.frameN / 3, 0, 1)
        local ramp = t * t * (3 - 2 * t)

        local s = math.clamp(ActiveAimSmooth() or 0.35, 0.05, 1.0)
        local dt = math.clamp(now - (AimState.lastTick > 0 and AimState.lastTick or now - 1/60), 1/240, 1/30)
        AimState.lastTick = now

        local k
        if scoped then
            k = 95
        else

            k = 7 + s * 16
        end
        local alpha = 1 - math.exp(-dt * k)
        alpha = math.clamp(alpha * ramp, 0.015, scoped and 0.88 or 0.62)

        local rawPos = closestPart.Position
        local okVel, vel = pcall(function() return closestPart.AssemblyLinearVelocity end)
        if okVel and typeof(vel) == "Vector3" then
            local horiz = Vector3.new(vel.X, 0, vel.Z)
            if horiz.Magnitude > 3 and horiz.Magnitude < 85 then
                rawPos = rawPos + horiz * math.clamp(dt + 0.018, 0.012, 0.045)
            end
        end
        if AimState.aimPos then
            local posAlpha = 1 - math.exp(-dt * 24)
            AimState.aimPos = AimState.aimPos:Lerp(rawPos, math.clamp(posAlpha, 0.10, 0.45))
        else
            AimState.aimPos = rawPos
        end
        local predictPos = AimState.aimPos

        local sp = Camera:WorldToViewportPoint(predictPos)
        local tp = Vector2.new(sp.X, sp.Y)
        local delta = tp - mp
        local mag = delta.Magnitude

        if mag < 1.25 then return end
        if mag < 18 then alpha = math.min(alpha, 0.34)
        elseif mag < 60 then alpha = math.min(alpha, 0.46) end
        if scoped then alpha = math.min(0.86, math.max(alpha, 0.45)) end

        if _ECLIPSE_HUBIsMobile then

            _ECLIPSE_HUBMobileAimAt(predictPos, alpha)
        else
            local maxStep = scoped and 120 or math.clamp(20 + s * 75, 24, 95)
            local dx = math.clamp(delta.X * alpha, -maxStep, maxStep)
            local dy = math.clamp(delta.Y * alpha, -maxStep, maxStep)
            if mousemoverel then mousemoverel(dx, dy) end
        end

    else
        AimState.lastTarget = nil
        AimState.frameN     = 0
        AimState.aimPos     = nil
        AimState.lastAimPos = nil
    end
end

end)()

