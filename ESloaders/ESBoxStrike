function _ecfgEncode(v, seen)
    local tv = typeof(v)
    if tv == "Color3" then
        return { __ECLIPSE_HUBType="Color3", r=math.floor(v.R * 255 + 0.5), g=math.floor(v.G * 255 + 0.5), b=math.floor(v.B * 255 + 0.5) }
    elseif tv == "EnumItem" then
        return { __ECLIPSE_HUBType="EnumItem", enum=tostring(v.EnumType):gsub("^Enum%.", ""), name=v.Name }
    elseif type(v) == "table" then
        seen = seen or {}
        if seen[v] then return nil end
        seen[v] = true
        local out = {}
        local isArray = true
        local count = 0
        for k in pairs(v) do
            count = count + 1
            if type(k) ~= "number" or k % 1 ~= 0 or k < 1 then isArray = false end
        end
        if isArray and count > 0 then
            for i = 1, count do if v[i] == nil then isArray = false break end end
        end
        if isArray and count > 0 then
            for i = 1, count do
                local ev = _ecfgEncode(v[i], seen)
                out[i] = (ev == nil) and false or ev
            end
        else
            for k, val in pairs(v) do
                local ek
                if type(k) == "number" then
                    ek = "__n:" .. tostring(k)
                elseif type(k) == "string" then
                    ek = k
                else
                    ek = tostring(k)
                end
                local ev = _ecfgEncode(val, seen)
                if ev ~= nil then out[ek] = ev end
            end
        end
        seen[v] = nil
        return out
    elseif type(v) == "string" or type(v) == "boolean" then
        return v
    elseif type(v) == "number" then
        if v ~= v or v == math.huge or v == -math.huge then return 0 end
        return v
    end
    return nil
end

function _ecfgDecode(v)
    if type(v) ~= "table" then return v end
    if v.__ECLIPSE_HUBType == "Color3" then
        return Color3.fromRGB(tonumber(v.r) or 255, tonumber(v.g) or 255, tonumber(v.b) or 255)
    elseif v.__ECLIPSE_HUBType == "EnumItem" then
        local ok, item = pcall(function() return Enum[tostring(v.enum)][tostring(v.name)] end)
        if ok then return item end
        return tostring(v.name or "")
    end
    local out = {}
    for k, val in pairs(v) do
        local dk = k
        if type(k) == "string" then
            local num = k:match("^__n:(-?%d+)$")
            if num then dk = tonumber(num) end
        end
        out[dk] = _ecfgDecode(val)
    end
    return out
end

function _ecfgMerge(dst, src)
    if type(dst) ~= "table" or type(src) ~= "table" then return end
    for k, v in pairs(src) do
        if type(v) == "table" and type(dst[k]) == "table" and not v.__ECLIPSE_HUBType then
            _ecfgMerge(dst[k], v)
        else
            dst[k] = v
        end
    end
end

function _ecfgReadRaw()
    if not _ecfgFileApi() then return nil end
    local okExists, exists = pcall(isfile, _ECLIPSE_HUB_AUTOCONFIG_PATH)
    if not okExists or not exists then return nil end
    local okRead, body = pcall(readfile, _ECLIPSE_HUB_AUTOCONFIG_PATH)
    if not okRead or type(body) ~= "string" or body == "" then return nil end
    local okJson, data = pcall(function() return HttpService:JSONDecode(body) end)
    if okJson and type(data) == "table" then
        _ECLIPSE_HUBAutoConfig.lastJson = body
        return data
    end
    return nil
end

function _ecfgLoadIntoConfig()
    local data = _ecfgReadRaw()
    if type(data) ~= "table" then return end
    _ECLIPSE_HUBAutoConfig.loaded = data

    local cfg = _ecfgDecode(data.Config)
    if type(cfg) == "table" and type(cfg.UI) == "table" then
        Config.UI = Config.UI or {}
        _ecfgMerge(Config.UI, cfg.UI)
    end
    pcall(function() _reapplyAllPanelPositions() end)
end

local function _ecfgIsKeyPicker(opt)
    if not opt then return false end
    local t = rawget(opt, "Type") or opt.Type
    if t == "KeyPicker" then return true end

    return opt.Mode ~= nil and opt.SyncToggleState ~= nil
end

local function _ecfgIsSkinControl(id)
    local s = tostring(id or "")
    return s == "Skin_Toggle" or s == "Knife_Toggle" or s == "Knife_Select" or s:sub(1, 5) == "Skin_"
end

local function _ecfgApplySkinControlPriority(id)
    local s = tostring(id or "")
    if s == "Skin_Toggle" then return 1 end
    if s == "Knife_Toggle" then return 2 end
    if s == "Knife_Select" then return 3 end
    return 10
end

local function _ecfgOptType(opt)
    if not opt then return "" end
    return tostring(rawget(opt, "Type") or opt.Type or "")
end

local function _ecfgReadOptValue(opt)
    if not opt then return nil end
    local v = rawget(opt, "Value")
    if v == nil then v = opt.Value end
    if v == nil then v = rawget(opt, "CurrentValue") or opt.CurrentValue end
    if v == nil then v = rawget(opt, "Current") or opt.Current end
    if v == nil and type(opt.GetValue) == "function" then
        local ok, got = pcall(function() return opt:GetValue() end)
        if ok then v = got end
    end
    if v == nil then v = rawget(opt, "Default") or opt.Default end
    return v
end

local function _ecfgSetObjValue(obj, val)
    if not obj then return false end
    local used = false
    local oldDisabled = obj.Disabled
    if oldDisabled ~= nil and (_ecfgOptType(obj) == "Slider" or _ecfgOptType(obj) == "Dropdown") then
        pcall(function() obj.Disabled = false end)
    end
    if type(obj.SetValue) == "function" then
        local ok = pcall(function() obj:SetValue(val) end)
        used = ok or used
    elseif type(obj.Set) == "function" then
        local ok = pcall(function() obj:Set(val) end)
        used = ok or used
    end
    if oldDisabled ~= nil then pcall(function() obj.Disabled = oldDisabled end) end
    if not used then
        pcall(function() obj.Value = val end)
        if type(obj.Callback) == "function" then pcall(obj.Callback, val) end
        if type(obj.Changed) == "function" then pcall(obj.Changed, val) end
    end
    return used
end

local function _ecfgApplyPriority(id)
    local opt = Library.Options and Library.Options[id]
    local tog = Library.Toggles and Library.Toggles[id]
    if tog then return 10 end
    local t = _ecfgOptType(opt)
    if t == "Dropdown" then
        local s = tostring(id)
        if s:find("_Mode$") then return 20 end
        if s:find("_Category$") then return 21 end
        if s:find("_Weapon$") then return 22 end
        return 25
    end
    if _ecfgIsKeyPicker(opt) then return 30 end
    if t == "ColorPicker" then return 35 end
    if t == "Input" then return 40 end
    if t == "Slider" then return 80 end
    return 50
end

function _ecfgControlSnapshot()
    local out = {}
    pcall(function()
        for id, opt in pairs(Library.Toggles or {}) do
            local v = opt.Value
            if v == nil and type(opt.GetState) == "function" then v = opt:GetState() end
            out[id] = v
        end
        for id, opt in pairs(Library.Options or {}) do
            if _ecfgIsKeyPicker(opt) then
                local key = _ecfgReadOptValue(opt)
                if typeof(key) == "EnumItem" then key = key.Name end
                out[id] = {
                    __ECLIPSE_HUBKP = true,
                    Key = key or opt.Default,
                    Mode = opt.Mode,
                    State = (opt.Toggled == true),
                }
            else
                out[id] = _ecfgReadOptValue(opt)
            end
        end
    end)
    return out
end

function _ecfgApplyLoadedControls()
    local data = _ECLIPSE_HUBAutoConfig.loaded
    if type(data) ~= "table" or type(data.Controls) ~= "table" then return end
    local cfg = _ecfgDecode(data.Config)
    if type(cfg) == "table" then
        _ecfgMerge(Config, cfg)
    end
    local controls = _ecfgDecode(data.Controls)
    _ECLIPSE_HUBConfigLoading = true
    local entries = {}
    local skinEntries = {}
    for id, val in pairs(controls) do
        if _ecfgIsSkinControl(id) then
            skinEntries[#skinEntries + 1] = { id = id, val = val, pr = _ecfgApplySkinControlPriority(id) }
        else
            entries[#entries + 1] = { id = id, val = val, pr = _ecfgApplyPriority(id) }
        end
    end
    table.sort(entries, function(a, b)
        if a.pr == b.pr then return tostring(a.id) < tostring(b.id) end
        return a.pr < b.pr
    end)
    table.sort(skinEntries, function(a, b)
        if a.pr == b.pr then return tostring(a.id) < tostring(b.id) end
        return a.pr < b.pr
    end)
    local _ecfgApplied = 0
    local deferredHeavyToggles = {}
    local heavyToggleIds = {
        Skin_Toggle = true,
        AntiSmoke_Toggle = true,
        PV_GlassFX = true,
    }
    for _, ent in ipairs(entries) do
        local id, val = ent.id, ent.val
        _ecfgApplied = _ecfgApplied + 1

        if (_ecfgApplied % 8) == 0 then ECLIPSE_HUBYield() end
        pcall(function()
            local tog = Library.Toggles and Library.Toggles[id]
            if tog then
                local bv = val and true or false
                if heavyToggleIds[tostring(id)] and bv == true then
                    deferredHeavyToggles[#deferredHeavyToggles + 1] = { id = tostring(id), tog = tog, value = bv }
                    if tostring(id) == "Skin_Toggle" then
                        Config.Skins.SkinChangerEnabled = false
                        pcall(function() if SkinSystem then SkinSystem.scriptRunning = false end end)
                    elseif tostring(id) == "AntiSmoke_Toggle" then
                        Config.Misc.AntiSmoke = false
                    elseif tostring(id) == "PV_GlassFX" then
                        Config.Visuals.GlassFX = false
                    end
                    return
                end
                _ecfgSetObjValue(tog, bv)
                return
            end

            local opt = Library.Options and Library.Options[id]
            if opt then
                if _ecfgIsKeyPicker(opt) then
                    local key, mode, state
                    if type(val) == "table" and val.__ECLIPSE_HUBKP then
                        key, mode, state = val.Key, val.Mode, val.State
                    elseif type(val) == "table" then
                        key  = val.Key or val[1] or val.Value
                        mode = val.Mode or val[2]
                        state = val.State
                    else
                        key = val
                    end
                    if mode and type(mode) == "string" then opt.Mode = mode end
                    if type(key) == "string" and key ~= "" then
                        pcall(function() if type(opt.SetValue) == "function" then opt:SetValue(key, opt.Mode) end end)
                        pcall(function() if type(opt.Update)   == "function" then opt:Update() end end)
                    end
                    if type(state) == "boolean" and type(opt.SetState) == "function" then
                        pcall(function() opt:SetState(state) end)
                    elseif type(state) == "boolean" and opt.Toggled ~= nil then
                        opt.Toggled = state
                    end
                else
                    _ecfgSetObjValue(opt, val)
                end
            end
        end)
    end

    if #skinEntries > 0 then
        local savedSkinEnabled = Config.Skins and Config.Skins.SkinChangerEnabled == true
        pcall(function()
            Config.Skins.SkinChangerEnabled = true
            if _syncKnifeLock then _syncKnifeLock() end
        end)
        for _, ent in ipairs(skinEntries) do
            _ecfgApplied = _ecfgApplied + 1
            if (_ecfgApplied % 8) == 0 then ECLIPSE_HUBYield() end
            pcall(function()
                local id, val = ent.id, ent.val
                local tog = Library.Toggles and Library.Toggles[id]
                if tog then
                    if tostring(id) == "Skin_Toggle" then savedSkinEnabled = val and true or false end
                    _ecfgSetObjValue(tog, val and true or false)
                    return
                end
                local opt = Library.Options and Library.Options[id]
                if opt then _ecfgSetObjValue(opt, val) end
            end)
        end
        pcall(function()
            Config.Skins.SkinChangerEnabled = savedSkinEnabled and true or false
            if SkinSystem then SkinSystem.scriptRunning = Config.Skins.SkinChangerEnabled end
            if Toggles and Toggles.Skin_Toggle and Toggles.Skin_Toggle.Value ~= Config.Skins.SkinChangerEnabled then
                Toggles.Skin_Toggle:SetValue(Config.Skins.SkinChangerEnabled)
            end
            if _syncKnifeLock then _syncKnifeLock() end
        end)
    end

    _ECLIPSE_HUBConfigLoading = false
    for i, ent in ipairs(deferredHeavyToggles) do
        task.delay(0.25 + (i - 1) * 0.45, function()
            if not scriptRunning then return end
            if ent.id == "Skin_Toggle" then
                Config.Skins.SkinChangerEnabled = false
                pcall(function() if SkinSystem then SkinSystem.scriptRunning = false end end)
            elseif ent.id == "AntiSmoke_Toggle" then
                Config.Misc.AntiSmoke = false
            elseif ent.id == "PV_GlassFX" then
                Config.Visuals.GlassFX = false
            end
            pcall(function() _ecfgSetObjValue(ent.tog, ent.value) end)
        end)
    end
    pcall(function() if _syncKnifeLock then _syncKnifeLock() end end)
    pcall(function() if _postSkinConfigLoadApply then _postSkinConfigLoadApply() end end)
    pcall(function() if UpdateWeather then UpdateWeather(Config.World.Weather) end end)
    pcall(function() _reapplyAllPanelPositions() end)
    task.delay(0.2, function()
        pcall(function() _reapplyAllPanelPositions() end)
    end)
    for _, delayT in ipairs({0.4, 1.2, 2.5}) do
        task.delay(delayT, function()
            pcall(function() if UpdateWeather then UpdateWeather(Config.World.Weather or "None") end end)
            pcall(function()
                if _applyWorldColorState then _applyWorldColorState() end
            end)
        end)
    end
    pcall(function() if _updateNoRecoil then _updateNoRecoil() end end)
    pcall(function() if _ecfgApplyColorsAndKeys then _ecfgApplyColorsAndKeys(data) end end)
    task.delay(0.35, function()
        pcall(function() if _ecfgApplyColorsAndKeys then _ecfgApplyColorsAndKeys(data) end end)
    end)
    pcall(function() if EX and type(EX.rebuildKB) == "function" then EX.rebuildKB() end end)
    pcall(_reapplyAllPanelPositions)

end

function _ecfgColorSnapshot()
    local out = {}
    pcall(function()
        for id, opt in pairs(Library.Options or {}) do
            if _ecfgOptType(opt) == "ColorPicker" then
                local c = rawget(opt, "Value") or opt.Value
                if typeof(c) == "Color3" then
                    out[tostring(id)] = { r = math.floor(c.R * 255 + 0.5), g = math.floor(c.G * 255 + 0.5), b = math.floor(c.B * 255 + 0.5) }
                end
            end
        end
    end)
    return out
end

function _ecfgKeySnapshot()
    local out = {}
    pcall(function()
        for id, opt in pairs(Library.Options or {}) do
            if _ecfgIsKeyPicker(opt) then
                local key = rawget(opt, "Value") or opt.Value or opt.Default
                if typeof(key) == "EnumItem" then key = key.Name end
                out[tostring(id)] = {
                    Key = tostring(key or "Unknown"),
                    Mode = tostring(opt.Mode or "Toggle"),
                    State = (opt.Toggled == true),
                }
            end
        end
    end)
    return out
end

function _ecfgApplyColorsAndKeys(data)
    if type(data) ~= "table" then return end
    pcall(function()
        for id, c in pairs(data.Colors or {}) do
            local opt = Library.Options and Library.Options[id]
            if opt and type(c) == "table" then
                local col = Color3.fromRGB(tonumber(c.r) or 255, tonumber(c.g) or 255, tonumber(c.b) or 255)
                if type(opt.SetValueRGB) == "function" then
                    pcall(function() opt:SetValueRGB(col) end)
                elseif type(opt.SetValue) == "function" then
                    pcall(function() opt:SetValue(col) end)
                else
                    opt.Value = col
                end
            end
        end
    end)
    pcall(function()
        for id, k in pairs(data.Keys or {}) do
            local opt = Library.Options and Library.Options[id]
            if opt and type(k) == "table" then
                if type(k.Mode) == "string" then opt.Mode = k.Mode end
                if type(k.Key) == "string" and k.Key ~= "" and type(opt.SetValue) == "function" then
                    pcall(function() opt:SetValue(k.Key, opt.Mode) end)
                end
                if type(k.State) == "boolean" then
                    if type(opt.SetState) == "function" then
                        pcall(function() opt:SetState(k.State) end)
                    else
                        opt.Toggled = k.State
                    end
                end
            end
        end
    end)
end

function _ecfgSnapshotJson()
    local encodedConfig = _ecfgEncode(Config)
    local encodedControls = _ecfgEncode(_ecfgControlSnapshot())
    _ecfgSanitizeEncodedPayload(encodedConfig, encodedControls)
    local colors = _ecfgColorSnapshot()
    local keys = _ecfgKeySnapshot()
    local payload = {
        Version = EclipseHub.Version,
        SavedAt = os.time(),
        Config = encodedConfig,
        Controls = encodedControls,
        Colors = colors,
        Keys = keys,
    }
    local ok, json = pcall(function() return HttpService:JSONEncode(payload) end)
    if not ok or type(json) ~= "string" then

        local ok2, json2 = pcall(function()
            return HttpService:JSONEncode({
                Version = EclipseHub.Version,
                SavedAt = os.time(),
                Controls = encodedControls,
                Colors = colors,
                Keys = keys,
            })
        end)
        if ok2 and type(json2) == "string" then return json2 end
        local ok3, json3 = pcall(function()
            return HttpService:JSONEncode({
                Version = EclipseHub.Version,
                SavedAt = os.time(),
                Colors = colors,
                Keys = keys,
            })
        end)
        if ok3 and type(json3) == "string" then return json3 end
        return nil
    end

    if #json > 4 * 1024 * 1024 then return nil end
    return json
end

