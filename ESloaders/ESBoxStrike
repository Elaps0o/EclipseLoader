function updateC4Ring(remain, total, color)
    if not (C4UI and C4UI.timeFill) then return end
    local pct = 0
    if tonumber(total) and total > 0 and tonumber(remain) then
        pct = math.clamp(remain / total, 0, 1)
    end
    pcall(function()
        C4UI.timeFill.Size = UDim2.new(pct, 0, 1, 0)

        if pct > 0.5 then
            C4UI.timeFill.BackgroundColor3 = Color3.fromRGB(170, 90, 240)
        elseif pct > 0.25 then
            C4UI.timeFill.BackgroundColor3 = Color3.fromRGB(210, 90, 220)
        else
            C4UI.timeFill.BackgroundColor3 = Color3.fromRGB(245, 100, 180)
        end
        if color and C4UI.avatarStroke then C4UI.avatarStroke.Color = color end
        if color and C4UI.trackRing then C4UI.trackRing.Color = color end
        if color and C4UI.moon then C4UI.moon.BackgroundColor3 = color end
        if C4UI.ring then
            C4UI.ring.Visible = true
            C4UI.ring.BackgroundTransparency = 0.90 + (pct * 0.06)
        end
        if C4UI.trackRing then
            C4UI.trackRing.Transparency = 0.10 + (1 - pct) * 0.45
        end
        if C4UI.moon then
            local s = 18 + math.floor(16 * pct)
            C4UI.moon.Size = UDim2.fromOffset(s, s)
            C4UI.moon.BackgroundTransparency = 0.70 + pct * 0.18
        end
    end)
end

function C4Hide()
    if not C4UI.frame then return end
    if not C4UI.shown then C4UI.frame.Visible = false; return end
    C4UI.shown = false; C4UI.pinned = false
    local f = C4UI.frame

    local tw = TweenService:Create(f, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
        { BackgroundTransparency = 1 })
    tw:Play()
    connectSignal(tw.Completed:Once(function()
        if scriptRunning and not C4UI.shown then
            f.Visible = false
            f.BackgroundTransparency = 0.05
        end
    end))

end

function C4Show(status, timeText, sub, color, info)
    ensureC4UI()
    if not C4UI.frame then return end

    local title = "BOMB PLANTED"
    local subtitle = "awaiting defuser"
    local pill = "PLANTED"
    local pillCol = Color3.fromRGB(255, 140, 90)
    if status == "DEFUSING" then
        title = "DEFUSING"; subtitle = (sub and sub ~= "" and sub) or "defuse in progress"
        pill = "DEFUSING"; pillCol = Color3.fromRGB(120, 180, 255)
    elseif status == "BOMB DEFUSED" then
        title = "DEFUSED"; subtitle = "safe"
        pill = "SAFE"; pillCol = Color3.fromRGB(90, 220, 140)
    elseif status == "BOMB DETONATED" then
        title = "DETONATED"; subtitle = "boom"
        pill = "BOOM"; pillCol = Color3.fromRGB(255, 90, 100)
    elseif status == "BOMB LOST" then
        title = "SIGNAL LOST"; subtitle = "bomb lost"
        pill = "LOST"; pillCol = Color3.fromRGB(160, 160, 180)
    elseif status == "TIME UP" then
        title = "TIME UP"; subtitle = "fuse ended"
        pill = "END"; pillCol = Color3.fromRGB(255, 90, 100)
    end

    if info and info.player then
        local plr = info.player
        C4UI._curUserId = plr.UserId
        title = plr.DisplayName or plr.Name
        local cached = C4AvatarCache[plr.UserId]
        if cached == nil or cached == "" then
            local url = _c4FetchAvatar(plr.UserId)
            if url ~= "" then C4UI.avatar.Image = url end
        else
            C4UI.avatar.Image = cached
        end
        if C4UI.avatar.Image ~= "" then C4UI.avFallback.Visible = false else C4UI.avFallback.Visible = true end
        local hp    = tonumber(info.hp) or 0
        local maxhp = tonumber(info.maxhp) or 100
        if maxhp <= 0 then maxhp = 100 end
        local ratio = math.clamp(hp / maxhp, 0, 1)
        C4UI.hpFill.Size = UDim2.fromScale(ratio, 1)
        local hpCol
        if ratio > 0.6 then hpCol = Color3.fromRGB(90, 220, 140)
        elseif ratio > 0.3 then hpCol = Color3.fromRGB(255, 200, 80)
        else hpCol = Color3.fromRGB(255, 80, 90) end
        C4UI.hpFill.BackgroundColor3 = hpCol
        C4UI.hpBg.Visible = true
        C4UI.hpText.Text = string.format("%d HP", math.floor(hp + 0.5))
        C4UI.hpText.Visible = true
        if info.dist then
            C4UI.distText.Text = string.format("· %dm", math.floor(tonumber(info.dist) or 0))
            C4UI.distText.Position = UDim2.fromOffset(230, 62)
            C4UI.distText.Visible = true
        else
            C4UI.distText.Visible = false
        end
        C4UI.infoStatus.Text = (sub and sub ~= "" and sub) or "defusing"
    else
