local function _isECLIPSE_HUBError(message, stack, scriptObj)
    local srcName = ""
    pcall(function() srcName = scriptObj and scriptObj:GetFullName() or "" end)
    local blob = tostring(message or "") .. "\n" .. tostring(stack or "") .. "\n" .. srcName
    local low = string.lower(blob)

    if string.find(low, "loadingscreen", 1, true) then return false end
    if string.find(low, "replicatedfirst", 1, true) then return false end
    if string.find(low, "playerscripts", 1, true) then return false end
    if string.find(low, "corescript", 1, true) then return false end
    if string.find(low, "bac ", 1, true) or string.find(low, "|frog", 1, true) then return false end

    if string.find(low, "EclipseHub", 1, true) then return true end
    if string.find(low, "obsidian", 1, true) then return true end
    if string.find(low, "linoria",  1, true) then return true end
    if string.find(low, "skinsystem", 1, true) then return true end
    if string.find(low, "autoskill", 1, true) then return true end
    if string.find(low, "sendwebhook", 1, true) then return true end
    return false
end

