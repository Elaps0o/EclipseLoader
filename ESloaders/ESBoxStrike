    -- extend materials list with Leather alias
    local function resolveMat(name)
        if name == "Leather" then return Enum.Material.Fabric end
        local ok, mat = pcall(function() return Enum.Material[name] end)
        return (ok and mat) or Enum.Material.SmoothPlastic
    end

    local OrigParts = {} -- [BasePart] = {Material, Color, Transparency}
    local function storeOrig(part)
        if not OrigParts[part] then
            OrigParts[part] = {
                Material = part.Material,
                Color = part.Color,
                Transparency = part.Transparency,
            }
        end
    end
    local function restoreOrig(part)
        local o = OrigParts[part]
        if o and part and part.Parent then
            pcall(function()
                part.Material = o.Material
                part.Color = o.Color
                part.Transparency = o.Transparency
            end)
        end
    end

    local function isArmOrSleeve(part)
        local n = part.Name:lower()
        if n:find("arm", 1, true) or n:find("sleeve", 1, true) or n:find("hand", 1, true)
            or n:find("glove", 1, true) or n:find("forearm", 1, true) or n:find("wrist", 1, true) then
            return true
        end
        local p = part.Parent
        if p then
            local pn = p.Name:lower()
            if pn:find("arm", 1, true) or pn:find("sleeve", 1, true) or pn:find("glove", 1, true)
                or pn:find("hand", 1, true) or pn:find("viewmodel", 1, true) then
                return true
            end
        end
        return false
    end
    local function isGlove(part)
        local n = part.Name:lower()
        if n:find("glove", 1, true) or n:find("wrap", 1, true) then return true end
        local p = part.Parent
        if p then
            local pn = p.Name:lower()
            if pn:find("glove", 1, true) or pn:find("wrap", 1, true) then return true end
        end
        return false
    end
    local function isBodyPart(part)
        local n = part.Name:lower()
        return n:find("torso", 1, true) or n:find("leg", 1, true) or n:find("head", 1, true)
            or n:find("upper", 1, true) or n:find("lower", 1, true) or n == "humanoidrootpart"
            or n:find("foot", 1, true) or n:find("hip", 1, true)
    end

    local function paintModel()
        local char = LP.Character
        if not char then return end
        local bodyOn = Toggles.ModelChangerEnabled and Toggles.ModelChangerEnabled.Value
        local sleeveOn = Toggles.SleeveChangerEnabled and Toggles.SleeveChangerEnabled.Value
        local gloveOn = Toggles.GloveMaterialEnabled and Toggles.GloveMaterialEnabled.Value
        if not bodyOn and not sleeveOn and not gloveOn then
            for part, _ in pairs(OrigParts) do
                if part and part.Parent then restoreOrig(part) end
            end
            return
        end
        local bodyMat = resolveMat(Options.ModelMaterial and Options.ModelMaterial.Value or "Neon")
        local bodyCol = Options.ModelColor and Options.ModelColor.Value or Color3.fromRGB(140, 100, 255)
        if Toggles.ModelRainbow and Toggles.ModelRainbow.Value then
            bodyCol = Color3.fromHSV((tick() % 5) / 5, 0.85, 1)
        end
        local bodyTrans = Options.ModelTransparency and Options.ModelTransparency.Value or 0
        local sleeveMat = resolveMat(Options.SleeveMaterial and Options.SleeveMaterial.Value or "Fabric")
        local sleeveCol = Options.SleeveColor and Options.SleeveColor.Value or Color3.fromRGB(40, 40, 50)
        local sleeveTrans = Options.SleeveTransparency and Options.SleeveTransparency.Value or 0
        local gloveMat = resolveMat(Options.GloveMaterial and Options.GloveMaterial.Value or "Fabric")
        local gloveCol = Options.GloveMatColor and Options.GloveMatColor.Value or Color3.fromRGB(30, 30, 30)

        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                storeOrig(part)
                if gloveOn and isGlove(part) then
                    part.Material = gloveMat
                    part.Color = gloveCol
                    part.Transparency = math.min(part.Transparency, 0.15)
                elseif sleeveOn and isArmOrSleeve(part) then
                    part.Material = sleeveMat
                    part.Color = sleeveCol
                    part.Transparency = sleeveTrans
                elseif bodyOn and (isBodyPart(part) or not isArmOrSleeve(part)) then
                    part.Material = bodyMat
                    part.Color = bodyCol
                    part.Transparency = bodyTrans
                end
            end
        end
        -- also paint viewmodel arms in camera
        local cam = Workspace.CurrentCamera
        if cam then
            for _, child in ipairs(cam:GetChildren()) do
                if child:IsA("Model") then
                    for _, part in ipairs(child:GetDescendants()) do
                        if part:IsA("BasePart") then
                            storeOrig(part)
                            if gloveOn and isGlove(part) then
                                part.Material = gloveMat
                                part.Color = gloveCol
                            elseif sleeveOn and isArmOrSleeve(part) then
                                part.Material = sleeveMat
                                part.Color = sleeveCol
                                part.Transparency = sleeveTrans
                            end
                        end
                    end
                end
            end
        end
    end

