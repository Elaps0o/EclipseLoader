function _espSyncDrawBoxGeom(data, L, T, w, h, col)
    if not _DRAW_OK then return end
    local sq = _espEnsureDrawBox(data); if not sq then return end
    pcall(function()

        sq.Position = Vector2.new(math.floor(L), math.floor(T))
        sq.Size     = Vector2.new(math.floor(w), math.floor(h))
        sq.Color    = col
        sq.Filled   = true
        sq.Visible  = false
    end)
