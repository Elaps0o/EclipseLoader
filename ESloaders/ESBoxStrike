    local function osPack(char)
        if OS[char] then return OS[char] end
        local pack = {}
        for i = 1, 3 do
            local l = Drawing.new("Line")
            l.Visible = false
            l.Thickness = 1.6
            l.Transparency = 1
            pack["a"..i] = l
        end
        local ring = Drawing.new("Circle")
        ring.Visible = false
        ring.Filled = false
        ring.Thickness = 1.4
        ring.NumSides = 24
        ring.Transparency = 1
        pack.ring = ring
        -- avatar via ImageLabel in ScreenGui (Drawing.Image not always available)
        local sg = Instance.new("ScreenGui")
        sg.Name = "ECLIPSE_OSAvatar"
        sg.ResetOnSpawn = false
        sg.IgnoreGuiInset = true
        sg.DisplayOrder = 50
        pcall(function()
            if gethui then sg.Parent = gethui() else sg.Parent = game:GetService("CoreGui") end
        end)
        local img = Instance.new("ImageLabel")
        img.BackgroundTransparency = 1
        img.Size = UDim2.fromOffset(18, 18)
        img.Visible = false
        img.ScaleType = Enum.ScaleType.Fit
        img.Parent = sg
        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(1, 0)
        corner.Parent = img
        pack.img = img
        pack.sg = sg
        OS[char] = pack
        return pack
    end
    local function hideOS(char)
        local pack = OS[char]
        if not pack then return end
        for i = 1, 3 do pack["a"..i].Visible = false end
        pack.ring.Visible = false
        if pack.img then pack.img.Visible = false end
    end
    local function setAvatar(pack, userId)
        if not pack or not pack.img or pack._uid == userId then return end
        pack._uid = userId
        pcall(function()
            pack.img.Image = string.format("rbxthumb://type=AvatarHeadShot&id=%d&w=48&h=48", userId)
        end)
    end

    local function drawArrow(pack, tip, dir, size, col)
        -- outline triangle only (no fill)
        local perp = Vector2.new(-dir.Y, dir.X)
        local base = tip - dir * size
        local p1 = tip
        local p2 = base + perp * (size * 0.55)
        local p3 = base - perp * (size * 0.55)
        local pts = {p1, p2, p3, p1}
        for i = 1, 3 do
            local l = pack["a"..i]
            l.From = pts[i]
            l.To = pts[i+1]
            l.Color = col
            l.Thickness = 1.6
            l.Visible = true
        end
        return base
    end

    RunService.RenderStepped:Connect(function()
        pcall(function()
            local espOn = _G.ECLIPSE_ESPKeyActive and _G.ECLIPSE_ESPKeyActive() or (Toggles.ESPEnabled and Toggles.ESPEnabled.Value)
            local offOn = espOn and Toggles.ESPOffScreen and Toggles.ESPOffScreen.Value
            if not offOn then
                for char, _ in pairs(OS) do hideOS(char) end
                return
            end
            local cam = Workspace.CurrentCamera
            if not cam then return end
            local vp = cam.ViewportSize
            local cx, cy = vp.X * 0.5, vp.Y * 0.5
            local edgeR = Options.ESPOffScreenRadius and Options.ESPOffScreenRadius.Value or 0.42
            local size = Options.ESPOffScreenSize and Options.ESPOffScreenSize.Value or 14
            local col = Options.ESPOffScreenColor and Options.ESPOffScreenColor.Value or Color3.fromRGB(255,255,255)
            local myTeam = get_player_team and get_player_team(LP) or nil
            local teamCheck = Toggles.ESPTeamCheck and Toggles.ESPTeamCheck.Value
            local seen = {}

            local function process(char, plr)
                if not char or char == LP.Character then return end
                local root = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head")
                if not root then return end
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health <= 0 then return end
                if teamCheck and plr and myTeam ~= nil then
                    local pt = get_player_team(plr)
                    if pt ~= nil and pt == myTeam then return end
                end
                local sp, onScreen = cam:WorldToViewportPoint(root.Position)
                -- behind / off-screen only
                local off = (not onScreen) or sp.Z < 0 or sp.X < 0 or sp.Y < 0 or sp.X > vp.X or sp.Y > vp.Y
                if not off then
                    hideOS(char)
                    return
                end
                seen[char] = true
                local pack = osPack(char)
                -- direction from center to projected (clamp to edge ellipse)
                local dx = sp.X - cx
                local dy = sp.Y - cy
                if sp.Z < 0 then dx, dy = -dx, -dy end
                local mag = math.sqrt(dx*dx + dy*dy)
                if mag < 1 then dx, dy = 0, -1; mag = 1 end
                local dir = Vector2.new(dx/mag, dy/mag)
                local rx, ry = vp.X * edgeR, vp.Y * edgeR
                -- intersect with ellipse
                local t = 1 / math.sqrt((dir.X*dir.X)/(rx*rx) + (dir.Y*dir.Y)/(ry*ry))
                local tip = Vector2.new(cx + dir.X * t, cy + dir.Y * t)
                local base = drawArrow(pack, tip, dir, size, col)
                -- small ring below arrow
                local ringPos = base + dir * 6
                pack.ring.Position = ringPos
                pack.ring.Radius = 10
                pack.ring.Color = col
                pack.ring.Visible = true
                if plr then
                    setAvatar(pack, plr.UserId)
                    if pack.img then
                        pack.img.Position = UDim2.fromOffset(ringPos.X - 9, ringPos.Y - 9)
                        pack.img.Visible = true
                    end
                end
            end

            local folder = Workspace:FindFirstChild("Characters")
            if folder then
                for _, m in ipairs(folder:GetChildren()) do
                    if m:IsA("Model") then
                        local plr = Players:GetPlayerFromCharacter(m)
                        process(m, plr)
                    end
                end
            else
                for _, plr in ipairs(Players:GetPlayers()) do
                    if plr ~= LP and plr.Character then process(plr.Character, plr) end
                end
            end
            for char, _ in pairs(OS) do
                if not seen[char] then hideOS(char) end
            end
        end)
    end)

    ----------------------------------------------------------------
    -- FOOTSTEP ESP — circles on ground where enemies walk
    ----------------------------------------------------------------
    local Steps = {} -- {pos, t, draw}
    local lastStepPos = {} -- [char] = Vector3
    RunService.Heartbeat:Connect(function()
        pcall(function()
            if not (Toggles.ESPFootstep and Toggles.ESPFootstep.Value) then return end
            local espOn = _G.ECLIPSE_ESPKeyActive and _G.ECLIPSE_ESPKeyActive() or (Toggles.ESPEnabled and Toggles.ESPEnabled.Value)
            if not espOn then return end
            local function track(char)
                local root = char and char:FindFirstChild("HumanoidRootPart")
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                if not root or not hum or hum.Health <= 0 then return end
                if hum.FloorMaterial == Enum.Material.Air or hum.FloorMaterial == Enum.Material.ForceField then return end
                local pos = root.Position - Vector3.new(0, 2.9, 0)
                local last = lastStepPos[char]
                if last and (pos - last).Magnitude < 2.2 then return end
                lastStepPos[char] = pos
                local c = Drawing.new("Circle")
                c.Filled = false
                c.Thickness = 1.2
                c.NumSides = 20
                c.Visible = false
                c.Color = Options.ESPFootstepColor and Options.ESPFootstepColor.Value or Color3.fromRGB(180,180,200)
                Steps[#Steps+1] = { pos = pos, t = tick(), draw = c, r = 0.4 }
            end
            local folder = Workspace:FindFirstChild("Characters")
            if folder then
                for _, m in ipairs(folder:GetChildren()) do
                    if m:IsA("Model") and m ~= LP.Character then track(m) end
                end
            else
                for _, plr in ipairs(Players:GetPlayers()) do
                    if plr ~= LP and plr.Character then track(plr.Character) end
                end
            end
        end)
    end)
    RunService.RenderStepped:Connect(function()
        pcall(function()
            local life = Options.ESPFootstepLife and Options.ESPFootstepLife.Value or 1.2
            local cam = Workspace.CurrentCamera
            if not cam then return end
            local now = tick()
            local i = 1
            while i <= #Steps do
                local s = Steps[i]
                local age = now - s.t
                if age > life then
                    pcall(function() s.draw:Remove() end)
                    table.remove(Steps, i)
                else
                    local sp, on = cam:WorldToViewportPoint(s.pos)
                    local alpha = 1 - (age / life)
                    if on and sp.Z > 0 then
                        s.draw.Position = Vector2.new(sp.X, sp.Y)
                        s.draw.Radius = 4 + age * 10
                        s.draw.Transparency = alpha
                        s.draw.Visible = true
                    else
                        s.draw.Visible = false
                    end
                    i = i + 1
                end
            end
        end)
    end)
end

