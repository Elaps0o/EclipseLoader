function _espDrawArrow(data, root)
    local vs = Camera.ViewportSize
    local cx, cy = vs.X/2, vs.Y/2
    local sp = Camera:WorldToViewportPoint(root.Position)
    local sx, sy, behind = sp.X, sp.Y, (sp.Z <= 0)
    if behind then
        sx = vs.X - sx
        sy = vs.Y - sy
    end
    local dx, dy = sx - cx, sy - cy
    if dx == 0 and dy == 0 then dx = 0.0001 end
    local onScreen = (not behind) and sx >= 0 and sx <= vs.X and sy >= 0 and sy <= vs.Y
    if onScreen then
        _espHideDrawArrow(data)
        if data.GuiArrow then data.GuiArrow.Visible = false end
        return
    end
    local ang = math.atan2(dy, dx)
    local rad = math.min(cx, cy) - 80
    local tipX = cx + math.cos(ang) * rad
    local tipY = cy + math.sin(ang) * rad
    local col  = Config.ESP.ArrowsColor or Color3.fromRGB(255,255,255)

    if _DRAW_OK and _espSyncDrawArrow(data, tipX, tipY, ang, col) then
        if data.GuiArrow then data.GuiArrow.Visible = false end
        return
    end
    local t = _espEnsureArrowGui(data)
    if not t then return end
    t.Position = UDim2.fromOffset(tipX, tipY)
    t.Rotation = math.deg(ang) + 90
    t.TextColor3 = col
    t.Visible = true
end

function _espDrawCornerBox(data, plr, L, R, T, B, cW, cH)

    local col
    if Config.ESP.VisibleCheck and not IsAlly(plr) then
        local ch = plr.Character
        local head = ch and (ch:FindFirstChild("Head") or ch:FindFirstChild("HumanoidRootPart"))
        local vis = head and IsVisible(head)
        col = vis and Config.ESP.VisibleBoxColor or Config.ESP.InvisibleBoxColor
    else
        col = IsAlly(plr) and Config.ESP.AllyBoxColor or Config.ESP.BoxColor
    end
    if typeof(col) ~= "Color3" then col = Color3.fromRGB(230, 45, 55) end

    if data.CornerLines then for _, l in pairs(data.CornerLines) do l.Visible = false end end
    if data.BoxGlow     then for _, l in pairs(data.BoxGlow)     do l.Visible = false end end

    local f = _espEnsureBoxGui(data)
    if not f then return end

    local style = tostring(Config.ESP.CornerBoxStyle or "Corner")
    local w = math.max(2, R - L)
    local h = math.max(2, B - T)
    f.Position = UDim2.fromOffset(math.floor(L), math.floor(T))
    f.Size     = UDim2.fromOffset(math.floor(w), math.floor(h))

    local darker = Color3.new(
        math.clamp(col.R * 0.45, 0, 1),
        math.clamp(col.G * 0.30, 0, 1),
        math.clamp(col.B * 0.65, 0, 1)
    )
    if data.GuiBoxGrad then
        data.GuiBoxGrad.Color = ColorSequence.new(col, darker)
    end

    if style == "Outline" then
        f.BackgroundTransparency = 1
        if data.GuiBoxStroke then
            data.GuiBoxStroke.Color = col
            data.GuiBoxStroke.Thickness = 1.4
            data.GuiBoxStroke.Transparency = 0.05
        end
    elseif style == "Full" then

        f.BackgroundColor3 = col
        f.BackgroundTransparency = 0.35
        if data.GuiBoxStroke then
            data.GuiBoxStroke.Color = col
            data.GuiBoxStroke.Thickness = 1.0
            data.GuiBoxStroke.Transparency = 0.15
        end
    else

        f.BackgroundColor3 = col
        f.BackgroundTransparency = 0.55
        if data.GuiBoxStroke then
            data.GuiBoxStroke.Color = col
            data.GuiBoxStroke.Thickness = 1.2
            data.GuiBoxStroke.Transparency = 0.10
        end
    end
    f.Visible = true
    _espSyncDrawBoxGeom(data, L, T, w, h, col)
end

function _espNum(v)
    if type(v) == "number" then return v end
    if type(v) == "string" then return tonumber(v) end
    return nil
end

function _espReadNumber(inst, keys)
    if not inst then return nil end
    for _, key in ipairs(keys) do
        local okA, av = pcall(function() return inst:GetAttribute(key) end)
        local n = okA and _espNum(av) or nil
        if n ~= nil then return n end
        local obj = inst:FindFirstChild(key, true)
        if obj and (obj:IsA("NumberValue") or obj:IsA("IntValue")) then
            n = _espNum(obj.Value)
            if n ~= nil then return n end
        end
    end
    return nil
end

function _espHealthValues(plr, char, hum)
    local hpKeys = {"Health","HP","CurrentHealth","CurrentHP","health","hp"}
    local maxKeys = {"MaxHealth","MaxHP","HealthMax","Max","maxHealth","maxhp"}
    local hum2 = hum or (char and char:FindFirstChildOfClass("Humanoid"))
    local hp, mx

    if hum2 then
        hp = _espNum(hum2.Health)
        mx = _espNum(hum2.MaxHealth)
    end

    if not hp then
        hp = _espReadNumber(char, hpKeys) or _espReadNumber(plr, hpKeys)
    end
    if not mx or mx <= 0 then
        mx = _espReadNumber(char, maxKeys) or _espReadNumber(plr, maxKeys) or mx
    end
    if not hp then return nil, nil end
    if not mx or mx <= 0 then mx = math.max(100, hp) end

    if hp <= 0 and hum2 and hum2:GetState() ~= Enum.HumanoidStateType.Dead then
        hp = 1
    end
    return math.clamp(hp, 0, mx), mx
end

_ESP_HP_COLS = {
    Color3.fromRGB(70, 230, 130),
    Color3.fromRGB(240, 220, 60),
    Color3.fromRGB(255, 150, 50),
    Color3.fromRGB(255, 65, 65),
}
local function _espHpGradAt(f)

    f = math.clamp(f, 0, 1)
    local G, Y, O, R = _ESP_HP_COLS[1], _ESP_HP_COLS[2], _ESP_HP_COLS[3], _ESP_HP_COLS[4]
    local function L(a, b, t)
        return Color3.new(a.R+(b.R-a.R)*t, a.G+(b.G-a.G)*t, a.B+(b.B-a.B)*t)
    end
    if f < 1/3 then return L(G, Y, f * 3) end
    if f < 2/3 then return L(Y, O, (f - 1/3) * 3) end
    return L(O, R, (f - 2/3) * 3)
end

function _espDrawHealth(data, hp, maxHp, L, R, T, B, height)
    local hSide = _espSlotSide("Health")
    local bx = (hSide == "Right") and (R + 10) or (L - 10)
    local pct = math.clamp((hp or 0) / math.max(maxHp or 100, 1), 0, 1)

    data.HealthBg.From = Vector2.new(bx, T)
    data.HealthBg.To = Vector2.new(bx, B)
    data.HealthBg.Thickness = 2
    data.HealthBg.Color = Color3.fromRGB(6, 6, 9)
    data.HealthBg.Transparency = 0.55
    data.HealthBg.Visible = true

    data.HealthFill.Visible = false
    data.HealthText.Visible = false

    local maxSegs = #data.HealthSegments
    local segments = math.clamp(math.floor(height / 3), 10, maxSegs)
    local thickness = (height < 40) and 2 or 2

    for i = 1, maxSegs do
        local seg = data.HealthSegments[i]
        if i <= segments then
            local aTop = (i - 1) / segments
            local bBot = i / segments
            local center = (aTop + bBot) * 0.5
            if (1 - center) <= pct then
                seg.From = Vector2.new(bx, T + height * aTop)
                seg.To   = Vector2.new(bx, T + height * bBot + 1)
                seg.Thickness = thickness
                seg.Transparency = 1
                seg.Color = _espHpGradAt(center)
                seg.Visible = true
            else
                seg.Visible = false
            end
        else
            seg.Visible = false
        end
    end

    if data.HealthTicks then
        for _, tk in ipairs(data.HealthTicks) do tk.Visible = false end
    end
end

function _espDrawSkeleton(data, char)
    local col = Config.ESP.SkeletonColor
    local useDraw = _DRAW_OK and data.Skeleton and (type(data.Skeleton[1]) ~= "table")
    local shown = {}
    for i, bone in ipairs(SkeletonBones) do
        local drew = false
        local a = char:FindFirstChild(bone[1])
        local b = char:FindFirstChild(bone[2])
        if a and b and a:IsA("BasePart") and b:IsA("BasePart") then
            local pa, oa = Camera:WorldToViewportPoint(a.Position)
            local pb, ob = Camera:WorldToViewportPoint(b.Position)
            if oa and ob then
                if useDraw then
                    local ln = data.Skeleton[i]
                    if ln then
                        pcall(function()
                            ln.From      = Vector2.new(pa.X, pa.Y)
                            ln.To        = Vector2.new(pb.X, pb.Y)
                            ln.Color     = col
                            ln.Thickness = 1
                            ln.Visible   = true
                            ln.ZIndex    = 20
                        end)
                        shown[i] = true
                        drew = true
                    end
                else
                    local f = _espEnsureLine(data, "GuiSkeleton", i)
                    if f then
                        _espSetLine(f, pa.X, pa.Y, pb.X, pb.Y, col, 1.5)
                        shown[i] = true
                        drew = true
                    end
                end
            end
        end
        if not drew then
            if useDraw and data.Skeleton[i] then pcall(function() data.Skeleton[i].Visible = false end) end
        end
    end

    if useDraw then
        if data.GuiSkeleton then for _, f in pairs(data.GuiSkeleton) do f.Visible = false end end
    else
        if data.Skeleton then
            for i, ln in pairs(data.Skeleton) do
                if type(ln) ~= "table" then pcall(function() ln.Visible = false end) end
            end
        end
        if data.GuiSkeleton then
            for i, f in pairs(data.GuiSkeleton) do if not shown[i] then f.Visible = false end end
        end
    end
end

function _espDrawChinaHat(data, char)
    local useDraw = _DRAW_OK and data.ChinaHat and (type(data.ChinaHat[1]) ~= "table")
    local head = char:FindFirstChild("Head")
    if not head or not head:IsA("BasePart") then
        if data.ChinaHat then for _, l in pairs(data.ChinaHat) do pcall(function() l.Visible=false end) end end
        if data.GuiChinaHat then for _, f in pairs(data.GuiChinaHat) do f.Visible = false end end
        return
    end
    local col     = Config.ESP.ChinaHatColor or Color3.fromRGB(220,220,220)
    local sizeMul = tonumber(Config.ESP.ChinaHatSize) or 1.0
    local hMul    = tonumber(Config.ESP.ChinaHatHeight) or 1.15
    local n       = math.clamp(math.floor(tonumber(Config.ESP.ChinaHatSegments) or 12), 4, 32)
    local thick   = tonumber(Config.ESP.ChinaHatThickness) or 1.2
    local size    = head.Size
    local baseR   = math.max(size.X, size.Z) * 0.9 * sizeMul
    local peakUp  = math.max(size.Y, 1) * hMul

    local headPos = head.Position
    local peakWorld = headPos + Vector3.new(0, peakUp, 0)
    local pk, pkOn = Camera:WorldToViewportPoint(peakWorld)
    if not pkOn then
        if data.ChinaHat then for _, l in pairs(data.ChinaHat) do pcall(function() l.Visible=false end) end end
        if data.GuiChinaHat then for _, f in pairs(data.GuiChinaHat) do f.Visible = false end end
        return
    end
    local shown = {}
    for i = 1, n do
        local ang = (i - 1) * (math.pi * 2 / n)
        local offPos = headPos + Vector3.new(math.cos(ang) * baseR, 0, math.sin(ang) * baseR)
        local sp, spOn = Camera:WorldToViewportPoint(offPos)
        if spOn then
            if useDraw then
                local ln = data.ChinaHat[i]
                if ln then
                    pcall(function()
                        ln.From      = Vector2.new(sp.X, sp.Y)
                        ln.To        = Vector2.new(pk.X, pk.Y)
                        ln.Color     = col
                        ln.Thickness = thick
                        ln.Visible   = true
                        ln.ZIndex    = 20
                    end)
                    shown[i] = true
                end
            else
                local f = _espEnsureLine(data, "GuiChinaHat", i)
                if f then
                    _espSetLine(f, sp.X, sp.Y, pk.X, pk.Y, col, thick)
                    shown[i] = true
                end
            end
        end
    end
    if useDraw then
        for i, ln in pairs(data.ChinaHat) do
            if not shown[i] then pcall(function() ln.Visible = false end) end
        end
        if data.GuiChinaHat then for _, f in pairs(data.GuiChinaHat) do f.Visible = false end end
    else
        if data.ChinaHat then
            for _, ln in pairs(data.ChinaHat) do pcall(function() ln.Visible = false end) end
        end
        if data.GuiChinaHat then
            for i, f in pairs(data.GuiChinaHat) do if not shown[i] then f.Visible = false end end
        end
    end
end

function _espGetWeaponName(plr)
    local ok, attr = pcall(function() return plr:GetAttribute("CurrentEquipped") end)
    if ok and type(attr) == "string" and attr ~= "" then
        local okj, decoded = pcall(function() return HttpService:JSONDecode(attr) end)
        if okj and type(decoded) == "table" then
            local n = decoded.Name or decoded.Weapon or decoded.WeaponName or decoded.Item or decoded.Id
            n = _cleanHUDWeaponText and _cleanHUDWeaponText(tostring(n or "")) or tostring(n or "")
            if n and n ~= "" then return n end
        end
        local clean = _cleanHUDWeaponText and _cleanHUDWeaponText(attr) or attr
        if clean and clean ~= "" and clean:sub(1,1) ~= "{" then return clean end
    end
    local char = GetCharacter(plr) or plr.Character
    if char then
        local tool = char:FindFirstChildOfClass("Tool")
        if tool then
            local clean = _cleanHUDWeaponText and _cleanHUDWeaponText(tool.Name) or tool.Name
            if clean and clean ~= "" then return clean end
        end
        for _, key in ipairs({"CurrentWeapon","Weapon","EquippedWeapon","WeaponName"}) do
            local v = char:GetAttribute(key)
            local clean = _cleanHUDWeaponText and _cleanHUDWeaponText(tostring(v or "")) or tostring(v or "")
            if clean and clean ~= "" then return clean end
        end
    end
    for _, key in ipairs({"CurrentWeapon","Weapon","EquippedWeapon","WeaponName"}) do
        local v = plr:GetAttribute(key)
        local clean = _cleanHUDWeaponText and _cleanHUDWeaponText(tostring(v or "")) or tostring(v or "")
        if clean and clean ~= "" then return clean end
    end
    return nil
end

function _espGetPlayerAmmo(plr, weaponName)
    local function num(v) return (type(v) == "number") and v or tonumber(v) end
    local cur, mx
    local ok1 = pcall(function()
        cur = num(plr:GetAttribute("Ammo") or plr:GetAttribute("Bullets") or plr:GetAttribute("CurrentAmmo") or plr:GetAttribute("Clip") or plr:GetAttribute("AmmoInClip"))
        mx  = num(plr:GetAttribute("MaxAmmo") or plr:GetAttribute("Magazine") or plr:GetAttribute("MagazineSize") or plr:GetAttribute("ClipSize"))
    end); if not ok1 then cur, mx = nil, nil end
    if not cur then
        local char = GetCharacter(plr) or plr.Character
        cur = _espReadNumber(char, {"Ammo","Bullets","CurrentAmmo","Clip","AmmoInClip"})
        mx  = mx or _espReadNumber(char, {"MaxAmmo","Magazine","MagazineSize","ClipSize"})
    end
    if not cur then
        local char = GetCharacter(plr) or plr.Character
        local tool = char and char:FindFirstChildOfClass("Tool")
        if tool then
            cur = num(tool:GetAttribute("Ammo") or tool:GetAttribute("Bullets") or tool:GetAttribute("CurrentAmmo") or tool:GetAttribute("Clip") or tool:GetAttribute("AmmoInClip"))
            mx  = mx or num(tool:GetAttribute("MaxAmmo") or tool:GetAttribute("MagazineSize") or tool:GetAttribute("ClipSize"))
        end
    end
    if not mx and weaponName and _weaponModule then
        local mod = _weaponModule(weaponName)
        if mod then
            pcall(function()
                mx = num(mod:GetAttribute("MagazineSize") or mod:GetAttribute("Magazine") or mod:GetAttribute("MaxAmmo"))
            end)
        end
    end
    if not cur or not mx or mx <= 0 then return nil end
    return math.max(0, cur), mx
end

