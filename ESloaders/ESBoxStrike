            seg.Shape = Enum.PartType.Cylinder
            seg.Size = Vector3.new(mag, 0.07, 0.07)
            seg.CFrame = CFrame.lookAt(a + d*0.5, b) * CFrame.Angles(0, math.rad(90), 0)
            seg.Color = col
            seg.Transparency = 0.1
        end
    end
    local impact = pts[#pts]
    local dotCol = hasPred and (Config.Grenade.DotColor or col) or col
    local ringR, ringN = 2.1, 12
    for i = 0, ringN - 1 do
        local ang = (i / ringN) * math.pi * 2
        used = used + 1
        local p = _g3dSegment(used)
        p.Shape = Enum.PartType.Ball
        p.Size = Vector3.new(0.16, 0.16, 0.16)
        p.CFrame = CFrame.new(impact + Vector3.new(math.cos(ang) * ringR, 0.05, math.sin(ang) * ringR))
        p.Color = dotCol
        p.Transparency = 0.08
    end
    for i = used+1, #_g3d.parts do
        if _g3d.parts[i] then _g3d.parts[i]:Destroy(); _g3d.parts[i]=nil end
    end
    if _g3d.dot then
        _g3d.dot.Size = Vector3.new(0.55, 0.55, 0.55)
        _g3d.dot.Position = impact
        _g3d.dot.Color = dotCol
    end

end

