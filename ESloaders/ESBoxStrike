function _espSyncDrawArrow(data, tipX, tipY, ang, col)
    if not _DRAW_OK then return false end
    local ar = ensureESPArrow and ensureESPArrow(data) or data.Arrow
    if not ar then return false end
    local sz = 10

    local bx = tipX + math.cos(ang + math.pi - 0.35) * sz
    local by = tipY + math.sin(ang + math.pi - 0.35) * sz
    local cX = tipX + math.cos(ang + math.pi + 0.35) * sz
    local cY = tipY + math.sin(ang + math.pi + 0.35) * sz
    pcall(function()
        ar.PointA = Vector2.new(tipX, tipY)
        ar.PointB = Vector2.new(bx, by)
        ar.PointC = Vector2.new(cX, cY)
        ar.Color  = col or Color3.fromRGB(255,255,255)
