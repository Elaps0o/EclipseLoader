-- SERVER HOP / REJOIN (ES-style)
do
    local TeleportService = game:GetService("TeleportService")
    local SHBox = Tabs.Settings:AddRightGroupbox("Server", "globe")
    SHBox:AddDropdown("ServerHopMode", {
        Text = "MODE",
        Values = { "Lowest Ping", "Most Players", "Least Players", "Random" },
        Default = "Lowest Ping",
    })
    local SH_BUSY = false
    local function pickServer()
        local url = string.format("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100", game.PlaceId)
        local ok, body = pcall(function() return game:HttpGet(url) end)
        if not ok or not body then return nil, "HTTP failed" end
        local ok2, data = pcall(function() return HttpService:JSONDecode(body) end)
        if not ok2 or type(data) ~= "table" or type(data.data) ~= "table" then return nil, "Bad JSON" end
        local pool = {}
        for _, s in ipairs(data.data) do
            if s.id ~= game.JobId and (s.playing or 0) < (s.maxPlayers or 99) then
                pool[#pool+1] = s
            end
        end
        if #pool == 0 then return nil, "No servers" end
        local mode = Options.ServerHopMode and Options.ServerHopMode.Value or "Lowest Ping"
        if mode == "Lowest Ping" then
            table.sort(pool, function(a,b) return (a.ping or 999) < (b.ping or 999) end)
        elseif mode == "Most Players" then
            table.sort(pool, function(a,b) return (a.playing or 0) > (b.playing or 0) end)
        elseif mode == "Least Players" then
            table.sort(pool, function(a,b) return (a.playing or 0) < (b.playing or 0) end)
        else
            for i = #pool, 2, -1 do local j = math.random(i); pool[i], pool[j] = pool[j], pool[i] end
        end
        return pool[1]
    end
    SHBox:AddButton({
        Text = "SERVER HOP",
        Func = function()
            if SH_BUSY then return end
            SH_BUSY = true
            task.spawn(function()
                local s, err = pickServer()
                if not s then
                    pcall(function() if Library.Notify then Library:Notify(err or "Failed", 3) end end)
                    SH_BUSY = false
                    return
                end
                pcall(function()
                    if Library.Notify then
                        Library:Notify(string.format("Teleport → %d players · %dms", s.playing or 0, s.ping or 0), 3)
                    end
                end)
                pcall(function() TeleportService:TeleportToPlaceInstance(game.PlaceId, s.id, LP) end)
                task.wait(4)
                SH_BUSY = false
            end)
        end,
    })
    SHBox:AddButton({
        Text = "REJOIN",
        Func = function()
            pcall(function() if Library.Notify then Library:Notify("Rejoining...", 2) end end)
            pcall(function() TeleportService:Teleport(game.PlaceId, LP) end)
        end,
    })
end

-- KILL ANIM TEXT + KILL INDICATOR (ES-style)
do
    local KAnim = Tabs.Misc:AddLeftGroupbox("Kill FX", "skull")
    KAnim:AddToggle("KillIndicator", { Text = "KILL INDICATOR", Default = false })
        :AddColorPicker("KillIndicatorColor", { Default = Color3.fromRGB(255, 255, 255), Title = "Flash" })
    KAnim:AddToggle("KillNameAnim", { Text = "KILL NAME ANIM", Default = false })
    KAnim:AddInput("KillNameText", { Text = "KILL NAME TEXT", Default = "EclipseHub", Placeholder = "EclipseHub" })
    KAnim:AddDropdown("KillNameAnimStyle", {
        Text = "ANIM STYLE",
        Values = { "Rainbow", "Reveal", "Glitch", "Wave" },
        Default = "Rainbow",
    })

    local _lastLethal = {}
    local _killDone = {}
    local function spawnKillIndicator()
        local pg = LP:FindFirstChildOfClass("PlayerGui")
        if not pg then return end
        local col = Options.KillIndicatorColor and Options.KillIndicatorColor.Value or Color3.new(1,1,1)
        local sg = Instance.new("ScreenGui")
        sg.Name = "ECLIPSE_KillIndicator"
        sg.IgnoreGuiInset = true
        sg.ResetOnSpawn = false
        sg.DisplayOrder = 200
        sg.Parent = pg
        local f = Instance.new("Frame")
        f.Size = UDim2.fromScale(1,1)
        f.BackgroundColor3 = col
        f.BackgroundTransparency = 1
        f.BorderSizePixel = 0
        f.Parent = sg
        TweenService:Create(f, TweenInfo.new(0.10, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
            { BackgroundTransparency = 0.65 }):Play()
        task.delay(0.10, function()
            local t = TweenService:Create(f, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
                { BackgroundTransparency = 1 })
            t:Play()
            t.Completed:Connect(function() pcall(function() sg:Destroy() end) end)
        end)
    end

    local function animateKillName()
        if not (Toggles.KillNameAnim and Toggles.KillNameAnim.Value) then return end
        task.spawn(function()
            local DURATION = 20.0
            local startedAt = tick()
            local finishAt = startedAt + DURATION
            local lpName = LP.Name
            local pg = LP:FindFirstChildOfClass("PlayerGui")
            if not pg or lpName == "" then return end
            local seen, originals = {}, {}
            local function collect()
                for _, d in ipairs(pg:GetDescendants()) do
                    if (d:IsA("TextLabel") or d:IsA("TextButton")) and not seen[d] then
                        local txt = d.Text
                        if type(txt) == "string" and txt:find(lpName, 1, true) then
                            seen[d] = true
                            originals[d] = { Text = txt }
                            pcall(function() d.RichText = true end)
                        end
                    end
                end
            end
            collect()
            local lastScan = tick()
            while tick() < finishAt do
                local t = tick()
                if t - lastScan > 1.0 then collect(); lastScan = t end
                local target = Options.KillNameText and Options.KillNameText.Value or "EclipseHub"
                if target == "" then target = "EclipseHub" end
                local style = Options.KillNameAnimStyle and Options.KillNameAnimStyle.Value or "Rainbow"
                local elapsed = t - startedAt
                local rich
                if style == "Reveal" then
                    local reveal = math.max(1, math.min(#target, math.floor(elapsed * (#target / 1.2))))
                    local shown = target:sub(1, reveal)
                    local pad = target:sub(reveal + 1):gsub(".", "_")
                    rich = string.format('<b><font color="#ffffff">%s</font><font color="#444444">%s</font></b>', shown, pad)
                elseif style == "Glitch" then
                    local hex = ({"#ff00aa","#00ffee","#ffee00","#ffffff"})[((math.floor(t * 10)) % 4) + 1]
                    local buf = {}
                    for i = 1, #target do
                        local c = target:sub(i, i)
                        if math.random() < 0.15 then c = string.char(math.random(33, 126)) end
                        buf[#buf+1] = c
                    end
                    rich = string.format('<b><font color="%s">%s</font></b>', hex, table.concat(buf))
                elseif style == "Wave" then
                    local buf = {}
                    for i = 1, #target do
                        local h = ((t * 0.8) + i * 0.08) % 1
                        local c = Color3.fromHSV(h, 1, 1)
                        buf[#buf+1] = string.format('<font color="#%02X%02X%02X">%s</font>',
                            math.floor(c.R*255), math.floor(c.G*255), math.floor(c.B*255), target:sub(i,i))
                    end
                    rich = "<b>" .. table.concat(buf) .. "</b>"
                else
                    local h = (t * 0.6) % 1
                    local c = Color3.fromHSV(h, 1, 1)
                    local hex = string.format("#%02X%02X%02X", math.floor(c.R*255), math.floor(c.G*255), math.floor(c.B*255))
                    rich = string.format('<b><font color="%s">%s</font></b>', hex, target)
                end
                local safeName = lpName:gsub("(%W)", "%%%1")
                local safeTag = rich:gsub("%%", "%%%%")
                for d, orig in pairs(originals) do
                    if d.Parent and orig then
                        local ok, newText = pcall(string.gsub, orig.Text, safeName, safeTag)
                        if ok and newText then pcall(function() d.Text = newText end) end
                    end
                end
                task.wait(0.05)
            end
            for d, orig in pairs(originals) do
                if d.Parent and orig then pcall(function() d.Text = orig.Text end) end
            end
        end)
    end

    _G.ECLIPSE_MarkKillDamage = function(plr)
        if plr and plr ~= LP then _lastLethal[plr] = tick() end
    end
    RunService.Heartbeat:Connect(function()
        pcall(function()
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= LP then
                    local char = plr.Character
                    local hum = char and char:FindFirstChildOfClass("Humanoid")
                    if hum and hum.Health <= 0 and char and not _killDone[char] then
                        local t = _lastLethal[plr]
                        if t and (tick() - t) < 5 then
                            _killDone[char] = true
                            if Toggles.KillIndicator and Toggles.KillIndicator.Value then
                                task.spawn(spawnKillIndicator)
                            end
                            if Toggles.KillNameAnim and Toggles.KillNameAnim.Value then
                                animateKillName()
                            end
                        end
                    end
                end
            end
        end)
    end)
end

-- SYNCHRONIZATION full (ES presence roster + [E] tags)
do
    local MainSyncBox = Tabs.Main:AddRightGroupbox("Sync", "radio")
    MainSyncBox:AddToggle("Main_Sync", {
        Text = "SYNCHRONIZATION",
        Default = false,
        Tooltip = "Connect to EclipseHub realtime. Other synced users get marked.",
    })
    local PresenceUsers = {}
    local presenceDirty = false
    local presenceLastSignature = ""
    local _presenceInflight = false
    local function markPresence(uid, on)
        if on then PresenceUsers[uid] = true else PresenceUsers[uid] = nil end
        presenceDirty = true
    end
    local function presenceSyncOnce(action)
        if _presenceInflight then return end
        if not (Toggles.Main_Sync and Toggles.Main_Sync.Value) and action == "heartbeat" then return end
        _presenceInflight = true
        pcall(function()
            local req = (syn and syn.request) or http_request or request
            if not req then return end
            local res = req({
                Url = EclipseHub.PresenceHTTP,
                Method = "POST",
                Headers = {
                    ["Content-Type"] = "application/json",
                    ["x-EclipseHub-key"] = EclipseHub.PresenceKey,
                    ["x-api-key"] = EclipseHub.PresenceKey,
                    ["x-presence-key"] = EclipseHub.PresenceKey,
                },
                Body = HttpService:JSONEncode({
                    action = action or "heartbeat",
                    placeId = tostring(game.PlaceId),
                    jobId = tostring(game.JobId or "solo"),
                    serverId = tostring(game.JobId or "solo"),
                    playerId = tostring(LP.UserId),
                    playerName = tostring(LP.Name),
                    version = EclipseHub.Version,
                }),
            })
            if not res or not res.Body then return end
            local ok, data = pcall(function() return HttpService:JSONDecode(res.Body) end)
            if not ok or type(data) ~= "table" or type(data.players) ~= "table" then return end
            local seen, sig = {}, {}
            for _, pl in ipairs(data.players) do
                local uid = tonumber(pl.playerId)
                if uid and uid ~= LP.UserId then
                    seen[uid] = true
                    sig[#sig+1] = tostring(uid)
                    markPresence(uid, true)
                end
            end
            table.sort(sig)
            local nextSig = table.concat(sig, ",")
            if nextSig ~= presenceLastSignature then
                presenceLastSignature = nextSig
                presenceDirty = true
            end
            for uid in pairs(PresenceUsers) do
                if not seen[uid] then markPresence(uid, false) end
            end
        end)
        _presenceInflight = false
    end
    task.spawn(function()
        presenceSyncOnce("join")
        while true do
            task.wait(8 + math.random() * 2)
            if Toggles.Main_Sync and Toggles.Main_Sync.Value then
                presenceSyncOnce("heartbeat")
            end
        end
    end)
    RunService.Heartbeat:Connect(function()
        pcall(function()
            if not (Toggles.Main_Sync and Toggles.Main_Sync.Value) then return end
            if not presenceDirty and math.random() > 0.05 then return end
            presenceDirty = false
            for _, plr in ipairs(Players:GetPlayers()) do
                if PresenceUsers[plr.UserId] then
                    local char = plr.Character
                    local head = char and char:FindFirstChild("Head")
                    if head and not head:FindFirstChild("ECLIPSE_SyncTag") then
                        local bb = Instance.new("BillboardGui")
                        bb.Name = "ECLIPSE_SyncTag"
                        bb.Size = UDim2.fromOffset(40, 18)
                        bb.StudsOffset = Vector3.new(0, 2.4, 0)
                        bb.AlwaysOnTop = true
                        bb.Parent = head
                        local tl = Instance.new("TextLabel")
                        tl.BackgroundTransparency = 1
                        tl.Size = UDim2.fromScale(1,1)
                        tl.Font = Enum.Font.GothamBold
                        tl.TextSize = 14
                        tl.TextColor3 = EclipseHub.PresenceColor or Color3.fromRGB(160, 90, 255)
                        tl.Text = "[E]"
                        tl.Parent = bb
                    end
                else
                    local char = plr.Character
                    local head = char and char:FindFirstChild("Head")
                    if head then
                        local bb = head:FindFirstChild("ECLIPSE_SyncTag")
                        if bb then bb:Destroy() end
                    end
                end
            end
        end)
    end)
    _G.ECLIPSE_PresenceUsers = PresenceUsers
end

