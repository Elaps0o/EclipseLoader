        else
            if conn then conn:Disconnect(); conn = nil end
            if root then root.Visible = false end
        end
    end

    function PV.Destroy()
        if conn then conn:Disconnect(); conn = nil end
        if gui then gui:Destroy() end
        gui, root, viewport, wm, pcam, rig, hum, overlay = nil, nil, nil, nil, nil, nil, nil, nil
    end
