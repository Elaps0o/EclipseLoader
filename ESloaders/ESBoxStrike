        end
    end

    local function _animateLocalKillName()
        if not Config.GlobalEnable or not Config.Visuals.KillNameAnim then return end
        task.spawn(function()
            local DURATION = 20.0
            local startedAt = tick()
            local finishAt  = startedAt + DURATION
            local lpName = LocalPlayer and LocalPlayer.Name or ""
            if lpName == "" then return end
            local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
            if not pg then return end
            local seen, originals = {}, {}
            local function collect()
                for _, d in ipairs(pg:GetDescendants()) do
                    if (d:IsA("TextLabel") or d:IsA("TextButton")) and not seen[d] then
                        local txt = d.Text
                        if type(txt) == "string" and txt:find(lpName, 1, true) then
                            seen[d] = true
                            originals[d] = { Text = txt, RichText = d.RichText }
                            pcall(function() d.RichText = true end)
                        end
                    end
                end
            end
            collect()
            local lastScan = tick()
            local iconAsset = _resolveECLIPSE_HUBogoAsset and _resolveECLIPSE_HUBogoAsset() or nil
            local iconTag = ""
            if type(iconAsset) == "string" and iconAsset ~= "" then
                iconTag = string.format('<img src="%s" width="16" height="16"/> ', iconAsset)
            end
            while tick() < finishAt do
                local t = tick()
                if t - lastScan > 1.0 then collect(); lastScan = t end
                local elapsed = t - startedAt
                local target = tostring(Config.Visuals.KillNameText or "EclipseHub")
                if target == "" then target = "EclipseHub" end
                local style  = tostring(Config.Visuals.KillNameAnimStyle or "Rainbow")
                local rich
                if style == "Reveal" then
                    local reveal = math.max(1, math.min(#target, math.floor(elapsed * (#target / 1.2))))
                    local shown  = target:sub(1, reveal)
                    local pad    = target:sub(reveal + 1):gsub(".", "_")
                    rich = string.format('<b><font color="#ffffff">%s</font><font color="#444444">%s</font></b>', shown, pad)
                elseif style == "Glitch" then
                    local hex = ({"#ff00aa","#00ffee","#ffee00","#ffffff"})[((math.floor(t * 10)) % 4) + 1]
                    local buf = {}
                    for i = 1, #target do
                        local c = target:sub(i, i)
                        if math.random() < 0.15 then c = string.char(math.random(33, 126)) end
                        buf[#buf + 1] = c
                    end
                    rich = string.format('<b><font color="%s">%s</font></b>', hex, table.concat(buf))
                elseif style == "Wave" then
                    local buf = {}
                    for i = 1, #target do
                        local h = ((t * 0.8) + i * 0.08) % 1
                        local c = Color3.fromHSV(h, 1, 1)
                        buf[#buf + 1] = string.format('<font color="#%02X%02X%02X">%s</font>',
                            math.floor(c.R * 255), math.floor(c.G * 255), math.floor(c.B * 255), target:sub(i, i))
                    end
                    rich = "<b>" .. table.concat(buf) .. "</b>"
                else
                    local h = (t * 0.6) % 1
                    local c = Color3.fromHSV(h, 1, 1)
                    local hex = string.format("#%02X%02X%02X",
                        math.floor(c.R * 255), math.floor(c.G * 255), math.floor(c.B * 255))
                    rich = string.format('<b><font color="%s">%s</font></b>', hex, target)
                end
                local finalTag = iconTag .. rich

                local safeTag = finalTag:gsub("%%", "%%%%")
                local safeName = lpName:gsub("(%W)", "%%%1")
                for d, orig in pairs(originals) do
                    if type(d) == "userdata" and d.Parent and orig then
                        local ok, newText = pcall(string.gsub, orig.Text, safeName, safeTag)
                        if ok and newText then
                            pcall(function() d.Text = newText end)
                        end
                    end
                end
                task.wait(0.08)
            end
            for d, orig in pairs(originals) do
                if type(d) == "userdata" and d.Parent and orig then
                    pcall(function() d.Text = orig.Text; d.RichText = orig.RichText end)
                end
            end
        end)
    end

