function _espAnimScale()

    local dt = tick() - _ESP_ANIM.t0
    local p  = math.clamp(dt / math.max(0.01, _ESP_ANIM.dur), 0, 1)

    local eased
    if _ESP_ANIM.on then
        local c1, c3 = 1.70158, 2.70158
        eased = 1 + c3 * (p-1)^3 + c1 * (p-1)^2
        eased = math.clamp(eased, 0, 1.15)
    else
        eased = 1 - p*p
    end
    return math.max(0, eased)
end

_ESP_FADE_TICK = _ESP_FADE_TICK or tick()
_ESP_FADE_KEYS = { "NameTag","DistTag","WeaponTag","HealthBg","HealthFill",
    "HealthText","TagBg","TagText","WeaponIcon","MoneyText","HeadDot",
    "Presence","Arrow","TagAmmoBg","TagAmmoFill",
    "DrawMoney","DrawAmmoBg","DrawAmmoFill" }
_ESP_FADE_ARR  = { "CornerLines","HealthSegments","HealthTicks","Skeleton","ChinaHat",
    "TagBorder","TagGrad" }

function _espApplyAlpha(data, alpha)
    alpha = math.clamp(alpha, 0, 1)
    for _, k in ipairs(_ESP_FADE_KEYS) do
        local d = data[k]
        if d then
            pcall(function()
                if alpha <= 0.02 then
                    d.Visible = false
                elseif d.Visible then
                    d.Transparency = alpha
                end
            end)
        end
    end
    for _, k in ipairs(_ESP_FADE_ARR) do
        local arr = data[k]
        if arr then
            for _, d in pairs(arr) do
                pcall(function()
                    if alpha <= 0.02 then
                        d.Visible = false
                    elseif d.Visible then
                        d.Transparency = alpha
                    end
                end)
            end
        end
    end

    if data.GuiBox then
        pcall(function()
            if alpha <= 0.02 then
                data.GuiBox.Visible = false
            elseif data.GuiBox.Visible then

                if _DRAW_OK and data.DrawBox then
                    data.GuiBox.BackgroundTransparency = 1
                    if data.GuiBoxStroke then data.GuiBoxStroke.Transparency = 1 end
                    if data.GuiBoxGrad   then data.GuiBoxGrad.Transparency = NumberSequence.new(1, 1) end
                else
                    if data.GuiBox.BackgroundTransparency < 1 then
                        data.GuiBox.BackgroundTransparency = 1 - (1 - 0.55) * alpha
                    end
                    if data.GuiBoxStroke then
                        data.GuiBoxStroke.Transparency = 1 - (1 - 0.10) * alpha
                    end
                    if data.GuiBoxGrad then
                        data.GuiBoxGrad.Transparency = NumberSequence.new(
                            1 - (1 - 0.30) * alpha,
                            1 - (1 - 0.10) * alpha
                        )
                    end
                end
            end
        end)
    end

    if data.DrawBox then
        pcall(function()
            if alpha <= 0.02 then
                data.DrawBox.Visible = false
                if data.DrawBoxBorder then data.DrawBoxBorder.Visible = false end
                if data.DrawBoxGrad then
                    for _, ln in ipairs(data.DrawBoxGrad) do ln.Visible = false end
                end
            else

                data.DrawBox.Visible = false
                if data.DrawBoxBorder and data.DrawBoxBorder.Visible then
                    data.DrawBoxBorder.Transparency = math.clamp(0.90 * alpha, 0, 1)
                end
                if data.DrawBoxGrad then
                    local pool = data.DrawBoxGrad

                    local vis = 0
                    for i = 1, #pool do if pool[i] and pool[i].Visible then vis = i else break end end
                    if vis > 0 then
                        for i = 1, vis do
                            local ln = pool[i]
                            if ln then

                                local f = (i - 0.5) / vis

                                local opa = (1 - f) * 0.55
                                ln.Transparency = math.clamp(opa * alpha, 0, 1)
                            end
                        end
                    end
                end
            end
        end)
    end
    if data.GuiHeadDot then
        pcall(function()
            if alpha <= 0.02 then
                data.GuiHeadDot.Visible = false
            elseif data.GuiHeadDot.Visible then
                data.GuiHeadDot.BackgroundTransparency = 1 - alpha
                if data.GuiHeadDotStroke then
                    data.GuiHeadDotStroke.Transparency = 1 - 0.75 * alpha
                end
            end
        end)
    end
    if data.GuiTag then
        pcall(function()
            if alpha <= 0.02 then
                data.GuiTag.Visible = false
                if data.GuiTagBot then data.GuiTagBot.Visible = false end
            elseif data.GuiTag.Visible or (data.GuiTagBot and data.GuiTagBot.Visible) then

                data.GuiTag.BackgroundTransparency = 1
                if data.GuiTagStroke then data.GuiTagStroke.Transparency = 1 end
                if data.GuiTagName then
                    if _DRAW_OK and data.DrawName then
                        data.GuiTagName.TextTransparency       = 1
                        data.GuiTagName.TextStrokeTransparency = 1
                    else
                        data.GuiTagName.TextTransparency       = 1 - alpha
                        data.GuiTagName.TextStrokeTransparency = 1 - (1 - 0.4) * alpha
                    end
                end
                if data.DrawName then
                    if alpha <= 0.02 then
                        data.DrawName.Visible = false
                    elseif data.DrawName.Visible then
                        data.DrawName.Transparency = math.clamp(alpha, 0, 1)
                    end
                end
                if data.GuiTagDist then
                    data.GuiTagDist.TextTransparency = 1 - alpha
                    data.GuiTagDist.TextStrokeTransparency = 1 - (1 - 0.4) * alpha
                end
                if data.GuiTagIcon then
                    data.GuiTagIcon.ImageTransparency = 1 - alpha
                end
            end
        end)
    end
    if data.GuiAmmo then
        pcall(function()
            if alpha <= 0.02 then
                data.GuiAmmo.Visible = false
            elseif data.GuiAmmo.Visible then
                data.GuiAmmo.BackgroundTransparency = 1 - (1 - 0.35) * alpha
                if data.GuiAmmoFill then
                    data.GuiAmmoFill.BackgroundTransparency = 1 - alpha
                end
            end
        end)
    end
    if data.GuiMoney then
        pcall(function()
            if alpha <= 0.02 then
                data.GuiMoney.Visible = false
            elseif data.GuiMoney.Visible then
                data.GuiMoney.TextTransparency = 1 - alpha
                data.GuiMoney.TextStrokeTransparency = 1 - (1 - 0.3) * alpha
            end
        end)
    end

    for _, key in ipairs({"GuiSkeleton", "GuiChinaHat"}) do
        local pool = data[key]
        if pool then
            for _, f in pairs(pool) do
                pcall(function()
                    if alpha <= 0.02 then
                        f.Visible = false
                    elseif f.Visible then
                        f.BackgroundTransparency = 1 - alpha
                    end
                end)
            end
        end
    end
    if data.GuiArrow then
        pcall(function()
            if alpha <= 0.02 then
                data.GuiArrow.Visible = false
            elseif data.GuiArrow.Visible then
                data.GuiArrow.TextTransparency = 1 - alpha
                data.GuiArrow.TextStrokeTransparency = 1 - (1 - 0.2) * alpha
            end
        end)
    end
end

function _espFadeTick()

    local now = tick()
    local dt  = now - (_ESP_FADE_TICK or now)
    _ESP_FADE_TICK = now
    if dt <= 0 then dt = 1/60 end
    local FADE_IN  = 1 / 0.12
    local FADE_OUT = 1 / 0.90
    for plr, data in pairs(ESPObjects) do
        local gone = (not plr) or (not plr.Parent)
        local a = data._alpha or 0
        local target
        if gone then
            target = 0
        elseif data._wantVisible and not data._frozen then
            target = 1
        else
            target = 0
        end
        if a < target then
            a = math.min(target, a + dt * FADE_IN)
        elseif a > target then

            if data._frozen then
                a = math.max(target, a - dt * FADE_OUT)
            else
                a = target
            end
        end
        data._alpha = a
        _espApplyAlpha(data, a)
        if a <= 0.02 then
            hideESP(data)
            local frozenTooLong = data._frozen and data._deathAt and (now - data._deathAt) > 2.0
            if gone or data._pendingDestroy or frozenTooLong or data._frozen then
                _espDestroyObjects(data)
                ESPObjects[plr] = nil
            end
        end
    end
end

