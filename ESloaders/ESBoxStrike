    local function newLine(parent, col)
        local f = Instance.new("Frame")
        f.BorderSizePixel = 0
        f.AnchorPoint = Vector2.new(0.5, 0.5)
        f.BackgroundColor3 = col or Color3.new(1,1,1)
        f.Size = UDim2.fromOffset(1,1)
        f.Visible = false
        f.ZIndex = 5
        f.Parent = parent
        return f
    end

    local function setLine(f, a, b, thick, col)
        if not a or not b then f.Visible = false return end
        local d = b - a
        local mag = d.Magnitude
        if mag < 0.5 or mag > 4000 then f.Visible = false return end
        f.Position = UDim2.fromOffset((a.X+b.X)/2, (a.Y+b.Y)/2)
        f.Size = UDim2.fromOffset(mag, thick or 1)
        f.Rotation = math.deg(math.atan2(d.Y, d.X))
        if col then f.BackgroundColor3 = col end
        f.Visible = true
    end

