    local function getWeaponIdAndName()
        local a = LP:GetAttribute("CurrentEquipped"); if not a then return nil, nil end
        local ok, d = pcall(function() return HttpService:JSONDecode(a) end)
        if not ok or type(d) ~= "table" or not d.Identifier then return nil, nil end
        local wn = d.Name
        if not wn then
            local u = string.find(d.Identifier, "_")
            wn = u and string.sub(d.Identifier, 1, u-1) or d.Identifier
        end
        return d.Identifier, wn
    end

    local function classifyPart(inst)
        if not inst then return "Torso" end
        local n = inst.Name
        if n == "Head" then return "Head" end
        if n:find("Torso") or n == "HumanoidRootPart" then return "Torso" end
        if n:find("Arm") or n:find("Hand") then return "Arms" end
        if n:find("Leg") or n:find("Foot") then return "Legs" end
        return "Torso"
    end

    local function getBaseFilter()
        local f = {}
        if LP.Character then table.insert(f, LP.Character) end
        return f
    end
    local function shouldFilterPart(instance)
        if instance:FindFirstAncestorWhichIsA("Accessory") then return true end
        if instance.Name == "CollisionCapsule" then return true end
        local map = Workspace:FindFirstChild("Map")
        if map then
            for _, s in ipairs({"Cameras","Barriers","Ambience"}) do
                local n = map:FindFirstChild(s); if n and instance:IsDescendantOf(n) then return true end
            end
            local z = map:FindFirstChild("Zones")
            if z then
                for _, s in ipairs({"Spawns","Sites"}) do
                    local n = z:FindFirstChild(s); if n and instance:IsDescendantOf(n) then return true end
                end
            end
        end
        return false
    end

    local function isTargetVisible(origin, targetPart)
        if not targetPart then return false end
        local allowWB = (Config.Misc and Config.Misc.SilentAim) == true

        if not allowWB then
            local ok, vis = pcall(IsVisible, targetPart)
            return ok and vis or false
        end
        local wallCheck = true
        local pen = (Toggles.HVH_PenOverride and Toggles.HVH_PenOverride.Value)
            and Options.HVH_PenPower.Value or 4
        local dir = targetPart.Position - origin
        local dist = dir.Magnitude
        local dirU = dir.Unit
        local tModel = targetPart:FindFirstAncestorOfClass("Model")
        local filter = getBaseFilter()
        local remaining = dist
        local cur = origin
        for _ = 1, 6 do
            local p = RaycastParams.new()
            p.FilterType = Enum.RaycastFilterType.Exclude
            p.FilterDescendantsInstances = filter
            local r
            for _ = 1, 12 do
                r = Workspace:Raycast(cur, dirU * remaining, p)
                if not r then break end
                if not shouldFilterPart(r.Instance) then break end
                table.insert(filter, r.Instance)
                p.FilterDescendantsInstances = filter
            end
            if not r then return not wallCheck end
            local hitDist = (r.Position - cur).Magnitude
            remaining = remaining - hitDist
            if tModel and r.Instance:IsDescendantOf(tModel) then return true end
            if not wallCheck then return true end
            if not allowWB then return false end
            local d = matDepth(r.Instance.Material)
            if d == 0 and hitDist > pen then return false end
            table.insert(filter, r.Instance)
            cur = r.Position + dirU * 0.1
        end
        return false
    end

    local function findBest()
        local cam = Workspace.CurrentCamera; if not cam then return nil,nil end
        local camPos = cam.CFrame.Position
        local maxD = Options.HVH_AK_MaxDist.Value
        local bestD, bestP, bestPart = maxD, nil, nil
        local headOnly = Toggles.HVH_AK_Headshot and Toggles.HVH_AK_Headshot.Value
        local teamChk  = Config.TeamCheck
        for _, pl in ipairs(Players:GetPlayers()) do
            if pl ~= LP then
                local theirT = pl:GetAttribute("Team")
                local mineT  = LP:GetAttribute("Team")
                local hostile = theirT and theirT ~= "Spectators"
                if hostile and teamChk and mineT and theirT == mineT then hostile = false end
                if hostile and isAlive(pl.Character) then
                    local ch = pl.Character
                    local order = headOnly and HITBOX_ORDER or { "HumanoidRootPart","UpperTorso","Head","LowerTorso","LeftUpperArm","RightUpperArm","LeftUpperLeg","RightUpperLeg" }
                    for _, pn in ipairs(order) do
                        local part = ch:FindFirstChild(pn)
                        if part and isTargetVisible(camPos, part) then
                            local d = (camPos - part.Position).Magnitude
                            if d < bestD then bestD = d; bestP = pl; bestPart = part end
                            break
                        end
                    end
                end
            end
        end
        return bestP, bestPart
    end

    local function doRayFull(origin, direction, maxDist)
        local pen = (Toggles.HVH_PenOverride and Toggles.HVH_PenOverride.Value)
            and Options.HVH_PenPower.Value or 4
        local allowWB = (Config.Misc and Config.Misc.SilentAim) == true
        local filter = getBaseFilter()
        local hits, cur, remaining = {}, origin, maxDist
        local lastInst, lastPos
        for _ = 1, 8 do
            local p = RaycastParams.new()
            p.FilterType = Enum.RaycastFilterType.Exclude
            p.FilterDescendantsInstances = filter
            local r
            for _ = 1, 15 do
                r = Workspace:Raycast(cur, direction.Unit * remaining, p)
                if not r then break end
                if not shouldFilterPart(r.Instance) then break end
                table.insert(filter, r.Instance)
                p.FilterDescendantsInstances = filter
            end
            if not r then break end
            local hd = (r.Position - cur).Magnitude
            remaining = remaining - hd
            local mdl = r.Instance:FindFirstAncestorOfClass("Model")
            local hp = mdl and Players:GetPlayerFromCharacter(mdl)
            local isLast = (hp and hp ~= LP) or (not allowWB) or (matDepth(r.Instance.Material) == 0 and hd > pen)
            table.insert(hits, {
                Instance = r.Instance, Position = r.Position, Normal = r.Normal,
                Material = r.Instance.Material.Name, Distance = (r.Position - origin).Magnitude,
                Exit = not isLast,
            })
            lastInst, lastPos = r.Instance, r.Position
            if isLast then break end
            table.insert(filter, r.Instance)
            cur = r.Position + direction.Unit * 0.1
        end
        if #hits == 0 then
            table.insert(hits, {
                Instance = Workspace.Terrain, Position = cur + direction.Unit * remaining,
                Normal = Vector3.new(0,1,0), Material = "Grass", Distance = maxDist, Exit = false,
            })
        end
        return hits, lastInst, lastPos
    end

