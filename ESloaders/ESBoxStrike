_VoxelFXOrig = _VoxelFXOrig or setmetatable({}, { __mode = "k" })

function _voxelSnapshot(o)
    if _VoxelFXOrig[o] ~= nil then return end
    if o:IsA("BasePart") then
        _VoxelFXOrig[o] = { kind = "part", color = o.Color, material = o.Material }
    elseif o:IsA("ParticleEmitter") then
        _VoxelFXOrig[o] = { kind = "emitter", seq = o.Color }
    elseif o:IsA("PointLight") or o:IsA("SpotLight") or o:IsA("SurfaceLight") then
        _VoxelFXOrig[o] = { kind = "light", color = o.Color }
    elseif o:IsA("Beam") then
        _VoxelFXOrig[o] = { kind = "beam", seq = o.Color }
    end
end

-- HVH method: parts get the color + Neon material, emitters/beams get a flat ColorSequence
function _voxelTintOne(o, c)
    pcall(function()
        _voxelSnapshot(o)
        local s = _VoxelFXOrig[o]
        if not s then return end
        if s.kind == "part" then
            o.Color = c
            o.Material = Enum.Material.Neon
        elseif s.kind == "emitter" then o.Color = ColorSequence.new(c)
        elseif s.kind == "light" then o.Color = c
        elseif s.kind == "beam" then o.Color = ColorSequence.new(c) end
    end)
end

function _voxelTint(root, c)
    for _, o in ipairs(root:GetDescendants()) do
        _voxelTintOne(o, c)
    end
    _voxelTintOne(root, c)
end

function _voxelRestoreAll()
    for o, s in pairs(_VoxelFXOrig) do
        pcall(function()
            if not o or not o.Parent then return end
            if s.kind == "part" then
                o.Color = s.color
                if s.material then o.Material = s.material end
            elseif s.kind == "emitter" then o.Color = s.seq
            elseif s.kind == "light" then o.Color = s.color
            elseif s.kind == "beam" then o.Color = s.seq end
        end)
    end
    _VoxelFXOrig = setmetatable({}, { __mode = "k" })
end

function _voxelKindOf(inst)
    local n = inst.Name
    local low = n:lower()
    if n:match("^VoxelSmoke") or low:find("voxelsmoke") then return "smoke" end
    if n:match("^VoxelFire") or low:find("voxelfire") or low:find("molotov") or low:find("incendiar") then return "fire" end
    return nil
end

function _voxelFXApply(inst)
    local cfg = Config.VoxelFX
    if not (Config.GlobalEnable and cfg) then return end
    local kind = _voxelKindOf(inst)
    if kind == "smoke" and cfg.SmokeEnabled then
        _voxelTint(inst, cfg.SmokeColor)
    elseif kind == "fire" and cfg.MolotovEnabled then
        _voxelTint(inst, cfg.MolotovColor)
    end
end

