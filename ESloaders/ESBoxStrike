;(function()
    Config.Movement = Config.Movement or {}
    Config.Movement.LongJump  = Config.Movement.LongJump or false
    Config.Movement.PixelSurf = Config.Movement.PixelSurf or false

    local UIS       = game:GetService("UserInputService")
    local RunSvc    = game:GetService("RunService")
    local Workspace = game:GetService("Workspace")

    local LJ_POWER, LJ_UP, LJ_CD = 78, 22, 0.35
    local WS_SPEED, WS_STICK, WS_RANGE, WS_FALL = 46, 14, 4.5, -4

    local function _lpChar()
        local ch = LocalPlayer and LocalPlayer.Character
        if not ch then return nil end
        local hrp = ch:FindFirstChild("HumanoidRootPart")
        local hum = ch:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum or hum.Health <= 0 then return nil end
        return ch, hrp, hum
    end

    local function _isGrounded(hum)
        local st = hum:GetState()
        return st ~= Enum.HumanoidStateType.Freefall
           and st ~= Enum.HumanoidStateType.Jumping
           and st ~= Enum.HumanoidStateType.Flying
    end

    local function _moveDir(hrp)
        local _, _, hum = _lpChar()
        local dir = Vector3.zero
        if hum then
            local md = hum.MoveDirection
            if md.Magnitude > 0.05 then dir = Vector3.new(md.X, 0, md.Z) end
        end
        if dir.Magnitude < 0.05 then
            local cam = Workspace.CurrentCamera
            local lv = cam and cam.CFrame.LookVector or hrp.CFrame.LookVector
            dir = Vector3.new(lv.X, 0, lv.Z)
        end
        if dir.Magnitude < 1e-3 then return Vector3.new(0, 0, -1) end
        return dir.Unit
    end

    local LJ = { last = 0, wasGrounded = true }

    local function _doLongJump(hrp)
        local now = tick()
        if now - LJ.last < LJ_CD then return end
        LJ.last = now
        local dir  = _moveDir(hrp)
        local v    = hrp.AssemblyLinearVelocity
        local flat = Vector3.new(v.X, 0, v.Z)
        local keep = flat:Dot(dir); if keep < 0 then keep = 0 end
        local newFlat = dir * (keep * 0.35 + LJ_POWER)
        pcall(function()
            hrp.AssemblyLinearVelocity = Vector3.new(newFlat.X, math.max(v.Y, LJ_UP), newFlat.Z)
        end)
    end

    local WS = { params = nil, attached = false }

    local function _wsParams(ch)
        local p = WS.params
        if not p then p = RaycastParams.new(); WS.params = p end
        p.FilterType = Enum.RaycastFilterType.Exclude
        p.IgnoreWater = true
        local ignore = { ch }
        if _G.ECLIPSE_HUB_SKIN_MODEL then table.insert(ignore, _G.ECLIPSE_HUB_SKIN_MODEL) end
        if _G.ECLIPSE_HUB_SELF_DUMMY then table.insert(ignore, _G.ECLIPSE_HUB_SELF_DUMMY) end
        p.FilterDescendantsInstances = ignore
        return p
    end

    local function _findWall(ch, hrp)
        local params = _wsParams(ch)
        local origin = hrp.Position
        local best, bestDist
        local dirs = {
            hrp.CFrame.LookVector, -hrp.CFrame.LookVector,
            hrp.CFrame.RightVector, -hrp.CFrame.RightVector,
        }
        local cam = Workspace.CurrentCamera
        if cam then
            local lv = cam.CFrame.LookVector
            table.insert(dirs, 1, Vector3.new(lv.X, 0, lv.Z))
        end
        for _, d in ipairs(dirs) do
            if d.Magnitude > 1e-3 then
                local r = Workspace:Raycast(origin, d.Unit * WS_RANGE, params)
                if r and r.Instance and math.abs(r.Normal.Y) < 0.5 then
                    local dist = (r.Position - origin).Magnitude
                    if not bestDist or dist < bestDist then
                        best, bestDist = r, dist
                    end
                end
            end
        end
        return best
    end

    local function _wsStep()
        local ch, hrp, hum = _lpChar()
        if not hrp then WS.attached = false return end

        local hit = _findWall(ch, hrp)
        if not hit then
            WS.attached = false
            return
        end
        WS.attached = true

        local normal = hit.Normal
        local dir    = _moveDir(hrp)

        local along = dir - normal * dir:Dot(normal)
        local vertical = 0
        if UIS:IsKeyDown(Enum.KeyCode.Space)
           or (hum and hum.Jump)
           or (_G.ECLIPSE_HUB_MOBILE_JUMP == true) then
            vertical = WS_SPEED * 0.75
        elseif UIS:IsKeyDown(Enum.KeyCode.LeftControl) then
            vertical = -WS_SPEED * 0.6
        end

        if along.Magnitude < 1e-3 and vertical == 0 then
            pcall(function()
                hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0) - normal * WS_STICK * 0.15
            end)
            return
        end

        local flat = (along.Magnitude > 1e-3) and (along.Unit * WS_SPEED) or Vector3.zero
        local stick = -normal * WS_STICK * 0.25
        local vy = vertical
        if vy == 0 then
            vy = math.max(hrp.AssemblyLinearVelocity.Y, WS_FALL)
        end
        pcall(function()
            hrp.AssemblyLinearVelocity = Vector3.new(flat.X + stick.X, vy, flat.Z + stick.Z)
        end)
    end

    RunSvc.Heartbeat:Connect(function()
        if not scriptRunning then return end
        if Config.GlobalEnable == false then return end
        pcall(function()
            local ch, hrp, hum = _lpChar()

            if Config.Movement.LongJump and hrp and hum then
                local grounded = _isGrounded(hum)
                if LJ.wasGrounded and not grounded then _doLongJump(hrp) end
                LJ.wasGrounded = grounded
            elseif hum then
                LJ.wasGrounded = _isGrounded(hum)
            end

            if Config.Movement.PixelSurf then
                _wsStep()
            elseif WS.attached then
                WS.attached = false
            end
        end)
    end)
end)()

