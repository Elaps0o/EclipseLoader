do
    local _WB_CACHE = {}
    local _WB_INIT  = false
    local _WB_HOOKED = false
    local _WB_MAX_AMOUNT = 99999999999

    local function _wbCacheOne(mod)
        if not mod:IsA("ModuleScript") then return end
        if _WB_CACHE[mod.Name] then return end
        local okReq, data = pcall(require, mod)
        if not okReq or type(data) ~= "table" then return end
        _WB_CACHE[mod.Name] = {
            Data = data,
            Orig = {
                WM = tonumber(data.WallbangMultiplier) or 1,
                P  = tonumber(data.Penetration)        or 1,
                AP = tonumber(data.ArmorPenetration)   or 0.5,
                R  = tonumber(data.Range)              or 1000,
                RM = tonumber(data.RangeModifier)      or 1,
            },
        }
    end

    local _wbApply

    local function _wbInit()
        if _WB_INIT then return end
        local db = ReplicatedSt:FindFirstChild("Database")
        local custom = db and db:FindFirstChild("Custom")
        local weapons = custom and custom:FindFirstChild("Weapons")
        if not weapons then return end
        for _, mod in ipairs(weapons:GetChildren()) do _wbCacheOne(mod) end
        if not _WB_HOOKED then
            _WB_HOOKED = true
            weapons.ChildAdded:Connect(function(m)
                pcall(_wbCacheOne, m)
                if Config.Aimbot.WallBang then
                    task.defer(function() pcall(_wbApply) end)
                end
            end)
        end
        _WB_INIT = true
    end

    _wbApply = function()
        _wbInit()
        local on = Config.Aimbot.WallBang == true
        local amt = _WB_MAX_AMOUNT
        for _, entry in pairs(_WB_CACHE) do
            local d, o = entry.Data, entry.Orig
            pcall(function() if setreadonly then setreadonly(d, false) end end)

            if on then
                pcall(function() d.WallbangMultiplier = amt end)
                pcall(function() d.Penetration        = amt end)
                pcall(function() d.ArmorPenetration   = 1   end)
                pcall(function() d.Range              = amt end)
                pcall(function() d.RangeModifier      = 1   end)
            else
                pcall(function() d.WallbangMultiplier = o.WM end)
                pcall(function() d.Penetration        = o.P  end)
                pcall(function() d.ArmorPenetration   = o.AP end)
                pcall(function() d.Range              = o.R  end)
                pcall(function() d.RangeModifier      = o.RM end)
            end
            pcall(function() if setreadonly then setreadonly(d, true) end end)
        end
    end

    if LocalPlayer and not _G._ECLIPSE_HUBWBRespawnHooked then
        _G._ECLIPSE_HUBWBRespawnHooked = true
        LocalPlayer.CharacterAdded:Connect(function()
            task.delay(0.5, function() pcall(_wbApply) end)
            task.delay(1.5, function() pcall(_wbApply) end)
        end)
    end

    _G.ECLIPSE_HUB_ApplyWallBang = function() pcall(_wbApply) end
end

do
    local installed = false
    _G.ECLIPSE_HUBInstallSilentBypass = function()
        if installed then return true end
        installed = true
        local ok, err = pcall(function()
            local hookfn = hookfunction or (oth and oth.hook) or hookfunc
            assert(hookfn, "executor missing hookfunction/oth.hook")
            assert(getgc, "executor missing getgc")
            assert(rawget, "executor missing rawget")

            local PlayersSvc  = game:GetService("Players")
            local LP          = PlayersSvc.LocalPlayer
            local WS          = game:GetService("Workspace")
            local RS          = game:GetService("RunService")

            local _target = nil
            _G.ECLIPSE_HUB_SILENT_TARGET_HEAD = nil

            local function _closestHead()
                local cam = WS.CurrentCamera; if not cam then return nil end
                local myTeam = LP:GetAttribute("Team")
                local lchar  = LP.Character; if not lchar then return nil end
                if not lchar:FindFirstChild("Head") then return nil end
                local best, bestD = nil, math.huge
                for _, v in ipairs(PlayersSvc:GetPlayers()) do
                    if v ~= LP then
                        local ch = v.Character
                        if ch and not ch:GetAttribute("Dead")
                           and v:GetAttribute("Team") ~= myTeam then
                            local h = ch:FindFirstChild("Head")
                            if h then
                                local sp, on = cam:WorldToViewportPoint(h.Position)
                                if on then
                                    local d = (Vector2.new(sp.X, sp.Y) - cam.ViewportSize/2).Magnitude
                                    if d < bestD then bestD = d; best = h end
                                end
                            end
                        end
                    end
                end
                return best
            end

            connectSignal(RS.RenderStepped:Connect(function()
                if not scriptRunning then _target = nil; return end
                local silentOn = Config and Config.Misc and Config.Misc.SilentAim
                local wallOn   = Config and Config.Aimbot and Config.Aimbot.WallBang
                if silentOn or wallOn then
                    _target = _closestHead()
                    _G.ECLIPSE_HUB_SILENT_TARGET_HEAD = _target
                else
                    _target = nil
                    _G.ECLIPSE_HUB_SILENT_TARGET_HEAD = nil
                end
            end))

            local RaycastModule
            for _, obj in next, getgc(true) do
                if type(obj) == "table" and rawget(obj, "cast") and rawget(obj, "castThrough")
                   and rawget(obj, "isPartOfHumanoid") then
                    RaycastModule = obj; break
                end
            end
            if not RaycastModule then

                for _, obj in next, getgc(true) do
                    if type(obj) == "table" and rawget(obj, "cast") then RaycastModule = obj; break end
                end
            end
            assert(RaycastModule, "RaycastModule not found")

            local realEnv = getfenv()
            local fakeEnv = setmetatable({}, {
                __index = function(_, key)
                    if key == "debug" then
                        return setmetatable({}, { __index = function(_, dkey)
                            if dkey == "info" then
                                return function(levelOrFunc, options, ...)
                                    if type(options) == "string" and options:match("f") then return nil end
                                    return debug.info(levelOrFunc, options, ...)
                                end
                            end
                            return debug[dkey]
                        end })
                    elseif key == "getfenv" then
                        return function(level)
                            local ok, env = pcall(getfenv, level)
                            if not ok or type(env) ~= "table" then return {} end
                            local clean = {}
                            for k, v in env do
                                if k ~= "hookfunction" and k ~= "getgenv" and k ~= "oth"
                                   and k ~= "hookfunc" and k ~= "replaceclosure" then
                                    clean[k] = v
                                end
                            end
                            return clean
                        end
                    end
                    return realEnv[key]
                end
            })
            pcall(setfenv, RaycastModule.cast, fakeEnv)
            pcall(setfenv, RaycastModule.castThrough, fakeEnv)

            local function _wallbangRedirect(origin, direction)
                if not (Config and Config.Aimbot and Config.Aimbot.WallBang) then
                    return origin, direction
                end
                if not (_target and typeof(direction) == "Vector3" and typeof(origin) == "Vector3") then
                    return origin, direction
                end
                local lchar = LP.Character
                local lhead = lchar and lchar:FindFirstChild("Head")
                if not lhead then return origin, direction end
                if (origin - lhead.Position).Magnitude >= 12 then
                    return origin, direction
                end
                local targetPos = _target.Position
                local toTarget  = targetPos - origin
                local mag = toTarget.Magnitude
                if mag <= 0 then return origin, direction end
                local aimDir   = toTarget.Unit
                local backDist = math.max(math.min(mag * 0.5, 2), 0.5)
                _G.ECLIPSE_HUB_SILENT_TARGET = _target
                return (targetPos - aimDir * backDist), (aimDir * backDist)
            end

            local function _silentVisible(origin, part)
                if not (part and part.Parent) then return false end
                local ch = LP.Character
                local params = RaycastParams.new()
                params.FilterType = Enum.RaycastFilterType.Exclude
                params.FilterDescendantsInstances = { ch, workspace.CurrentCamera }
                params.IgnoreWater = true
                local dir = part.Position - origin
                if dir.Magnitude <= 0 then return false end
                local ok, res = pcall(function() return WS:Raycast(origin, dir, params) end)
                if not ok then return false end
                if not res then return true end
                local mdl = part:FindFirstAncestorOfClass("Model")
                if mdl and res.Instance and res.Instance:IsDescendantOf(mdl) then return true end
                return res.Instance == part
            end

            local function _silentRedirect(origin, direction)
                if Config and Config.Aimbot and Config.Aimbot.WallBang then
                    return origin, direction
                end
                if not (Config and Config.Misc and Config.Misc.SilentAim) then
                    return origin, direction
                end
                if not (_target and typeof(direction) == "Vector3" and typeof(origin) == "Vector3") then
                    return origin, direction
                end
                if not _silentVisible(origin, _target) then
                    return origin, direction
                end
                _G.ECLIPSE_HUB_SILENT_TARGET = _target
                return origin, (_target.Position - origin)
            end

            local _lastVis = 0
            local function _shotVisuals(origin, direction)
                if typeof(origin) ~= "Vector3" or typeof(direction) ~= "Vector3" then return end
                if direction.Magnitude <= 0 then return end
                local now = tick()
                if now - _lastVis < 0.03 then return end
                _lastVis = now

                local tracersOn  = Toggles and Toggles.HVH_Tracers and Toggles.HVH_Tracers.Value
                local markersOn  = Toggles and Toggles.HVH_Hitmarker and Toggles.HVH_Hitmarker.Value
                local impactOn   = Config and Config.Visuals and Config.Visuals.BulletImpact
                local soundsOn   = Toggles and ((Toggles.HVH_ShootSound and Toggles.HVH_ShootSound.Value)
                                             or (Toggles.HVH_HitSound   and Toggles.HVH_HitSound.Value)
                                             or (Toggles.HVH_KillSound  and Toggles.HVH_KillSound.Value))
                if not (tracersOn or markersOn or impactOn or soundsOn) then return end

                if soundsOn and type(_G.ECLIPSE_HUB_ShotSound) == "function" then
                    pcall(_G.ECLIPSE_HUB_ShotSound, "shoot")
                end

                local ch = LP.Character
                local params = RaycastParams.new()
                params.FilterType = Enum.RaycastFilterType.Exclude
                params.FilterDescendantsInstances = { ch }
                params.IgnoreWater = true

                local dir = direction.Unit * 900
                local okR, res = pcall(function() return WS:Raycast(origin, dir, params) end)
                local hitPos  = (okR and res and res.Position) or (origin + dir)
                local hitInst = okR and res and res.Instance or nil
                if (Config and Config.Aimbot and Config.Aimbot.WallBang) and _target and _target.Parent then
                    hitPos  = _target.Position
                    hitInst = _target
                end

                if tracersOn and type(_G.ECLIPSE_HUB_DrawTracer) == "function" then
                    pcall(_G.ECLIPSE_HUB_DrawTracer, origin, hitPos)
                end
                if impactOn and type(_G.ECLIPSE_HUBImpactFire) == "function" then
                    pcall(_G.ECLIPSE_HUBImpactFire, hitInst, hitPos)
                end
                if hitInst then
                    local mdl = hitInst:FindFirstAncestorOfClass("Model")
                    local hum = mdl and mdl:FindFirstChildOfClass("Humanoid")
                    if hum and hum.Health > 0 and mdl ~= ch then
                        local isHead = (hitInst.Name == "Head")
                        if markersOn and type(_G.ECLIPSE_HUBHVH_ShowHitmarker) == "function" then
                            pcall(_G.ECLIPSE_HUBHVH_ShowHitmarker, hitPos, isHead and 100 or 25, isHead)
                        end
                        if soundsOn and type(_G.ECLIPSE_HUB_ShotSound) == "function" then
                            pcall(_G.ECLIPSE_HUB_ShotSound, "hit", hum)
                        end
                    end
                end
            end

            local function _installOn(fnName)
                local fn = RaycastModule[fnName]
                if type(fn) ~= "function" then return end
                local orig
                orig = hookfn(fn, function(origin, direction, ...)
                    if scriptRunning then
                        local visOrigin, visDir = origin, direction
                        local wallOn   = Config and Config.Aimbot and Config.Aimbot.WallBang
                        local silentOn = Config and Config.Misc and Config.Misc.SilentAim
                        if wallOn then
                            local nO, nD = _wallbangRedirect(origin, direction)
                            if nO ~= origin or nD ~= direction then
                                visOrigin, visDir = origin, (nO + nD) - origin
                            end
                            origin, direction = nO, nD
                        elseif silentOn then
                            origin, direction = _silentRedirect(origin, direction)
                            visOrigin, visDir = origin, direction
                        end
                        pcall(_shotVisuals, visOrigin, visDir)
                    end
                    return orig(origin, direction, ...)
                end)
            end

            _installOn("cast")
            if RaycastModule.castThrough then _installOn("castThrough") end

        end)
        if not ok then
            installed = false
            warn("[EclipseHub] Silent/Wallbang bypass skipped: "..tostring(err))
        end
        return ok
    end
end

