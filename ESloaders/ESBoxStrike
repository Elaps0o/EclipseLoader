function _EMT.scan()
    local ok, pg = pcall(function() return LocalPlayer:FindFirstChildOfClass("PlayerGui") end)
    if not ok or not pg then return end
    local found = {}
    local mb
    pcall(function() mb = pg:FindFirstChild("MobileButtons", true) end)
    if mb then
        for name, _ in pairs(_EMT_MAP) do
            local b
            pcall(function() b = mb:FindFirstChild(name, true) end)
            if b and b:IsA("GuiObject") then found[name] = b end
        end
    end
    for name, _ in pairs(_EMT_MAP) do
        if not found[name] then
            local b
            pcall(function() b = pg:FindFirstChild(name, true) end)
            if b and b:IsA("GuiButton") then found[name] = b end
        end
    end
    _EMT.buttons = found
    for name, btn in pairs(found) do
        if _EMT.bind then pcall(_EMT.bind, name, btn) end
        pcall(function()
            for _, d in ipairs(btn:GetDescendants()) do
                if d:IsA("GuiButton") then pcall(_EMT.bind, name, d) end
            end
        end)
    end
    _EMT.ensureLayer()

end

function _EMT.ensureLayer()
    if _EMT.layer and _EMT.layer.Parent then return end
    pcall(function()
        local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
        if not pg then return end
        local sg = Instance.new("ScreenGui")
        sg.Name = "ECLIPSE_MobileTouchLayer"
        sg.ResetOnSpawn = false
        sg.IgnoreGuiInset = true
        sg.DisplayOrder = -1000
        sg.Enabled = true
        sg.Parent = pg
        _EMT.layer = sg
        _EMT.zones = {}
    end)
end

function _EMT.zoneFor(name, btn)
    if not _EMT.layer then return nil end
    local z = _EMT.zones and _EMT.zones[name]
    if not z or not z.Parent then
        z = Instance.new("Frame")
        z.Name = "Zone_" .. name
        z.BackgroundTransparency = 1
        z.BorderSizePixel = 0
        z.Active = false
        z.ZIndex = 1
        z.Parent = _EMT.layer
        if _EMT.zones then _EMT.zones[name] = z end
    end
    local ap, as = btn.AbsolutePosition, btn.AbsoluteSize
    local p = _EMT.pad
    z.Position = UDim2.fromOffset(ap.X - p, ap.Y - p)
    z.Size = UDim2.fromOffset(as.X + p * 2, as.Y + p * 2)
    z.Visible = btn.Visible
    return z
end

function _EMT.refreshRects()
    local r = {}
    for name, btn in pairs(_EMT.buttons) do
        if btn and btn.Parent then
            local vis = true
            local node = btn
            while node and node:IsA("GuiObject") do
                if node.Visible == false then vis = false break end
                node = node.Parent
            end
            if vis then
                local ap, as = btn.AbsolutePosition, btn.AbsoluteSize
                if as.X > 0 and as.Y > 0 then
                    local p = _EMT.pad
                    r[name] = {
                        x1 = ap.X - p, y1 = ap.Y - p,
                        x2 = ap.X + as.X + p, y2 = ap.Y + as.Y + p,
                    }
                    _EMT.zoneFor(name, btn)
                end
            end
        end
    end
    _EMT.rects = r
end

function _EMT.hit(pos)
    for name, r in pairs(_EMT.rects) do
        if pos.X >= r.x1 and pos.X <= r.x2 and pos.Y >= r.y1 and pos.Y <= r.y2 then
            return name
        end
    end
    return nil
end

