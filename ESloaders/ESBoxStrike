                    elseif type(obj) == "table" then
                        inst = rawget(obj, "Instance")
                    end
                    if typeof(inst) == "Instance" and inst:IsA("GuiObject") then
                        inst.Visible = false
                    end
                end)
            end
        end

        for k in pairs(open) do open[k] = nil end
    end)
