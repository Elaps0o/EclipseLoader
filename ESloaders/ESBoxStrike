local function _presenceRestoreLabel(d, snap)
    pcall(function()
        d.Text = snap.Text
        d.RichText = snap.RichText
    end)
end

local function _presenceApplyDecorations()
    local names = _presenceNames()
    local iconTag = _presenceIconTag()
    local batch = 0
    local BATCH_MAX = 40
    for d in pairs(_presenceKnownLabels) do
        if not d or not d.Parent then
            _presenceKnownLabels[d] = nil
            _presenceDecorated[d] = nil
        else
            local raw = d.Text
            local matched = nil
            if type(raw) == "string" and raw ~= "" then
                for nm in pairs(names) do
                    if #nm > 2 and raw:find(nm, 1, true) then
                        if not matched or #nm > #matched then matched = nm end
                    end
                end
            end
            local snap = _presenceDecorated[d]
            -- the game rewrote this label (kill feed reuses labels) -> re-decorate
            if snap and snap.applied and raw ~= snap.applied then
                snap = nil
                _presenceDecorated[d] = nil
            end
            if matched then
                local base = snap and snap.Text or raw
                if not snap or snap.tag ~= iconTag or snap.name ~= matched or snap.applied ~= d.Text then
                    local newTxt = base:gsub(matched, iconTag .. matched, 1)
                    _presenceDecorated[d] = {
                        Text = base,
                        RichText = snap and snap.RichText or d.RichText,
                        tag = iconTag, name = matched, applied = newTxt,
                    }
                    pcall(function()
                        d.RichText = true
                        d.Text = newTxt
                    end)
                end
            elseif snap then
                _presenceRestoreLabel(d, snap)
                _presenceDecorated[d] = nil
            end
        end
        batch = batch + 1
        if batch >= BATCH_MAX then
            batch = 0
            RunService.Heartbeat:Wait()
        end
    end
end

