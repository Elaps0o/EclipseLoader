    -- RCS: compensate camera pitch/yaw while firing
    local RCSState = { lastShot = 0, shots = 0 }
    RunService.RenderStepped:Connect(function(dt)
        pcall(function()
            if not (Toggles.RCSEnabled and Toggles.RCSEnabled.Value) then return end
            if Toggles.GlobalEnabled and Toggles.GlobalEnabled.Value == false then return end
            local cam = Workspace.CurrentCamera
            if not cam then return end
            local shooting = UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
            if not shooting then
                RCSState.shots = 0
                return
            end
            local v = Options.RCSVertical and Options.RCSVertical.Value or 50
            local h = Options.RCSHorizontal and Options.RCSHorizontal.Value or 30
            local sm = Options.RCSSmooth and Options.RCSSmooth.Value or 0.35
            pcall(function()
                if Options.WeaponCfgMode and Options.WeaponCfgMode.Value == "Per Weapon" then
                    local IC = require(ReplicatedStorage.Controllers.InventoryController)
                    local w = IC.getCurrentEquipped and IC.getCurrentEquipped()
                    local prof = w and _G.ECLIPSE_WeaponProfiles and _G.ECLIPSE_WeaponProfiles[w.Name]
                    if prof then
                        v = prof.RCS_V or v
                        h = prof.RCS_H or h
                    end
                end
            end)
            RCSState.shots = RCSState.shots + dt * 10
            local pullY = (v / 100) * 0.012 * math.min(RCSState.shots, 12)
            local pullX = (h / 100) * 0.004 * math.sin(RCSState.shots * 0.7)
            local cf = cam.CFrame
            local adjusted = cf * CFrame.Angles(-pullY * sm, -pullX * sm, 0)
            cam.CFrame = cf:Lerp(adjusted, math.clamp(sm, 0.05, 1))
        end)
    end)

    -- Anti-aim: upper body only via Waist / UpperTorso motors (legs keep walk dir)
    RunService.RenderStepped:Connect(function(dt)
        pcall(function()
            if not (Toggles.AntiAimEnabled and Toggles.AntiAimEnabled.Value) then return end
            local char = LP.Character
            if not char then return end
            local root = char:FindFirstChild("HumanoidRootPart")
            local upper = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
            local head = char:FindFirstChild("Head")
            if not root then return end
            local mode = Options.AntiAimMode and Options.AntiAimMode.Value or "Jitter"
            local yawOff = math.rad(Options.AntiAimYaw and Options.AntiAimYaw.Value or 180)
            local t = os.clock()
            local side = (math.floor(t / 0.12) % 2 == 0) and -1 or 1
            local yaw = yawOff
            if mode == "Jitter" then
                yaw = yawOff + math.rad(Options.AntiAimJitter and Options.AntiAimJitter.Value or 45) * side
            elseif mode == "Spin" then
                yaw = math.rad((t * (Options.AntiAimSpinSpeed and Options.AntiAimSpinSpeed.Value or 360)) % 360)
            elseif mode == "Random" then
                yaw = yawOff + math.rad(math.noise(t * 0.7) * 90)
            end
            local upperOnly = not (Toggles.AntiAimUpperBody and Toggles.AntiAimUpperBody.Value == false)
            if upperOnly then
                -- rotate UpperTorso / Waist relative to root, leave HRP facing move
                local waist = char:FindFirstChild("Waist", true)
                if waist and waist:IsA("Motor6D") then
                    local base = waist.C0
                    waist.C0 = base:Lerp(CFrame.new(base.Position) * CFrame.Angles(0, yaw, 0), math.clamp(dt * 14, 0, 1))
                elseif upper then
                    local _, ry = root.CFrame:ToEulerAnglesYXZ()
                    local look = CFrame.new(upper.Position) * CFrame.Angles(0, ry + yaw, 0)
                    upper.CFrame = upper.CFrame:Lerp(look, math.clamp(dt * 10, 0, 1))
                end
                if head then
                    local pitchMode = Options.AntiAimPitch and Options.AntiAimPitch.Value or "Camera"
                    local pitch = 0
                    if pitchMode == "Up" then pitch = -0.9
                    elseif pitchMode == "Down" then pitch = 0.9
                    elseif pitchMode == "Level" then pitch = 0
                    end
                    local neck = char:FindFirstChild("Neck", true)
                    if neck and neck:IsA("Motor6D") then
                        local c0 = neck.C0
                        neck.C0 = c0:Lerp(CFrame.new(c0.Position) * CFrame.Angles(pitch, yaw * 0.35, 0), math.clamp(dt * 12, 0, 1))
                    end
                end
            else
                root.CFrame = CFrame.new(root.Position) * CFrame.Angles(0, select(2, root.CFrame:ToEulerAnglesYXZ()) + yaw, 0)
            end
        end)
    end)

    -- Third person: clone / force world weapons onto character (CPM-style)
    local TPWeaponClones = {}
    RunService.RenderStepped:Connect(function()
        pcall(function()
            if not (Toggles.ThirdPerson and Toggles.ThirdPerson.Value) then
