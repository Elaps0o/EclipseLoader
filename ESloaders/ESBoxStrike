        if sameTeam(player) then return false end
        character = character or resolvePlayerModel(player)
        if not character then return false end
        return Visibility.IsTargetVisible(player, point, character) == true
    end

    local function hitPart(character)
        local desired = tostring(flag("combat_redirect_hitpart", "Head"))
        local names
        if desired == "Random" then
            names = {"Head", "UpperTorso", "Torso", "HumanoidRootPart"}
        else
            names = {desired, "Head", "UpperTorso", "Torso", "HumanoidRootPart"}
        end
        local candidates = {}
        for _, name in ipairs(names) do
            local part = character:FindFirstChild(name)
            if part and part:IsA("BasePart") then
                candidates[#candidates + 1] = part
                if desired ~= "Random" then return part end
            end
        end
        if desired == "Random" and #candidates > 0 then
            return candidates[math.random(1, #candidates)]
        end
        return candidates[1]
    end

    rayParams = function()
        local list = {}
        if type(GetRayIgnore) == "function" then
            local ok, value = pcall(GetRayIgnore)
            if ok and type(value) == "table" then
                list = table.clone(value)
            end
        end
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = list
        params.IgnoreWater = false
        return params
    end

    local function directHit(origin, point, character)
        local ray = Workspace:Raycast(origin, point - origin, rayParams())
        return ray and ray.Instance and ray.Instance:IsDescendantOf(character) or false
    end

    local function penetrationHit(origin, point, character, weapon)
        local vector = point - origin
        local totalDistance = vector.Magnitude
        if totalDistance < 0.001 then return true, 0 end
        local direction = vector.Unit
        local properties = weapon and rawget(weapon, "Properties") or nil
        local penetrationPower = tonumber(properties and rawget(properties, "Penetration")) or 0
        if flag("combat_infinite_penetration", false) == true then
            penetrationPower = math.huge
        end

        local travelled = 0
        local thickness = 0
        local start = origin
        local params = rayParams()
        for _ = 1, 12 do
            local remain = totalDistance - travelled
            if remain <= 0 then break end
            local hit = Workspace:Raycast(start, direction * remain, params)
            if not hit then return false, thickness end
            if hit.Instance and hit.Instance:IsDescendantOf(character) then
                return true, thickness
            end
            local slab = 0.5
            if hit.Instance and hit.Instance:IsA("BasePart") then
                slab = math.max(0.05, math.min(hit.Instance.Size.Magnitude, remain))
            end
            thickness += slab
            if penetrationPower ~= math.huge and thickness > math.max(0, penetrationPower) then
                return false, thickness
            end
            params:AddToFilter(hit.Instance)
            travelled = (hit.Position - origin).Magnitude + slab + 0.05
            start = hit.Position + direction * 0.05
        end
        return false, thickness
    end

    local function estimateDamage(weapon, part, distance, thickness)
        local properties = weapon and rawget(weapon, "Properties") or nil
        local damageTable = properties and rawget(properties, "DamagePerPart")
        local value = 100
        if type(damageTable) == "table" then
            value = tonumber(damageTable[part.Name]) or tonumber(damageTable.Head) or 100
        end
        local range = tonumber(properties and rawget(properties, "Range")) or 500
        if range > 0 and distance > range then
            value *= math.max(0.05, 1 - (distance - range) / range)
        end
        if thickness > 0 and flag("combat_infinite_penetration", false) ~= true then
            local pen = math.max(1, tonumber(properties and rawget(properties, "Penetration")) or 1)
            value *= math.max(0.05, 1 - thickness / pen)
        end
        return math.max(0, value)
    end

    local function candidatePoints(part)
        if flag("combat_autowall_multipoint", true) ~= true then
            return {part.Position}
        end
        local scale = math.clamp(tonumber(flag("combat_autowall_point_scale", 0.65)) or 0.65, 0.1, 1)
        local c = part.CFrame
        local half = part.Size * 0.5 * scale
        return {
            part.Position,
            c.Position + c.RightVector * half.X,
            c.Position - c.RightVector * half.X,
            c.Position + c.UpVector * half.Y,
            c.Position - c.UpVector * half.Y,
            c.Position + c.LookVector * half.Z,
            c.Position - c.LookVector * half.Z,
        }
    end

    local function chooseTarget(origin, weapon)
        local maxDistance = math.max(100, tonumber(flag("combat_autowall_scan_distance", 2500)) or 2500)
        local minDamage = math.max(0, tonumber(flag("combat_auto_wall_min_damage", 1)) or 1)
        local best = nil
        local bestScore = math.huge
        local observerPosition = localPosition()

        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and not sameTeam(player) then
                local character = aliveCharacter(player)
                local part = character and hitPart(character)
                if part then
                    for _, point in ipairs(candidatePoints(part)) do
                        local pvsState = observerPosition and pvsAllows(observerPosition, point) or nil
                        if pvsState == false and flag("combat_auto_wall", false) ~= true then
                            continue
                        end
                        local distance = (point - origin).Magnitude
                        if distance <= maxDistance and distance < bestScore + 0.001 then
                            local direct = directHit(origin, point, character)
                            local allowed, thickness

                            local resolverVisible = G.__eclipse_is_valid_auto_target(player, point, character)
                            if direct and resolverVisible then
                                allowed, thickness = true, 0
                            elseif flag("combat_auto_wall", false) == true then
                                allowed, thickness = penetrationHit(origin, point, character, weapon)
                            else
                                allowed, thickness = false, 0
                            end

                            if allowed then
                                local damage = estimateDamage(weapon, part, distance, thickness)
                                if damage >= minDamage then
                                    local dynamicPenalty = 0
                                    if flag("combat_autowall_dynamic_scale", true) == true then
                                        dynamicPenalty = math.min(thickness, 8) * 0.15
                                    end
                                    local score = distance + thickness * 4 + dynamicPenalty - (direct and 0.5 or 0)
                                    if score < bestScore then
                                        bestScore = score
                                        best = {
                                            player = player,
                                            character = character,
                                            part = part,
                                            point = point,
                                            thickness = thickness,
                                            damage = damage,
                                            distance = distance,
                                        }
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end

        return best
    end

    local function muzzle(weapon, fallback)
