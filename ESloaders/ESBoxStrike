function _spawnViewmodelCore(knife, me)
    local assets = ReplicatedSt:WaitForChild("Assets", 5); if not assets then return end
    local weapons = assets:WaitForChild("Weapons", 5); if not weapons then return end
    local selKnife = Config.Skins.SelectedKnife
    local tpl = weapons:FindFirstChild(selKnife)
    local camTpl = tpl and tpl:FindFirstChild("Camera")

    if not camTpl and _TW_Sk and type(_TW_Sk.GetCameraModel) == "function" then
        local sk = (Config.Skins.SelectedSkins and Config.Skins.SelectedSkins[selKnife]) or "Vanilla"
        local ok, mdl = pcall(_TW_Sk.GetCameraModel, selKnife, sk)
        if ok and mdl then camTpl = mdl end
    end

    if not camTpl then
        tpl = weapons:WaitForChild("Butterfly Knife", 5)
        camTpl = tpl and tpl:WaitForChild("Camera", 5)
    end
    if not camTpl then return end
    local off = (knives[selKnife] or knives["Butterfly Knife"]).Offset
    pcall(_refreshCanonicalWeaponGloves)
    SkinSystem.vm = camTpl:Clone()
    SkinSystem.vm.Name = selKnife; SkinSystem.vm.Parent = Camera
    disableCollisions(SkinSystem.vm); hideOriginalKnife(knife)
    SkinSystem.gloveScale = 1.0
    local gloveRefs = _collectGloveReferences(knife)
    if me.Parent.Name == "Terrorists" then
        local g = weapons:WaitForChild("T Glove", 5)
        attachAsset(g,"Left Arm","Left Arm","Glove",CFrame.new(0,0,-1.5), gloveRefs and gloveRefs["Left Arm"])
        attachAsset(g,"Right Arm","Right Arm","Glove",CFrame.new(0,0,-1.5), gloveRefs and gloveRefs["Right Arm"])
    else
        local sleeves = assets:WaitForChild("Sleeves", 5)
        local sl = sleeves and sleeves:WaitForChild("IDF", 5)
        local g  = weapons:WaitForChild("CT Glove", 5)
        attachAsset(sl,"Left Arm","Left Arm","Sleeve",CFrame.new(0,0,0.5))
        attachAsset(g,"Left Arm","Left Arm","Glove",CFrame.new(0,0,-1.5), gloveRefs and gloveRefs["Left Arm"])
        attachAsset(sl,"Right Arm","Right Arm","Sleeve",CFrame.new(0,0,0.5))
        attachAsset(g,"Right Arm","Right Arm","Glove",CFrame.new(0,0,-1.5), gloveRefs and gloveRefs["Right Arm"])
    end
    pcall(_applyKnifeTune)
    local ac = SkinSystem.vm:FindFirstChildOfClass("AnimationController") or SkinSystem.vm:FindFirstChildOfClass("Animator")
    if not ac then SkinSystem.spawned = true; return end
    SkinSystem.animator = ac:FindFirstChildWhichIsA("Animator") or ac
    local animRoot = assets:FindFirstChild("WeaponAnimations")
    local knifeAnims = animRoot and (animRoot:FindFirstChild(selKnife) or animRoot:FindFirstChild("Butterfly Knife"))
    local af = knifeAnims and knifeAnims:FindFirstChild("CameraAnimations")
    if not af then

        if not SkinSystem.vm.PrimaryPart then SkinSystem.vm.PrimaryPart = SkinSystem.vm:FindFirstChildWhichIsA("BasePart") end
        SkinSystem.spawned = true
        return
    end
    SkinSystem.equipAnim      = _loadSkinAnimTrack(af, "Equip")
    SkinSystem.idleAnim       = _loadSkinAnimTrack(af, "Idle")
    SkinSystem.inspectAnim    = _loadSkinAnimTrack(af, "Inspect")
    do
        local _sel = Config.Skins.SelectedKnife
        local _hasAlt = (_sel == "Butterfly Knife") or (_sel == "Skeleton Knife") or (_sel == "Stiletto Knife")
        local _alt = nil
        if _hasAlt then
            for _, n in ipairs({ "Inspect2", "SecondInspect", "Inspect_2", "InspectAlt", "SecondaryInspect", "InspectTwo", "AltInspect", "Inspect Two", "InspectB", "Inspect_B" }) do
                _alt = _loadSkinAnimTrack(af, n)
                if _alt then break end
            end

            if not _alt and af then
                local primary = af:FindFirstChild("Inspect")
                for _, child in ipairs(af:GetChildren()) do
                    if child:IsA("Animation") and child ~= primary then
                        local lname = string.lower(child.Name)
                        if string.find(lname, "inspect", 1, true) then
                            _alt = _loadSkinAnimTrack(af, child.Name)
                            if _alt then break end
                        end
                    end
                end
            end
        end
        SkinSystem.inspectAlt = _alt
    end
    SkinSystem._inspectFlip   = false
    SkinSystem.HeavySwingAnim = _loadSkinAnimTrack(af, "Heavy Swing")
    SkinSystem.Swing1Anim     = _loadSkinAnimTrack(af, "Swing1")
    SkinSystem.Swing2Anim     = _loadSkinAnimTrack(af, "Swing2")
    if not SkinSystem.vm.PrimaryPart then SkinSystem.vm.PrimaryPart = SkinSystem.vm:FindFirstChildWhichIsA("BasePart") end
    if SkinSystem.vm.PrimaryPart then
        SkinSystem.vm:SetPrimaryPartCFrame(Camera.CFrame * CFrame.new(0,-1.5,5))
        TweenService:Create(SkinSystem.vm.PrimaryPart, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {CFrame = Camera.CFrame * off}):Play()
    end
    if SkinSystem.equipAnim then pcall(function() SkinSystem.equipAnim:Play() end) end
    playSound("Equip","1")
    SkinSystem.spawned = true
    pcall(function() ContextAction:UnbindAction("InspectKnifeAction") end)
    pcall(function() ContextAction:UnbindAction("AttackKnifeAction") end)
    pcall(function() ContextAction:UnbindAction("RightAttackKnifeAction") end)
    ContextAction:BindAction("InspectKnifeAction", handleAction, false, Enum.KeyCode.F)
    ContextAction:BindAction("AttackKnifeAction", handleAction, false, Enum.UserInputType.MouseButton1)
    ContextAction:BindAction("RightAttackKnifeAction", handleAction, false, Enum.UserInputType.MouseButton2)
end

