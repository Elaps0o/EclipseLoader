            mb1 = true
            task.defer(_localShot)
        end
    end)
    UIS.InputEnded:Connect(function(input)
        local t = input.UserInputType
        if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then
            mb1 = false
        end
    end)
    RunS.Heartbeat:Connect(function()
        if not mb1 then return end
        if not (Config and Config.Visuals and Config.Visuals.BulletImpact) then return end
        if os.clock() - lastLocal < 0.08 then return end

        local ch = LP and LP.Character
        local tool = ch and ch:FindFirstChildOfClass("Tool")
        local tn = tool and tool.Name and tool.Name:lower() or ""
        if tn ~= "" and (tn:find("knife", 1, true) or tn:find("bayonet", 1, true)
            or tn:find("karambit", 1, true) or tn:find("melee", 1, true)) then
            return
        end
        _localShot()
    end)

    do
        local lastAmmo, lastWeapon = nil, nil
        local lastFire = 0
        RunS.Heartbeat:Connect(function()
            if not (Config and Config.Visuals and Config.Visuals.BulletImpact) then return end
            local cam = Workspace.CurrentCamera; if not cam then return end
            local held
            for _, ch in ipairs(cam:GetChildren()) do
                if ch:IsA("Model") then
                    local nm = ch.Name
                    if nm ~= "Arms" and nm ~= "Arms1" and nm ~= "Arms2" and nm ~= "Viewmodel" then
                        held = ch; break
                    end
                end
            end
            if not held then lastAmmo, lastWeapon = nil, nil; return end
            local ammo = held:GetAttribute("Ammo") or held:GetAttribute("Bullets")
                      or held:GetAttribute("CurrentAmmo") or held:GetAttribute("Rounds")
            if ammo == nil then return end
            if lastWeapon ~= held.Name then
                lastWeapon = held.Name; lastAmmo = ammo; return
            end
            if ammo < (lastAmmo or ammo) then
                lastAmmo = ammo
                if os.clock() - lastFire >= 0.03 then
                    lastFire = os.clock()
                    task.defer(_localShot)
                end
            elseif ammo > (lastAmmo or ammo) then
                lastAmmo = ammo
            end
        end)
    end
end

