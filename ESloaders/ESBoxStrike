    local function _hasWord(name, words)
        local n = _normName(name):gsub("[%p_]+", " ")
        for w in n:gmatch("%w+") do
            if words[w] then return true end
        end
        return false
    end

    local function _hasBodyHint(inst, stopAt)
        local p = inst
        while p and p ~= workspace and p ~= stopAt do
            if _hasWord(p.Name, bodyWords) then return true end
            p = p.Parent
        end
        return false
    end

    local function _hasOverlayHint(inst, stopAt)
        local p = inst
        while p and p ~= workspace and p ~= stopAt do
            if _hasWord(p.Name, overlayWords) then return true end
            p = p.Parent
        end
        return false
    end

    local function _hostHasBodyHint(host)
        if not host then return false end
        if _hasWord(host.Name, bodyWords) then return true end
        for _, d in ipairs(host:GetDescendants()) do
            if _hasWord(d.Name, bodyWords) then return true end
        end
        return false
    end

    local function _isHelperPart(part)
        local n = _normName(part.Name)
        if n == "humanoidrootpart" or n == "rootpart" or n == "root" then return true end
        if n:find("hitbox", 1, true) or n:find("hurtbox", 1, true) or n:find("collider", 1, true)
            or n:find("collision", 1, true) or n:find("bbox", 1, true) or n:find("bound", 1, true)
            or n:find("box", 1, true) or n:find("camera", 1, true) or n:find("aim", 1, true)
        then
            return true
        end

        local snap = touched[part]
        local origT = (snap and snap.Transparency) or part.Transparency
        if origT >= 0.98 and not part:FindFirstChildOfClass("SurfaceAppearance") and not part:FindFirstChildOfClass("SpecialMesh") then
            return true
        end
        local s = part.Size
        if s and ((s.X > 8 and s.Y > 8) or (s.Y > 7 and (s.X > 3 or s.Z > 3))) then
            return true
        end
        return false
    end

    local function _isWeaponDesc(part, stopAt)

        if _hasWord(part.Name, weaponPartWords) then return true end
        local a = part
        local hasBody = _hasBodyHint(part, stopAt)
        while a and a ~= workspace and a ~= stopAt do
            if _hasWord(a.Name, bodyWords) then
                hasBody = true
            end
            if a:IsA("Tool") then return true end
            if a:IsA("Model") then
                local nm = _normName(a.Name)
                if _hasWord(nm, weaponWords) then

                    return true
                end

                local h = a:FindFirstChild("Handle")
                if h and h:IsA("BasePart") and not hasBody then
                    return true
                end
            end
            a = a.Parent
        end
        return false
    end

    local function _collectHosts()
        local hosts = {}
        local ch = LP and LP.Character

        local hum = ch and ch:FindFirstChildOfClass("Humanoid")
        local lpDead = (hum == nil) or (hum.Health <= 0)
        if _G.ECLIPSE_HUBCPMActive then
            if not (Config.Misc and Config.Misc.ThirdPerson) then
                local ov = workspace:FindFirstChild("ECLIPSE_HUBCPMOverlay")
                if ov and ov.Parent and not lpDead then hosts[#hosts + 1] = ov end
            end
        elseif ch and ch.Parent and not lpDead then
            hosts[#hosts + 1] = ch
        end
        local cam = workspace.CurrentCamera
        if cam then
            for _, top in ipairs(cam:GetChildren()) do
                if top:IsA("Model") then

                    if _hostHasBodyHint(top) then hosts[#hosts + 1] = top end
                end
            end
        end
        return hosts
    end

    local function _insideClass(part, className)
        local p = part
        while p and p ~= workspace do
            if p:IsA(className) then return true end
            p = p.Parent
        end
        return false
    end

    local function _shouldHideOnlyGlassPart(part, host)
        if not (part and part:IsA("BasePart") and host and host.Parent) then return false end
        if part.Name == "ECLIPSE_HUBGlassShell" or _isHeadOrFace(part) or _isHelperPart(part) then return false end
        if _insideClass(part, "Accessory") then return true end
        if _hasOverlayHint(part, host) then return true end
        if _isWeaponDesc(part, host) then return false end
        return false
    end

    local function _shouldGlassPart(part, host)
        if not (part and part:IsA("BasePart") and host and host.Parent) then return false end
        if part.Name == "ECLIPSE_HUBGlassShell" then return false end
        if _isHeadOrFace(part) or _isHelperPart(part) then return false end
        if LP and LP.Character and host == LP.Character then
            local tool = LP.Character:FindFirstChildOfClass("Tool")
            if tool and part:IsDescendantOf(tool) then return false end
            if _insideClass(part, "Accessory") or _hasOverlayHint(part, host) then return false end
            return true
        end

        if _isWeaponDesc(part, host) then return false end
        if _hasOverlayHint(part, host) then return false end
        if not _hasBodyHint(part, host) then return false end
        return true
    end

    local function _ensureOutline(part, color)
        local hl = outlines[part]
        if not (hl and hl.Parent) then
            hl = Instance.new("Highlight")
            hl.Name = "ECLIPSE_HUBGlassHL"
            hl.Adornee = part
            hl.DepthMode = _glassHighlightMode
            hl.FillTransparency = _glassFillT
            hl.OutlineTransparency = _glassOutlineT
            hl.Parent = part
            outlines[part] = hl
        end
        pcall(function()
            hl.Adornee = part
            hl.DepthMode = _glassHighlightMode
            hl.FillColor = color
            hl.OutlineColor = color
            hl.FillTransparency = _glassFillT
            hl.OutlineTransparency = _glassOutlineT
            hl.Enabled = true
        end)
    end

    local GLASS_STYLES = {
        Default = { mat=Enum.Material.SmoothPlastic, refl=0,    shellT=0.50, scale=1.040, fillT=0.55, outT=0.00, depth=Enum.HighlightDepthMode.AlwaysOnTop },
        Ghost   = { mat=Enum.Material.ForceField,    refl=0,    shellT=0.42, scale=1.034, fillT=0.30, outT=0.00, depth=Enum.HighlightDepthMode.AlwaysOnTop },
        Illum   = { mat=Enum.Material.Neon,          refl=0,    shellT=0.35, scale=1.045, fillT=0.35, outT=0.00, depth=Enum.HighlightDepthMode.AlwaysOnTop },
        Frost   = { mat=Enum.Material.Ice,           refl=0.25, shellT=0.55, scale=1.045, fillT=0.65, outT=0.00, depth=Enum.HighlightDepthMode.AlwaysOnTop },
        Neon    = { mat=Enum.Material.Neon,          refl=0,    shellT=0.20, scale=1.040, fillT=0.25, outT=0.00, depth=Enum.HighlightDepthMode.AlwaysOnTop },
        Chrome  = { mat=Enum.Material.Metal,         refl=0.85, shellT=0.15, scale=1.035, fillT=0.60, outT=0.10, depth=Enum.HighlightDepthMode.AlwaysOnTop },
        Holo    = { mat=Enum.Material.ForceField,    refl=0,    shellT=0.70, scale=1.055, fillT=0.60, outT=0.00, depth=Enum.HighlightDepthMode.AlwaysOnTop },
        Shadow  = { mat=Enum.Material.SmoothPlastic, refl=0,    shellT=0.35, scale=1.040, fillT=0.85, outT=0.00, depth=Enum.HighlightDepthMode.Occluded    },
        Plasma  = { mat=Enum.Material.Neon,          refl=0.10, shellT=0.10, scale=1.050, fillT=0.20, outT=0.00, depth=Enum.HighlightDepthMode.AlwaysOnTop },
    }

    connectSignal(RunService.Heartbeat:Connect(function()
        if not scriptRunning then return end
        local on = Config.Visuals.GlassFX
        if not on then
            if next(touched) or next(outlines) then _clearAll() end
            return
        end

        do
            local _ch  = LP and LP.Character
            local _hum = _ch and _ch:FindFirstChildOfClass("Humanoid")
            if (not _hum) or _hum.Health <= 0 then
                if next(touched) or next(outlines) or next(shells) then _clearAll() end
                return
            end
        end

        if Config.Misc and Config.Misc.ThirdPerson then
            if next(touched) or next(outlines) or next(shells) then _clearAll() end
            return
        end

        local col       = Config.Visuals.GlassFXColor   or Color3.fromRGB(85, 190, 255)
        local styleName = "Ghost"
        local st        = GLASS_STYLES[styleName] or GLASS_STYLES.Default
        _glassMat          = st.mat
        _glassRefl         = st.refl
        _glassFillT        = st.fillT
        _glassOutlineT     = st.outT
        _glassHighlightMode= st.depth
        local transShell = st.shellT
        local transBody  = 1.0
        local shellScale = st.scale

        local lpChar    = LP and LP.Character

        local hosts = _collectHosts()
        local activeParts = {}
        for p, _ in pairs(touched) do
            local keep = false
            if p.Parent then
                for _, h in ipairs(hosts) do
                    if p == h or p:IsDescendantOf(h) then
                        if _shouldGlassPart(p, h) or _shouldHideOnlyGlassPart(p, h) then keep = true; activeParts[p] = true end
                        break
                    end
                end
            end
            if not keep then _restorePart(p) end
        end
        for p, h in pairs(outlines) do
            if not activeParts[p] and (not p.Parent or not touched[p]) then
                pcall(function() h:Destroy() end)
                outlines[p] = nil
            end
        end
        for p, _ in pairs(shells) do
            if not activeParts[p] then _clearShell(p) end
        end

        for _, host in ipairs(hosts) do
            local processed = 0
            for _, d in ipairs(host:GetDescendants()) do
                processed = processed + 1
                ES152.yieldEvery(processed, 90)
                if d.Name ~= "ECLIPSE_HUBGlassShell" and d:IsA("BasePart") then
                    if _shouldHideOnlyGlassPart(d, host) then
                        activeParts[d] = true
                        _snapshot(d)
                        pcall(function()
                            d.Transparency = 1
                            d.LocalTransparencyModifier = 0
                            d.CastShadow = false
                        end)
                        _clearShell(d)
                        local old = outlines[d]
                        if old then pcall(function() old:Destroy() end); outlines[d] = nil end
                    elseif _shouldGlassPart(d, host) then
                        activeParts[d] = true
                        _snapshot(d)
                        pcall(function()
                            d.Transparency = transBody
                            d.LocalTransparencyModifier = 0
                            d.CastShadow   = false
                        end)
                        _ensureShell(d, col, transShell, shellScale)
                        _ensureOutline(d, col)
                    end
                end
            end
        end
    end))

    pcall(function()
        RunService:BindToRenderStep("ECLIPSE_HUBGlassHide", Enum.RenderPriority.Camera.Value + 5, function()
            if not scriptRunning or not Config.Visuals.GlassFX then return end
            if Config.Misc and Config.Misc.ThirdPerson then return end
            for p, _ in pairs(touched) do
                if p and p.Parent then
                    pcall(function()
                        if p.Transparency ~= 1 then p.Transparency = 1 end
                        if p.LocalTransparencyModifier ~= 0 then p.LocalTransparencyModifier = 0 end
                    end)
                end
            end
        end)
    end)

    if LP then
        connectSignal(LP.CharacterAdded:Connect(function() if scriptRunning then _clearAll() end end))
        connectSignal(LP.CharacterRemoving:Connect(function() if scriptRunning then _clearAll() end end))
    end
end

