    local SKEL_R15 = {
        {"Head","UpperTorso"},{"UpperTorso","LowerTorso"},
        {"UpperTorso","LeftUpperArm"},{"LeftUpperArm","LeftLowerArm"},{"LeftLowerArm","LeftHand"},
        {"UpperTorso","RightUpperArm"},{"RightUpperArm","RightLowerArm"},{"RightLowerArm","RightHand"},
        {"LowerTorso","LeftUpperLeg"},{"LeftUpperLeg","LeftLowerLeg"},{"LeftLowerLeg","LeftFoot"},
        {"LowerTorso","RightUpperLeg"},{"RightUpperLeg","RightLowerLeg"},{"RightLowerLeg","RightFoot"},
    }
    local SKEL_R6 = {
        {"Head","Torso"},{"Torso","Left Arm"},{"Torso","Right Arm"},
        {"Torso","Left Leg"},{"Torso","Right Leg"},
    }

    local function hideAll()
        if not overlay then return end
        if PV.boxFrame then PV.boxFrame.Visible = false end
        for _, f in ipairs(PV.skel) do f.Visible = false end
        PV.hpBg.Visible = false
        for _, f in ipairs(PV.hpSegs) do f.Visible = false end
        PV.name.Visible = false
        PV.wep.Visible = false;  PV.head.Visible = false
        if PV.wepIcon then PV.wepIcon.Visible = false end
    end

    local function render()
        if not (rig and overlay and pcam) then return end
        pcam.CFrame = CFrame.new(Vector3.new(0, 1.4, 0)) *
            CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch, 0, 0) * CFrame.new(0, 0, dist)
        pcam.Focus = CFrame.new(0, 1.4, 0)

        hideAll()
        updateChams()
        if not Config.ESP.Enabled then return end

        local parts = {}
        for _, d in ipairs(rig:GetChildren()) do
            if d:IsA("BasePart") then parts[d.Name] = d end
        end
        local headP = parts["Head"]
        local rootP = parts["HumanoidRootPart"] or parts["UpperTorso"] or parts["Torso"]
        if not (headP and rootP) then return end

        local hP = project(headP.Position + Vector3.new(0, 0.75, 0))
        local fP = project(rootP.Position - Vector3.new(0, 3.35, 0))
        if not (hP and fP) then return end

        local height = math.abs(hP.Y - fP.Y)
        local width  = height * 0.78
        if height < 2 then return end
        local cx = hP.X
        local cy = (hP.Y + fP.Y) * 0.5
        local L2, R2 = cx - width/2, cx + width/2
        local T2, B2 = cy - height/2, cy + height/2

        local col
        if Config.ESP.VisibleCheck then
            col = Config.ESP.VisibleBoxColor or Config.ESP.BoxColor
        else
            col = Config.ESP.BoxColor
        end
        if typeof(col) ~= "Color3" then col = Color3.fromRGB(230, 45, 55) end

        if Config.ESP.CornerBox and PV.boxFrame then
            local style = tostring(Config.ESP.CornerBoxStyle or "Corner")
            local darker = Color3.new(
                math.clamp(col.R * 0.45, 0, 1),
                math.clamp(col.G * 0.30, 0, 1),
                math.clamp(col.B * 0.65, 0, 1))
            PV.boxGrad.Color = ColorSequence.new(col, darker)
            PV.boxFrame.Position = UDim2.fromOffset(math.floor(L2), math.floor(T2))
            PV.boxFrame.Size = UDim2.fromOffset(math.floor(math.max(2, R2 - L2)), math.floor(math.max(2, B2 - T2)))
            if style == "Outline" then
                PV.boxFrame.BackgroundTransparency = 1
                PV.boxStroke.Thickness = 1.4; PV.boxStroke.Transparency = 0.05
            elseif style == "Full" then
                PV.boxFrame.BackgroundColor3 = col
