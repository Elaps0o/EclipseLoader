    local function drawTracer(from, to)
        local col   = Options.HVH_TracerColor.Value
        local th    = math.clamp(tonumber(Options.HVH_TracerThick.Value) or 0.03, 0.005, 1)
        local st    = Options.HVH_TracerTrans.Value
        local dur   = Options.HVH_TracerLife.Value

        local white = Color3.new(
            math.min(1, col.R * 0.55 + 0.45),
            math.min(1, col.G * 0.55 + 0.45),
            math.min(1, col.B * 0.55 + 0.45)
        )

        local glowT = math.clamp(st + 0.86, 0, 0.985)
        local glow = _spawnBeam(from, to, col, th * 1.25, glowT, dur, { taper = false })
        pcall(function()
            glow.Transparency = NumberSequence.new({
                NumberSequenceKeypoint.new(0, 1),
                NumberSequenceKeypoint.new(0.12, glowT),
                NumberSequenceKeypoint.new(0.88, glowT),
                NumberSequenceKeypoint.new(1, 1),
            })
        end)

        local beam = _spawnBeam(from, to, col, math.max(th * 0.55, 0.012), st, dur, { taper = false })
        pcall(function()
            beam.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, white),
                ColorSequenceKeypoint.new(0.20, col),
                ColorSequenceKeypoint.new(1, col),
            })
        end)

        local core = _spawnBeam(from, to, white, math.max(th * 0.18, 0.006), math.max(st * 0.35, 0), dur, { taper = false })

        local wbOn = (Config and Config.Aimbot and Config.Aimbot.WallBang) == true
        if not wbOn then
            _tracerImpactBox(to, col, dur)
        end

        local proxy = Instance.new("NumberValue"); proxy.Value = 0; proxy.Parent = Workspace.Terrain
        local FADE_IN = 0.16
        local conn; conn = proxy.Changed:Connect(function(v)
            if not beam.Parent then if conn then conn:Disconnect() end; return end
            local a
            if v < FADE_IN then
                local t = v / FADE_IN
                a = 1 - (t * t * (3 - 2 * t))
            else
                local t = (v - FADE_IN) / (1 - FADE_IN)
                a = t * t * (3 - 2 * t)
            end
            local ct = math.clamp(st + (1 - st) * a, 0, 1)
            beam.Transparency = NumberSequence.new(ct)
            if core and core.Parent then
                local coreBase = math.max(st * 0.35, 0)
                core.Transparency = NumberSequence.new(math.clamp(coreBase + (1 - coreBase) * a, 0, 1))
            end
            if glow and glow.Parent then
                local gt = math.clamp(glowT + (1 - glowT) * a, 0, 1)
                glow.Transparency = NumberSequence.new(gt)
            end
        end)
        local tw = TweenService:Create(proxy, TweenInfo.new(dur, Enum.EasingStyle.Linear), { Value = 1 })
        tw.Completed:Connect(function() if conn then conn:Disconnect() end; pcall(function() proxy:Destroy() end) end)
        tw:Play()
    end

