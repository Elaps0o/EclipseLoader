function _findGloveSkinSource(gsr, side)
    if not gsr then return nil end
    local candidates = {
        side,
        side == "Left Arm" and "Left" or "Right",
        side == "Left Arm" and "L" or "R",
        side .. " Glove",
        "Glove",
    }
    for _, n in ipairs(candidates) do
        local src = gsr:FindFirstChild(n)
        if src then return src end
    end
    for _, d in ipairs(gsr:GetDescendants()) do
        local n = tostring(d.Name)
        if d:IsA("SurfaceAppearance") and (n == side or n:find(side == "Left Arm" and "Left" or "Right", 1, true)) then return d end
        if d:IsA("BasePart") and n == "Glove" then return d end
    end
    return nil
end

function _copyGloveSkinDirect(glove, source, sourceKey, gsr)
    if not (glove and glove:IsA("BasePart") and source) then return false end
    local visual = source
    if not visual:IsA("SurfaceAppearance") then
        local nested = visual:FindFirstChild("Glove", true)
        if nested and nested:IsA("BasePart") then visual = nested end
    end

    local surfaceList = {}
    if visual:IsA("SurfaceAppearance") then
        table.insert(surfaceList, visual)
    else
        for _, d in ipairs(visual:GetDescendants()) do
            if d:IsA("SurfaceAppearance") then table.insert(surfaceList, d) end
        end
    end
    if #surfaceList == 0 and gsr then
        for _, d in ipairs(gsr:GetChildren()) do
            if d:IsA("SurfaceAppearance") then table.insert(surfaceList, d) end
        end
    end

    pcall(_saveOriginalSA, glove)
    for _, old in ipairs(glove:GetChildren()) do
        if old:IsA("SurfaceAppearance") then old:Destroy() end
    end

    for _, sa in ipairs(surfaceList) do
        local c = sa:Clone()
        c.Name = "SurfaceAppearance"
        pcall(function()
            c:SetAttribute("ECLIPSE_HUBSkinSurface", true)
            c:SetAttribute("ECLIPSE_HUBSurfaceSource", sourceKey)
        end)
        c.Parent = glove
    end
    if visual:IsA("MeshPart") and glove:IsA("MeshPart") and visual.TextureID and visual.TextureID ~= "" then
        glove.TextureID = visual.TextureID
    end
    if visual:IsA("BasePart") then
        glove.Color = visual.Color
        glove.Material = visual.Material
    end
    return #surfaceList > 0 or visual:IsA("BasePart")
end

function _applyGloveSideDirect(glove, side, gloveSkin, gsr, directSurfaceApps, sourceKey)
    if glove:GetAttribute("ECLIPSE_HUBSkinSource") == sourceKey and glove:GetAttribute("SkinApplied") == gloveSkin then return end
    _restoreGloveSurfaceOnly(glove, side)
    _cacheSkinTarget(glove)
    local source = _findGloveSkinSource(gsr, side) or gsr
    if _copyGloveSkinDirect(glove, source, sourceKey, gsr) then
        glove:SetAttribute("ECLIPSE_HUBSkinSource", sourceKey)
        glove:SetAttribute("SkinApplied", gloveSkin)
    end
end

function _applyGloveSkinCore(gloveType, gloveSkin)
    if not (Config.Skins and Config.Skins.SkinChangerEnabled) then return end
    if not SkinsFolder then return end
    if not gloveType or not gloveSkin or gloveSkin == "" or gloveSkin == "Vanilla" or gloveSkin == "Default" or gloveSkin == "None" then return end

    local cam = workspace.CurrentCamera; if not cam then return end
    local am
    for _, ch in ipairs(cam:GetChildren()) do
        if ch:IsA("Model") and (ch.Name:match("Arms") or ch:FindFirstChild("Right Arm")) then
            am = ch; break
        end
    end
    if not am then return end
    local la = am:FindFirstChild("Left Arm"); local ra = am:FindFirstChild("Right Arm")
    if not la or not ra then return end
    local lg = la:FindFirstChild("Glove"); local rg = ra:FindFirstChild("Glove")
    if not lg or not rg then return end

    local gloveSkinFolder = SkinsFolder:FindFirstChild(gloveType); if not gloveSkinFolder then return end
    local skinVariant = gloveSkinFolder:FindFirstChild(gloveSkin);   if not skinVariant then return end
    local cameraFolder = skinVariant:FindFirstChild("Camera");       if not cameraFolder then return end
    local factoryNew = cameraFolder:FindFirstChild("Factory New")
                    or cameraFolder:FindFirstChild("Minimal Wear")
                    or cameraFolder:FindFirstChild("Field-Tested")
                    or cameraFolder:FindFirstChild("Well-Worn")
                    or cameraFolder:FindFirstChild("Battle-Scarred")
    if not factoryNew then return end

    local sourceKey = tostring(gloveType) .. "/" .. tostring(gloveSkin)
    if lg:GetAttribute("ECLIPSE_HUBSkinSource") == sourceKey and rg:GetAttribute("ECLIPSE_HUBSkinSource") == sourceKey then return end

    pcall(_cacheSkinTarget, lg); pcall(_cacheSkinTarget, rg)
    for _, old in ipairs(lg:GetChildren()) do if old:IsA("SurfaceAppearance") then old:Destroy() end end
    for _, old in ipairs(rg:GetChildren()) do if old:IsA("SurfaceAppearance") then old:Destroy() end end

    for _, sa in ipairs(factoryNew:GetChildren()) do
        if sa:IsA("SurfaceAppearance") then
            local c1 = sa:Clone(); pcall(function() c1:SetAttribute("ECLIPSE_HUBSkinSurface", true) end); c1.Parent = lg
            local c2 = sa:Clone(); pcall(function() c2:SetAttribute("ECLIPSE_HUBSkinSurface", true) end); c2.Parent = rg
        end
    end
    lg:SetAttribute("ECLIPSE_HUBSkinSource", sourceKey); lg:SetAttribute("SkinApplied", gloveSkin)
    rg:SetAttribute("ECLIPSE_HUBSkinSource", sourceKey); rg:SetAttribute("SkinApplied", gloveSkin)
    return true
end

function _applySelectedGloveSkin()
    if EX_LIMITED then return end
    if not SkinsFolder or not Config.Skins.SkinChangerEnabled or not IsAlive() then return end
    local now = tick()
    if (now - (_TW_GloveLastApplyAt or 0)) < 0.30 then return end
    local activeType, activeSkin
    for gt in pairs(GLOVES) do
        local s = Config.Skins.SelectedSkins[gt]
        if s and s ~= "" and s ~= "Vanilla" and s ~= "Default" and s ~= "None" then
            activeType, activeSkin = gt, s; break
        end
    end
    if not activeSkin then
        _TW_GloveLastApplyAt = now
        pcall(_clearGloveSkinRuntime)
        _forEachCameraGlove(function(glove) _restoreGloveSurfaceOnly(glove) end)
        return
    end
    _TW_GloveLastApplyAt = now
    pcall(_applyGloveSkinCore, activeType, activeSkin)
end

function _applyWeaponSkinCore(model, skin)
    if not (model and model:IsA("Model") and SkinsFolder) then return end
    local own = model.Name
    local ewn = own
    local canApply = false
    if own == "CT Knife" or own == "T Knife" or own == "Knife" then
        ewn = Config.Skins.SelectedKnife or ewn
        canApply = Config.Skins.SkinChangerEnabled and true or false
    else
        canApply = Config.Skins.SkinChangerEnabled and true or false
    end
    if GLOVES[ewn] or not canApply then return end
    local sel = skin or Config.Skins.SelectedSkins[ewn]
    if not sel or sel == "Vanilla" or sel == "Default" or sel == "None" then return end
    if model:GetAttribute("ECLIPSE_HUBSkin") == sel then return end

    local wsf = SkinsFolder:FindFirstChild(ewn); if not wsf then return end
    local sf  = wsf:FindFirstChild(sel);         if not sf  then return end
    local cf  = sf:FindFirstChild("Camera");     if not cf  then return end
    local fn  = cf:FindFirstChild("Factory New")
             or cf:FindFirstChild("Minimal Wear")
             or cf:FindFirstChild("Field-Tested")
             or cf:FindFirstChild("Well-Worn")
             or cf:FindFirstChild("Battle-Scarred")
    if not fn then return end

    local appliedCount = 0
    for _, sa in ipairs(fn:GetChildren()) do
        if sa:IsA("SurfaceAppearance") then
            local pt = model:FindFirstChild(sa.Name, true)
            if pt and (pt:IsA("BasePart") or pt:IsA("MeshPart")) then
                appliedCount = appliedCount + 1
                pcall(_cacheSkinTarget, pt)
                for _, old in ipairs(pt:GetChildren()) do
                    if old:IsA("SurfaceAppearance") then old:Destroy() end
                end
                local c = sa:Clone()
                pcall(function() c:SetAttribute("ECLIPSE_HUBSkinSurface", true) end)
                c.Parent = pt
                if appliedCount % 8 == 0 then ECLIPSE_HUBYield() end
            end
        end
    end
    model:SetAttribute("SkinApplied", sel)
    model:SetAttribute("ECLIPSE_HUBSkin", sel)
end

function applyWeaponSkin(model, forcedSkin)
    if not SkinsFolder or not model or not Config.Skins.SkinChangerEnabled or not IsAlive() then return end
    pcall(_applySelectedGloveSkin)
    local skin = forcedSkin or Config.Skins.SelectedSkins[model.Name]; if not skin then return end
    pcall(_applyWeaponSkinCore, model, skin)
end

function ApplyWeaponSkinsFast(model, skinName)
    applyWeaponSkin(model, skinName)
end

_TW_ApplyDebounce = false
_TW_ApplyPending  = false
_TW_LastApplyAt = 0
_TW_MinApplyInterval = 0.15
_TW_GloveLastApplyAt = 0
function _TW_ApplyAllCameraSkins()
    if _TW_ApplyDebounce then
        _TW_ApplyPending = true
        return
    end
    local now = tick()
    if (now - (_TW_LastApplyAt or 0)) < (_TW_MinApplyInterval or 0.85) then
        if not _TW_ApplyPending then
            _TW_ApplyPending = true
            task.delay(_TW_MinApplyInterval or 0.85, function()
                if not scriptRunning then return end
                if _TW_ApplyPending then
                    _TW_ApplyPending = false
                    pcall(_TW_ApplyAllCameraSkins)
                end
            end)
        end
        return
    end
    _TW_LastApplyAt = now
    _TW_ApplyDebounce = true
    task.spawn(function()
        task.wait(0.2)
        pcall(function()
            if Config.Skins.SkinChangerEnabled and IsAlive() then
                pcall(_applySelectedGloveSkin)
                local cam = workspace.CurrentCamera
                if cam then
                    local processed = 0
                    for _, obj in ipairs(cam:GetChildren()) do
                        if obj:IsA("Model") then
                            processed = processed + 1
                            local nm = obj.Name
                            if nm == "CT Knife" or nm == "T Knife" or nm == "Knife" then

                                pcall(_applyWeaponSkinCore, obj, nil)
                            else
                                local sn = Config.Skins.SelectedSkins[nm]
                                if sn and sn ~= "" and sn ~= "Vanilla" and sn ~= "Default" and sn ~= "None" then
                                    pcall(applyWeaponSkin, obj, sn)
                                end
                            end
                            if processed % 3 == 0 then ECLIPSE_HUBYield() end
                        end
                    end
                end

                task.wait(0.15)
                pcall(_applySelectedGloveSkin)
            end
        end)
        _TW_ApplyDebounce = false
        if _TW_ApplyPending then
            _TW_ApplyPending = false
            task.delay(_TW_MinApplyInterval or 0.85, function()
                if scriptRunning then pcall(_TW_ApplyAllCameraSkins) end
            end)
        end
    end)
end

