            if c:IsA("TextLabel") then c:Destroy() end
        end
        local names = {}
        local attr = LP:GetAttribute("Spectators")
        if type(attr) == "string" and attr ~= "" then
            for name in string.gmatch(attr, "[^,;|]+") do
                local n = name:match("^%s*(.-)%s*$")
                if n and n ~= "" then table.insert(names, n) end
            end
        elseif type(attr) == "number" and attr > 0 then
            table.insert(names, tostring(attr) .. " watching")
