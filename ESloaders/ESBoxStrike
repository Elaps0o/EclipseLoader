;(function()

    local function _log(title, desc, time)
        if not Config.Logging.Enabled then return end
        pcall(function()
            Library:Notify({ Title = title, Description = desc, Time = time or 4 })
        end)
    end

    local function _logBoth(title, desc)
        if not Config.Logging.Enabled then return end
        _log(title, desc, 4)
    end

    table.insert(UnloadConnections, Players.PlayerAdded:Connect(function(p)
        _logBoth("Player Joined", p.Name.." entered the match.")
    end))
    table.insert(UnloadConnections, Players.PlayerRemoving:Connect(function(p)
        _logBoth("Player Left", p.Name.." left the match.")
    end))

    local function _watchPlayer(p)
        local function _hook(ch)
            local hum = ch:WaitForChild("Humanoid", 5)
            if not hum then return end
            connectSignal(hum.Died:Connect(function()
                if not scriptRunning then return end
                _logBoth("Player Eliminated", p.Name.." was eliminated.")
            end))
        end
        if p.Character then task.spawn(_hook, p.Character) end
        connectSignal(p.CharacterAdded:Connect(function(ch) if scriptRunning then _hook(ch) end end))
    end
    for _, p in ipairs(Players:GetPlayers()) do _watchPlayer(p) end
    table.insert(UnloadConnections, Players.PlayerAdded:Connect(_watchPlayer))

    task.spawn(function()
        local last
        while scriptRunning do
            local st
            pcall(function() st = workspace:GetAttribute("GameState") end)
            if st ~= last then
                last = st
                if st then
                    local title
                    local s = tostring(st):lower()
                    if s:find("wait") or s:find("intermission") then
                        title = nil
                    elseif s:find("start") or s:find("begin")        then title = "Round Started"
                    elseif s:find("end") or s:find("over")           then title = "Round Ended"
                    else   title = "Round State" end
                    if title then _logBoth(title, tostring(st)) end
                end
            end
            task.wait(0.5)
        end
    end)
end)()

